        # the exact case that matters most: scoring it as silence would turn
        # "it answered, just not how we expected" into "not supported".
        ProbeResult(_BIN_POLLS[3], "reply", {"note": "cross-framing"},
                   answered_in=UBX.name),
    ]
    _MIXED_REPORT = render_probe(Observation(9600), [(CASIC, _MIXED_SWEEP)],
                                 "/dev/null")
    check("every poll's label appears, and a reply's decoded fields render",
          lambda: all(p.label in _MIXED_REPORT for p in _BIN_POLLS[:4])
                  and "baudRate=9600" in _MIXED_REPORT)
    check("a NAK renders as unsupported, not folded into silence",
          lambda: "not supported on this chip" in _MIXED_REPORT)
    check("a silence line reports both its byte count and its frame tally",
          lambda: "137 bytes arrived" in _MIXED_REPORT
                  and "casic 06-00 x2" in _MIXED_REPORT)
    check("a reply answered outside the swept framing is annotated",
          lambda: "ANSWERED IN UBX FRAMING" in _MIXED_REPORT)
    # ...and the mirror image: a wall of refusals, which is what a u-blox
    # emulation layer produces and is exactly what must NOT read as success --
    # it is what makes cmd_probe try the next framing instead of stopping.
    check("an all-NAK sweep is not productive -- that is what triggers the fallback",
          lambda: not productive([ProbeResult(p, "nak") for p in _BIN_POLLS]))

    print("")
    print("show and monitor rendering:")
    _OBS = _observe(b"$GPGSV,1,1,07,02,49,123,43,0*5A\r\n"
                    b"$GNGGA,071556.000,3149.29103,N,11706.92916,E,1,21,0.7,"
                    b"75.7,M,-5.0,M,,*69\r\n"
                    b"$GNGSA,A,3,10,13,15,20,,,,,,,,,2.5,2.0,1.5,1*35\r\n")
    # The brief's own "3D" in text or "fix" in text is a near-tautology --
    # render_show prints the labels "fix interval" and "fix type"
    # unconditionally, so it would pass even with the whole GSA/GGA block
    # deleted. Replaced with the actual decoded, translated values: if any
    # of quality/fix-mode translation, DOP or satellite count broke, this
    # fails.
    check("show reports the translated fix mode, quality, DOP triple and "
          "satellite count decoded from GSA/GGA",
          lambda: (lambda text: "3 (3D)" in text
                   and "1 (GPS SPS mode, fix valid)" in text
                   and "2.5 / 2.0 / 1.5" in text
                   and "21" in text)(render_show(None, _OBS)))
    check("show reports satellites used and HDOP",
          lambda: "21" in render_show(None, _OBS) and "0.7" in render_show(None, _OBS))
    # Likewise "observed" in text alone is near-tautological -- the sentence
    # rates line always carries "[observed: ...]" regardless of whether GGA/
    # GSA ever parsed. Pinned against BOTH halves of the provenance split
    # together: the two Gets marked not-read-back (session=None) and the
    # inferred rates marked observed, with their actual values.
    check("without a session, the readbacks are marked not-read-back and "
          "the sentence rates are marked observed, together and concretely",
          lambda: (lambda text: "no CFG-PRT reply" in text
                   and "no CFG-RATE reply" in text
                   and "GGA@1, GSA@1, GSV@2" in text
                   and "[observed: tallied from the wire" in text)(
              render_show(None, _OBS)))
    # A field genuinely absent from the wire (not merely a documented "0")
    # must render as unknown, not as though some code -- least of all 0,
    # itself a real documented value -- were present.
    _OBS_NO_QUALITY = _observe(nmea_wrap(
        "GNGGA,071556.000,3149.29103,N,11706.92916,E,,21,0.7,75.7,M,-5.0,M,,"))
    check("a GGA quality field absent from the wire renders as unknown, "
          "not a fabricated code",
          lambda: any("quality" in l and "unknown" in l for l in
                     render_show(None, _OBS_NO_QUALITY).splitlines()))
    check("the sky table lists a satellite with its elevation and C/N0",
          lambda: all(t in render_sky(_OBS) for t in ("02", "49", "43")))
    check("an empty observation renders without raising",
          lambda: isinstance(render_show(None, Observation(9600)), str))

    # GGA_QUALITY and GSA_FIX_MODE pinned against the spec's own tables
    # (§2.2.2, §2.2.4) -- gaps (3/4/5/7+ for quality) are deliberate, not an
    # oversight, and this fails loudly if one is ever "helpfully" filled in
    # from generic NMEA-0183 knowledge the receiver's own spec does not claim.
    check("GGA_QUALITY and GSA_FIX_MODE match exactly the codes the spec "
          "documents, no more",
          lambda: GGA_QUALITY == {0: "fix not available or invalid",
                                  1: "GPS SPS mode, fix valid",
                                  2: "differential GPS/SBAS, fix valid",
                                  6: "estimated (dead reckoning) mode"}
                  and GSA_FIX_MODE == {1: "fix not available", 2: "2D", 3: "3D"})
    check("a documented code shows the raw number next to its text",
          lambda: _render_code(GGA_QUALITY, 2) == "2 (differential GPS/SBAS, "
                                                    "fix valid)")
    check("an undocumented code is marked undocumented, not silently mapped "
          "to something",
          lambda: _render_code(GGA_QUALITY, 5) == "5 (undocumented code)"
                  and _render_code(GSA_FIX_MODE, 9) == "9 (undocumented code)"
                  and _render_code(GGA_QUALITY, None) == "unknown")
    check("show renders the documented quality/fix-mode text next to the "
          "raw code",
          lambda: "1 (GPS SPS mode, fix valid)" in render_show(None, _OBS)
                  and "3 (3D)" in render_show(None, _OBS))

    check("render_sky renders without raising when nothing has been observed",
          lambda: isinstance(render_sky(Observation(9600)), str))
    # NmeaCollector.records keeps only the LAST parsed sentence per talker,
    # which for a multi-line GSV group (§2.2.3) is at most four satellites --
    # one line's worth. A real sky of more than four needs several lines, so
    # a sky table built from records["GSV"] directly would show at most four
    # satellites no matter how many are in view. obs.sky exists precisely to
    # not do that; this pins the accumulation across _EPOCH's three-line group.
    check("a satellite reported across multiple GSV lines is not lost to the "
          "last line's overwrite",
          lambda: set(_observe(_EPOCH).sky.get("GP", {})) == {"02", "05", "06"})

    # A group's own <SenNum> 1 line can go missing mid-session the same way
    # any other sentence can (NmeaCollector.feed's own try/except exists
    # because truncation is routine) -- and unlike session start-up, there
    # IS a previous, completed group sitting in `sky` here for a naive
    # implementation to merge onto. Group A completes normally; group B's
    # first line is simply never sent, only its second (and last).
    check("a group whose first line is missing does not merge its lone "
          "sentence onto the previous, now-stale group",
          lambda: set(_observe(
              nmea_wrap("GPGSV,1,1,04,02,49,123,43,0")     # group A, complete
              + nmea_wrap("GPGSV,2,2,08,06,10,050,20,0")   # group B, part 1 missing
          ).sky.get("GP", {})) == {"06"})

    _MIXED_SKY = _observe(
        nmea_wrap("GPGSV,1,1,08,10,49,123,43,02,30,050,22,0")
        + nmea_wrap("GNGSA,A,3,10,13,15,20,,,,,,,,,2.5,2.0,1.5,1"))
    check("the sky table's used column reflects GSA, not just whichever "
          "satellite GSV happens to list",
          lambda: (lambda lines:
                   any("GP" in l and "10" in l and "yes" in l for l in lines)
                   and any("GP" in l and "02" in l and "yes" not in l
                          for l in lines))(render_sky(_MIXED_SKY).splitlines()))

    # The session=None checks above cover the observed section; this covers
    # the other half -- that a session which CAN answer is labelled
    # "readback", distinctly from both "observed" and an unanswered Get.
    _PRT_REPLY = CASIC.encode(*CFG_PRT.key, CFG_PRT.build(
        portID=0, protoMask=0x33, mode=0x08C0, baudRate=115200))
    _SHOW_WITH_SESSION = render_show(
        Session(_FakePort(115200, _PRT_REPLY), allow_apply=False,
               timeout=_TEST_WINDOW), _OBS)
    check("with a session, a CFG-PRT readback, an unanswered CFG-RATE Get and "
          "the observed sentence rates each carry a distinct label",
          lambda: "readback: CFG-PRT" in _SHOW_WITH_SESSION
                  and "not read back" in _SHOW_WITH_SESSION
                  and "observed: tallied" in _SHOW_WITH_SESSION)

    check("a --sentences override parses NAME=RATE pairs via SetSentences' "
          "own validation",
          lambda: _parse_rate_overrides("GGA=1,GSV=0") == {"GGA": 1, "GSV": 0})
    check("a --sentences override rejects what SetSentences itself would reject",
          lambda: _raises(lambda: _parse_rate_overrides("GSV=11"), ValueError))

    check("show, monitor and bandwidth never call .apply(",
          lambda: not ({"cmd_show", "cmd_monitor", "cmd_bandwidth"}
                       & _uses_apply()))
    check("show, monitor and bandwidth build their Session read-only",
          lambda: all(calls and all(c.get("allow_apply", False) is False
                                    for c in calls)
                      for calls in (_session_calls(n) for n in
                                   ("cmd_show", "cmd_monitor", "cmd_bandwidth"))))
    check("bandwidth sends nothing -- no Get, current_hz, poll or apply "
          "reachable from its own body",
          lambda: not _reaches("cmd_bandwidth",
                               {"get", "current_hz", "poll", "apply"}))

    # _reaches/_session_calls above inspect cmd_monitor's OWN AST -- they
    # cannot see that render_show, a function cmd_monitor calls, used to
    # transmit on every redraw when handed a live session. Only actually
    # running the loop and inspecting what reached write() closes that gap.
    # Compared against a run with the same one-time readback but ZERO loop
    # iterations, rather than against a bare 0: the readback itself legitimately
    # writes twice (CFG-PRT, CFG-RATE Get) BEFORE the loop starts, and a check
    # for literally zero writes would fail on that correct behaviour, not on
    # the bug.
    def _monitor_writes(iterations):
        port = _QuietThenInterrupt(iterations)
        cmd_monitor(port, _Args(raw=False, interval=_TEST_WINDOW,
                                timeout=_TEST_WINDOW))
        return port.writes

    check("monitor's redraw loop sends nothing beyond its one-time "
          "CFG-PRT/CFG-RATE readback, however many redraws run",
          lambda: len(_monitor_writes(2)) == 2  # readback only, 0 redraws
                  and len(_monitor_writes(4)) == 2)  # readback + 2 redraws

    print("")
    if _FAILS:
        print("%d FAILED: %s" % (len(_FAILS), ", ".join(_FAILS)))
        return 1
    print("all checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(selftest() if "--selftest" in sys.argv[1:] else 0)
