class NmeaCollector:
    """Tallies and parses NMEA sentences seen on the wire."""

    def __init__(self, keep=40):
        self.buf = bytearray()
        self.counts = {}
        self.lines = []
        self.records = {}
        # Per-talker satellite table, accumulated across a GSV group's parts
        # rather than overwritten like `records` above -- see _absorb_sky.
        self.sky = {}
        # Per talker: has this talker's CURRENT group seen its own <SenNum>
        # 1 line yet? Tracked separately from `sky` itself so a group whose
        # first line was dropped can be told apart from one in progress --
        # see _absorb_sky.
        self._sky_started = {}
        self.bad_checksums = 0
        self.keep = keep

    def feed(self, data):
        self.buf.extend(data)
        while True:
            i = self.buf.find(b"\n")
            if i < 0:
                if len(self.buf) > 1024:
                    del self.buf[:-1024]
                return
            raw = bytes(self.buf[:i])
            del self.buf[:i + 1]
            # Resync to the last '$' rather than assuming the sentence starts at
            # the head of the buffer. Binary frames and NMEA share this wire and
            # binary payloads contain no newline, so whatever binary arrived
            # before a sentence is still sitting in front of it. rfind, not
            # find: a sentence carries one '$', but preceding binary may contain
            # 0x24 bytes.
            start = raw.rfind(b"$")
            if start < 0:
                continue
            text = raw[start:].decode("ascii", "replace").strip()
            body, ok = nmea_split(text)
            if body is None:
                continue
            if not ok:
                self.bad_checksums += 1
                continue
            tag = body.split(",")[0]
            self.counts[tag] = self.counts.get(tag, 0) + 1
            if len(self.lines) < self.keep:
                self.lines.append(text)
            name = tag[2:] if len(tag) == 5 and not tag.startswith("P") else tag
            sentence = STANDARD_SENTENCES.get(name)
            if sentence is not None:
                # Live serial data contains truncated sentences routinely --
                # a partial read, line noise, a receiver mid-reconfiguration --
                # and Sentence.parse() now raises on one rather than guessing
                # (see GSV's repeat-block check). One malformed sentence must
                # not abort the read loop, so this is load-bearing, not
                # defensive boilerplate.
                try:
                    rec = sentence.parse(body)
                except Exception:
                    pass
                else:
                    self.records.setdefault(name, {})[tag[:2]] = rec
                    self._absorb_sky(tag[:2], rec)

    def _absorb_sky(self, talker, rec):
        """Merge one sentence's per-satellite rows into the running sky table.

        Detected structurally -- a "sats" repeat block whose rows are
        per-satellite detail dicts -- rather than by matching the sentence's
        name: GSA also declares a "sats" repeat block (§2.2.4), but with a
        single field, so Sentence.parse's own repeat-block handling stores
        its rows as plain satellite IDs, not dicts. Only GSV's shape (four
        fields per row) qualifies.

        A GSV sky is reported across up to four sentences (<TotalNumSen>,
        §2.2.3), each carrying at most four satellites; `records` above keeps
        only the LAST one per talker, so reading it for a sky table would show
        at most four satellites no matter how many are actually in view. This
        accumulates across the group instead.

        Starts a fresh table on <SenNum> 1 -- the group's first line -- same
        as when a talker is seen for the very first time: the guarantee this
        exists for is "a table missing its first line comes up a satellite
        short, never two epochs mixed together", and that has to hold in the
        MIDDLE of a session too, not only at start-up. A truncated sentence is
        routine (NmeaCollector.feed's own try/except exists because of it), so
        a group's <SenNum> 1 line going missing mid-session is not a corner
        case: without _sky_started tracking this, the next line seen for that
        talker (<SenNum> 2 or 3) would merge onto whatever the PREVIOUS,
        now-stale, completed group left behind -- which is exactly the mixing
        the docstring used to claim could not happen. So a non-1 line arriving
        for a talker that has not seen its own group's <SenNum> 1 clears the
        stale table first, then contributes only its own rows: a satellite
        short (or, worst case, only what one line reports), never stale ones
        lingering indistinguishable from current ones.
        """
        sats = rec.get("sats")
        if not sats or not isinstance(sats[0], dict) or "satID" not in sats[0]:
            return
        sen_num = rec.get("senNum")
        if sen_num == 1 or not self._sky_started.get(talker):
            self.sky[talker] = {}
            self._sky_started[talker] = True
        bucket = self.sky.setdefault(talker, {})
        for row in sats:
            if row.get("satID"):
                bucket[row["satID"]] = row
        total = rec.get("totalNumSen")
        if sen_num is not None and total is not None and sen_num >= total:
            # Group complete (or this line claims to be the last one it will
            # see) -- ready for the next group to require its own <SenNum> 1
            # again, rather than silently accepting whatever arrives next as
            # a continuation of this one.
            self._sky_started[talker] = False

    def take_lines(self):
        out, self.lines = self.lines, []
        return out


class Observation:
    def __init__(self, baud):
        self.baud = baud
        self.sync_hits = {}
        self.valid_frames = {}
        self.frame_ids = {}
        self.nmea_counts = {}
        self.nmea_sample = []
        self.raw_bytes = 0
        self.raw_head = b""
        self._scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS}
        self._nmea = NmeaCollector()

    def absorb(self, data):
        self.raw_bytes += len(data)
        if len(self.raw_head) < 512:
            self.raw_head += data[:512 - len(self.raw_head)]
        self._nmea.feed(data)
        for sc in self._scanners.values():
            sc.feed(data)
        self.finish()
        return self

    def finish(self):
        for name, sc in self._scanners.items():
            self.sync_hits[name] = sc.sync_hits
            ids = self.frame_ids.setdefault(name, {})
            for fr in sc.take():
                self.valid_frames[name] = self.valid_frames.get(name, 0) + 1
                k = "%02x-%02x" % (fr.cls, fr.mid)
                ids[k] = ids.get(k, 0) + 1
        self.nmea_counts = dict(self._nmea.counts)
        self.nmea_sample = self._nmea.lines[:10]

    @property
    def recognised(self):
        return bool(self.nmea_counts) or any(self.valid_frames.values())

    @property
    def sats_in_view(self):
        """Satellites per GSV talker -- the 'sky now' input to the budget."""
        out = {}
        for talker, rec in (self._nmea.records.get("GSV") or {}).items():
            if rec.get("totalNumSat") is not None:
                out[talker] = rec["totalNumSat"]
        return out

    @property
    def constellations(self):
        seen = {"GP": "GPS", "GL": "GLO", "BD": "BDS"}
        return frozenset(seen[t] for t in self.sats_in_view if t in seen)

    def records(self, name):
        """Parsed sentences of `name`, keyed by talker.

        A general accessor for renderers that need more than sats_in_view/
        constellations above (which only ever look at GSV): render_show wants
        GGA and GSA too. Returns whatever NmeaCollector has kept -- the LAST
        parsed sentence per talker, which is exactly right for a one-line
        fix report like GGA/GSA and exactly wrong for GSV's multi-line
        groups, which is why GSV has its own accumulation (see `sky` below).
        """
        return self._nmea.records.get(name, {})

    @property
    def sky(self):
        """Per-talker satellite table, accumulated across a GSV group.

        Copied out rather than handed back live, so a caller mutating the
        result cannot corrupt NmeaCollector's own bookkeeping.
        """
        return {t: dict(sats) for t, sats in self._nmea.sky.items()}


def listen(port, seconds):
    """Read the device without transmitting anything."""
    obs = Observation(port.baud)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        data = port.read(min(0.5, max(0.05, deadline - time.monotonic())))
        if data:
            obs.absorb(data)
    return obs


def _parse_gpsd_defaults(text):
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("DEVICES="):
            continue
        val = line.split("=", 1)[1].strip().strip('"').strip("'").split()
        if val and val[0].startswith("/dev/"):
            return val[0]
    return None


def device_from_gpsd_defaults():
    try:
        with open(GPSD_DEFAULTS) as fh:
            return _parse_gpsd_defaults(fh.read())
    except OSError:
        return None


class Port:
    """Raw 8N1 access to the serial device at a chosen speed."""

    def __init__(self, path, baud):
        self.path = path
        self.baud = baud
        self.fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        try:
            self.saved = termios.tcgetattr(self.fd)
            self._configure(baud)
        except Exception:
            os.close(self.fd)
            raise

    def _configure(self, baud):
        speed = BAUD_CONST[baud]
        iflag, oflag, cflag, lflag, _, _, cc = termios.tcgetattr(self.fd)
        iflag &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK |
                   termios.ISTRIP | termios.INLCR | termios.IGNCR |
                   termios.ICRNL | termios.IXON)
        oflag &= ~termios.OPOST
        lflag &= ~(termios.ECHO | termios.ECHONL | termios.ICANON |
                   termios.ISIG | termios.IEXTEN)
        cflag &= ~(termios.CSIZE | termios.PARENB | termios.CSTOPB)
        cflag |= termios.CS8 | termios.CLOCAL | termios.CREAD
        cc = list(cc)
        cc[termios.VMIN] = 0
        cc[termios.VTIME] = 0
        termios.tcsetattr(self.fd, termios.TCSANOW,
                          [iflag, oflag, cflag, lflag, speed, speed, cc])
        termios.tcflush(self.fd, termios.TCIOFLUSH)

    def set_baud(self, baud):
        """Re-clock the port in place, so 'set baud' can confirm at the new speed."""
        self._configure(baud)
        self.baud = baud

    def flush_input(self):
        termios.tcflush(self.fd, termios.TCIFLUSH)

    def read(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return b""
        try:
            return os.read(self.fd, 4096)
        except OSError as e:
            if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                return b""
            raise

    def write(self, data):
        os.write(self.fd, data)
        termios.tcdrain(self.fd)

    def close(self):
        try:
            termios.tcsetattr(self.fd, termios.TCSANOW, self.saved)
        except Exception:
            pass
        os.close(self.fd)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False


def systemctl(*args):
    try:
        return subprocess.run(("systemctl",) + args,
                              capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        return None
    except subprocess.TimeoutExpired:
        return None


def unit_active(unit):
    r = systemctl("is-active", "--quiet", unit)
    return bool(r) and r.returncode == 0


class ServiceGuard:
    """Stops gpsd and restores whatever state it found.

    Restores the PRIOR state, not "running": if gpsd was already stopped, it
    stays stopped. Both gpsd.socket and gpsd.service are stopped: gpsd is
    socket-activated, and meshcored reconnects to it with backoff, so
    stopping the service alone gets it respawned mid-operation and it takes
    the port back.
    """

    UNITS = ("gpsd.socket", "gpsd.service")

    def __init__(self, enabled=True):
        self.enabled = enabled
        self.was_active = {}
        self._armed = False

    def __enter__(self):
        if not self.enabled:
            return self
        for unit in self.UNITS:
            self.was_active[unit] = unit_active(unit)
        stopping = [u for u in self.UNITS if self.was_active.get(u)]
        if stopping:
            print("Stopping %s." % ", ".join(stopping))
            print("The GNSS clock source drops until this finishes; chrony "
                  "falls back to the pool\nand takes a couple of minutes to "
                  "return to stratum 1 afterwards.\n")
            # Armed BEFORE the first stop, not after the settle sleep.
            # restore() returns early when not armed, so arming afterwards
            # leaves a window -- the whole second between "gpsd is now
            # stopped" and "we would put it back" -- in which a Ctrl-C exits
            # with gpsd down and the restore silently skipped. That is the
            # node's stratum-1 clock, and the banner printed just above
            # promises it comes back. Arming first can only cause a
            # redundant `systemctl start` on units that were already
            # running, which is a no-op.
            self._armed = True
            for unit in self.UNITS:
                if self.was_active.get(unit):
                    systemctl("stop", unit)
            time.sleep(1.0)
        else:
            self._armed = True
        return self

    def restore(self):
        if not self._armed:
            return
        self._armed = False
        started = []
        for unit in reversed(self.UNITS):
            if self.was_active.get(unit):
                systemctl("start", unit)
                started.append(unit)
        if started:
            print("\nRestarted %s." % ", ".join(started))

    def __exit__(self, *exc):
        self.restore()
        return False


def port_holder(path):
    """Who still has the device open, if anyone. Best effort."""
    try:
        r = subprocess.run(("fuser", path), capture_output=True, text=True,
                           timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    pids = r.stdout.split() + r.stderr.replace(path + ":", "").split()
    names = []
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/comm" % pid) as fh:
                names.append(fh.read().strip())
        except OSError:
            pass
    return names or None


# Pause between writes. driver_allystar.c:1800 warns that "some parts get
# cranky when they get too many configuration changes at once" and spaces its
# own polls four parse cycles apart. Rushing risks reading a chip that has
# fallen behind as "unsupported", which poisons every result at once.
PROBE_SPACING = 0.25
PROBE_TIMEOUT = 1.5

# How long apply() watches the wire before it decides whether a change fits.
# One second is not enough at 1 Hz to see a whole epoch of GSV.
OBSERVE_SECONDS = 1.5

# Bytes of each read window kept as evidence. Enough to show several frames and
# a few sentences without hauling the whole stream around.
RAW_WINDOW = 256


class Change:
    """One documented configuration change.

    Subclasses are the ONLY things Session.apply accepts. There is deliberately
    no way to express a frame outside this set -- that is what keeps "gnssctl
    probe cannot write" a structural fact rather than a promise.

    Validation lives in __init__ rather than in Sentence.build(): build() is a
    thin trusted internal API driven by the spec's field table, and this is the
    layer that accepts input from a person. If a range is not enforced here,
    nothing else stops a malformed command reaching the receiver.
    """

    needs_yes = False

    def describe(self):
        raise NotImplementedError

    def sentences(self):
        raise NotImplementedError

    def confirm(self, session):
        """(ok, detail) -- read the setting back and say whether it took.

        ok is None for "cannot tell from here", which is a third answer and not
        a failure: reporting an unreadable setting as applied would be a claim
        this tool cannot support.
        """
        return None, "no readback available"

    def projected(self, session, obs):
        """(rates, baud, hz, constellations) after this change, for the budget.

        None means this change cannot alter what the link has to carry, so
        there is nothing to weigh.
        """
        return None


class SetBaud(Change):
    def __init__(self, baud):
        if baud not in BAUD_CODE:
            raise ValueError("baud must be one of %s (§2.3.1)"
                             % ", ".join(str(b) for b in sorted(BAUD_CODE)))
        self.baud = baud

    def describe(self):
        return "port speed -> %d" % self.baud

    def sentences(self):
        return [nmea_wrap(PCAS01.build(cmd=BAUD_CODE[self.baud]))]

    def confirm(self, session):
        # Re-clock the port and read CFG-PRT *there*: "the receiver moved" and
        # "we followed it" are separate claims and both need establishing.
        session.port.set_baud(self.baud)
        got = session.get(CFG_PRT)
        if got is None:
            # Say what state this leaves behind. The port is now clocked at the
            # requested speed whether or not the receiver followed, and there is
            # no way to ask the receiver which speed it is on -- it returns to
            # 9600 on power loss, which is the only way back to a known state.
            return False, ("no CFG-PRT reply at %d; the port is clocked there "
                           "but the receiver's speed is now unknown -- it "
                           "returns to 9600 on power loss" % self.baud)
        return got["baudRate"] == self.baud, "CFG-PRT reads %d" % got["baudRate"]

    def projected(self, session, obs):
        # A speed change moves the denominator, not the load, and dropping to
        # 9600 with GSV at 5 Hz is exactly the way to make a node mute. The
        # budget is the only thing that catches that, so it runs here too --
        # at the NEW speed, against the traffic already on the wire.
        return (session.current_rates(obs), self.baud,
                session.current_hz(), session.current_constellations(obs))


# §2.3.2 and §3.2.2.4 Table 13. The only navigation intervals the spec lists.
NAV_INTERVALS = (200, 500, 1000)


class SetRate(Change):
    def __init__(self, interval_ms):
        if interval_ms not in NAV_INTERVALS:
            raise ValueError("interval must be %s ms (§2.3.2, §3.2.2.4 Table 13)"
                             % " or ".join(str(i) for i in NAV_INTERVALS))
        self.interval = interval_ms

    def describe(self):
        return "fix interval -> %d ms (%.3g Hz)" % (self.interval,
                                                    1000.0 / self.interval)

    def sentences(self):
        return [nmea_wrap(PCAS02.build(interval=self.interval))]

    def confirm(self, session):
        got = session.get(CFG_RATE)
        if got is None:
            return None, "CFG-RATE did not answer"
        return got["interval"] == self.interval, ("CFG-RATE reads %d ms"
                                                  % got["interval"])

    def projected(self, session, obs):
        return (session.current_rates(obs), session.port.baud,
                1000.0 / self.interval, session.current_constellations(obs))


# Which sentences $PCAS03 can address, read off the command's own field table
# (§2.3.3) rather than restated: the rate fields are exactly the ones built by
# OptInt, and a separately maintained list would drift into accepting a name
# build() then refuses. TXT is a standard sentence and is NOT one of them --
# the antenna status arrives as a $GPTXT (§2.2.7) but is configured under
# <nANT>, so a validator checking STANDARD_SENTENCES would accept "TXT" and
# fail two lines later.
PCAS03_FIELD = {f.name[1:]: f for f in PCAS03.parts
                if isinstance(f, F) and f.codec.name == "OptInt"}


class SetSentences(Change):
    def __init__(self, rates):
        for name, rate in rates.items():
            field = PCAS03_FIELD.get(name)
            if field is None:
                raise ValueError("$PCAS03 cannot address %s; it sets %s (§2.3.3)"
                                 % (name, ", ".join(sorted(PCAS03_FIELD))))
            # Bounds come from the field's own codec, so the range is stated
            # once, where the field is declared.
            lo, hi = field.codec.lo, field.codec.hi
            if not isinstance(rate, int) or not lo <= rate <= hi:
                raise ValueError("%s: rate must be %d-%d (§2.3.3)" % (name, lo, hi))
        self.rates = dict(rates)

    def describe(self):
        return "sentence rates -> " + ", ".join(
            "%s=%d" % kv for kv in sorted(self.rates.items()))

    def sentences(self):
        kw = {PCAS03_FIELD[k].name: v for k, v in self.rates.items()}
        return [nmea_wrap(PCAS03.build(**kw))]

    def projected(self, session, obs):
        rates = session.current_rates(obs)
        # Only what the width model can price enters the budget. ANT has no
        # sentence table of its own, so its cost is whatever $GPTXT already
        # costs and is counted there or not at all.
        rates.update({k: v for k, v in self.rates.items()
                      if k in STANDARD_SENTENCES})
        return (rates, session.port.baud, session.current_hz(),
                session.current_constellations(obs))


class SetConstellation(Change):
    def __init__(self, constellations):
        key = frozenset(constellations)
        if key not in CONSTELLATION_MODE:
            raise ValueError("no such combination (§2.3.4 lists seven; there is "
                             "no Galileo mode)")
        self.constellations = key

    def describe(self):
        return "constellations -> %s (QZSS always on)" % "+".join(
            sorted(self.constellations))

    def sentences(self):
        return [nmea_wrap(PCAS04.build(
            mode=CONSTELLATION_MODE[self.constellations]))]

    def projected(self, session, obs):
        return (session.current_rates(obs), session.port.baud,
                session.current_hz(), self.constellations)


class Restart(Change):
    def __init__(self, kind, bbr_mask=None):
        if kind not in RESTART_FLAG:
            raise ValueError("restart must be one of %s (§2.3.5)"
                             % ", ".join(sorted(RESTART_FLAG)))
        self.kind = kind
        # $PCAS10 carries no mask; CFG-RST's <navBbrMask> (§3.2.2.3 Table 12) is
        # where a partial clear would go, and this carries the caller's choice
        # for it.
        self.bbr_mask = bbr_mask
        # A cold start discards the almanac and costs minutes of reacquisition;
        # a factory reset additionally returns the constellation set to the
        # Appendix C default of GPS + BeiDou. Nothing in this repository
        # re-applies GLONASS, so that would silently drop a constellation.
        self.needs_yes = kind in ("cold", "factory")

    def describe(self):
        return "%s restart" % self.kind

    def sentences(self):
        return [nmea_wrap(PCAS10.build(flag=RESTART_FLAG[self.kind]))]


CHANGES = (SetBaud, SetRate, SetSentences, SetConstellation, Restart)


class Poll:
    __slots__ = ("label", "kind", "cls", "mid", "payload", "why")

    def __init__(self, label, kind, cls, mid, payload, why):
        self.label = label
        self.kind = kind
        self.cls = cls
        self.mid = mid
        self.payload = payload
        self.why = why


# The frozen poll table. An empty payload IS the Get convention (§3.1), and
# every binary entry here has one -- but the table is explicit rather than a
# length check, because the reverse rule would not be safe: the per-port CFG-PRT
# poll legitimately carries a one-byte port ID in gpsd's Allystar driver, so
# "empty means harmless" is not a property of the protocol.
POLLS = (
    Poll("CFG-PRT", "bin", 0x06, 0x00, b"", "port ID, framing and baud readback"),
    Poll("CFG-RATE", "bin", 0x06, 0x04, b"", "navigation interval"),
    Poll("CFG-MSG", "bin", 0x06, 0x01, b"", "message rates"),
    Poll("$PCAS06", "nmea", None, None, "PCAS06,0",
         "version, over the NMEA path that works"),
    Poll("MON-VER", "bin", 0x0A, 0x04, b"", "chip and firmware -- expect NAK"),
    Poll("CFG-NAVSAT", "bin", 0x06, 0x0C, b"", "constellation mask -- expect NAK"),
    Poll("CFG-PPS", "bin", 0x06, 0x07, b"", "pulse period and polarity"),
    Poll("CFG-SBAS", "bin", 0x06, 0x0E, b"", "SBAS PRNs -- expect NAK"),
)


class ProbeResult:
    def __init__(self, poll, outcome, detail=None, raw=None,
                 answered_in=None, window=b"", window_total=0, seen=None):
        self.poll = poll
        self.outcome = outcome        # ack | nak | reply | silence
        self.detail = detail
        self.raw = raw
        # Which framing the answer actually arrived in. Usually the one we
        # asked in; if it differs, that is a major finding, not a footnote.
        self.answered_in = answered_in
        # Bytes seen during the probe window. Without this a "silence" verdict
        # is unfalsifiable: on a wire that is never quiet, "no matching frame"
        # and "nothing arrived" are completely different claims and only one
        # of them supports concluding the message is unsupported.
        self.window = window
        self.window_total = window_total
        # Tally of EVERY frame the scanners decoded in this window, across all
        # framings, matching or not. The raw window is capped at RAW_WINDOW
        # bytes and so is only a sample; this covers the whole window. It is
        # what makes "no answer" checkable -- specifically, whether any ACK or
        # NAK appeared at all, rather than only one naming the polled message.
        self.seen = seen or {}


class Verdict:
    def __init__(self, status, detail, budget=None):
        self.status = status          # ok | nak | unconfirmed | refused
        self.detail = detail
        self.budget = budget

    def __str__(self):
        return "%-12s %s" % (self.status.upper(), self.detail)


class Session:
    """The only transmit paths in this file.

    poll(n) indexes a frozen table. apply(change) takes an instance of a closed
    set of Change classes. There is no method that accepts a class, id and
    payload from a caller -- get() takes a declared Message and sends the empty
    payload that §3.1 defines as a query, so even the read path has nothing for
    a caller to fill in. That is what makes `probe` read-only by construction
    rather than by convention, and why --selftest can assert it.
    """

    def __init__(self, port, allow_apply=False, timeout=PROBE_TIMEOUT,
                 observe=OBSERVE_SECONDS):
        self.port = port
        self.allow_apply = allow_apply
        # How long to sit on the wire, per read window and per pre-flight
        # observation. Parameters rather than module lookups so --selftest can
        # shrink its own windows against a fake port without touching the real
        # defaults. PROBE_SPACING is deliberately NOT one of these: the pause
        # between writes is what keeps a receiver that gets cranky under rapid
        # reconfiguration from being misread as broken.
        self.timeout = timeout
        self.observe_seconds = observe
        self.framing = CASIC
        # Scan for EVERY framing, not just the one being asked in. A chip with
        # one command parser and one output formatter may well answer a foreign
        # request in its own dialect, and a single-framing scanner would score
        # that as silence -- turning "it answered, just not how we expected"
        # into "it does not support this", which is the opposite conclusion.
        self.scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS}
        self.nmea = NmeaCollector()
        self._window = b""
        self._window_total = 0

    # -- reads ------------------------------------------------------------
    def observe(self, seconds):
        """Watch the wire without transmitting."""
        return listen(self.port, seconds)

    def get(self, message):
        """Send an empty-payload Get and return the parsed reply, or None."""
        frame = self._exchange(message)
        if frame is None:
            return None
        try:
            return message.parse(frame.payload)
        except ValueError:
            # Message.parse refuses a short payload rather than guessing at the
            # missing fields; a reply we cannot read is not a reading.
            return None

    def current_rates(self, obs):
        """Sentence rates inferred from what is actually arriving.

        Labelled "observed" wherever it is printed: CFG-MSG's Get returns one
        message's rate, not the whole set, so the full picture can only come
        from counting the wire. Reporting an inference as a readback is the
        same trap the README records about measuring gpsd's synthesized NMEA.

        Accurate to +-1 epoch: the observation window is wall clock, not a
        whole number of fixes, so at 1 Hz a 1.5 s window catches one epoch or
        two depending on where it lands. Rates are ratios, so a partial epoch
        mostly cancels, but a sentence at rate 2 can read as 1 or 3.
        """
        # Accumulate per sentence NAME across talkers. $GPGSV, $BDGSV and
        # $GLGSV are all GSV, and assigning rather than adding would keep only
        # whichever talker happened to be counted last.
        counts = {}
        for tag, count in obs.nmea_counts.items():
            name = tag[2:] if len(tag) == 5 and not tag.startswith("P") else tag
            if name in STANDARD_SENTENCES and count:
                counts[name] = counts.get(name, 0) + count

        # A raw count is sentences, not fixes: GSV repeats once per four
        # satellites per talker and GSA once per constellation. Dividing by the
        # multiplicity each sentence declares is what turns one into the other.
        # Skipping it inflates the epoch estimate by GSV's multiplicity, and
        # every once-per-fix sentence then infers "every Nth fix" instead of
        # every fix -- an under-count in the guard's input, which is the
        # direction current_hz's docstring explains cannot be recovered from.
        #
        # Normalised against the sky that was OBSERVED, not the projected one:
        # these counts were produced by the sky that was actually there, and
        # pricing them against a substituted ceiling would divide real
        # sentences by an imaginary multiplicity.
        talkers = talkers_for(obs.constellations)
        per_epoch = {}
        unknown = []
        for name, count in counts.items():
            times = STANDARD_SENTENCES[name].repeat(obs.sats_in_view, talkers)
            if times:
                per_epoch[name] = float(count) / times
            else:
                # Arriving, but the model cannot say how many per fix -- GSA
                # with GSV switched off leaves no talker list to count. Left
                # out of the epoch estimate rather than counted as one per fix:
                # too small a multiplicity here inflates epochs and thins out
                # every other sentence's inferred rate.
                unknown.append(name)

        epochs = max(per_epoch.values()) if per_epoch else 1.0
        rates = {name: max(1, int(round(epochs / n)))
                 for name, n in per_epoch.items()}
        # An unknown multiplicity is priced at the most demanding rate there
        # is, for the same asymmetry as current_hz.
        rates.update(dict.fromkeys(unknown, 1))
        return rates

    def current_constellations(self, obs):
        """Which constellations are enabled, inferred from the talkers seen.

        Only GSV reveals this, so with GSV switched off there is nothing to
        count -- and the honest answer is then "unknown", which is NOT the same
        as "none" even though frozenset() prices them identically. Unknown
        falls back to every constellation §2.3.4 offers, for the same asymmetry
        as current_hz: `set sentences GSV=1` is precisely the command run to
        turn GSV on, and pricing it against a sky only GSV can show prices the
        sentence being enabled at zero bytes and waves it through on the way to
        muting the node.
        """
        return obs.constellations or ALL_CONSTELLATIONS

    def current_hz(self):
        """Fix rate, read back from CFG-RATE.

        When the readback fails this assumes the FASTEST documented rate rather
        than the 1 Hz factory default. The number feeds the bandwidth guard, and
        the two ways of being wrong are not symmetric: over-stating the rate
        costs a refusal the operator can override with --force, while
        under-stating it waves through exactly the change the guard exists to
        catch. A node already running at 5 Hz is the normal case here.
        """
        got = self.get(CFG_RATE)
        if got and got.get("interval"):
            return 1000.0 / got["interval"]
        return 1000.0 / min(NAV_INTERVALS)

    def poll(self, n):
        """Send POLLS[n]. Takes an index, never a message."""
        p = POLLS[n]
        if p.kind == "nmea":
            # Drain first rather than slicing from a mark: NmeaCollector caps
            # how many lines it retains, and by this point earlier polls' read
            # windows have already filled it. Slicing would silently see
            # nothing.
            self.port.flush_input()
            self.nmea.take_lines()
            self.port.write(nmea_wrap(p.payload))
            self._read_window(self.timeout)
            # A reply is any sentence that is not routine positioning data --
            # and routine positioning data is exactly what $PCAS03 meters, so
            # the set comes from that command's field table rather than from a
            # hand-kept list. STANDARD_SENTENCES would be the wrong set: it
            # contains TXT, and $GPTXT is precisely what $PCAS06 answers with.
            new = [ln for ln in self.nmea.take_lines()
                   if ln[3:6] not in PCAS03_FIELD]
            if new:
                return ProbeResult(p, "reply", {"sentences": new[:4]},
                                   answered_in="nmea", window=self._window,
                                   window_total=self._window_total)
            return ProbeResult(p, "silence", window=self._window,
                               window_total=self._window_total)
        return self._probe_binary(p)

    # -- writes -----------------------------------------------------------
    def apply(self, change, force=False, yes=False):
        if not self.allow_apply:
            raise PermissionError(
                "this session is read-only; apply() is not available")
        if not isinstance(change, Change):
            raise TypeError("apply() takes a Change, not %r" % (change,))
        if change.needs_yes and not yes:
            return Verdict("refused", "%s needs --yes" % change.describe())

        # The budget needs to know what the sky looks like right now, so this
        # reads before it writes -- and refuses before it writes, because a
        # guard that runs after the write is not a guard. A change that cannot
        # alter what the link carries returns no projection and skips it.
        #
        # projected() may itself poll (current_hz reads CFG-RATE back), so a Get
        # can reach the receiver before the refusal. A Get is not a change:
        # what the guard stands in front of is change.sentences(), and none of
        # those is written until the budget has passed or been overridden.
        bud = None
        obs = self.observe(self.observe_seconds)
        projection = change.projected(self, obs)
        if projection is not None:
            rates, baud, hz, constellations = projection
            bud = budget(rates, baud, hz, obs.sats_in_view, constellations)
            if not bud.ok and not force:
                # Say which number this is refusing on. With GSV off the sky
                # cannot be counted and is priced at the Table 16 ceiling, which
                # is the safe direction but is an assumption -- and refusing an
                # operator on an assumption without saying so is how "re-enable
                # GSV at 9600", the documented reason this tooling exists, turns
                # into an unexplained wall.
                why = ""
                if not bud.measured:
                    why = (" The sky was assumed, not measured (%s): GSV is off, "
                           "so there is nothing to count. If you know the sky is "
                           "sparse, --force." % "+".join(sorted(bud.assumed)))
                return Verdict(
                    "refused",
                    "%s: %.0f%% of the link (%s) -- the stream would never "
                    "drain. Cut the load or raise the speed first, or --force.%s"
                    % (change.describe(), bud.now_pct, bud.sky_note, why),
                    bud)

        for sentence in change.sentences():
            self.port.write(sentence)
            time.sleep(PROBE_SPACING)

        try:
            ok, detail = change.confirm(self)
        except Exception as exc:
            # The change is already on the wire. A readback that fails must not
            # take that fact with it: SetBaud.confirm re-clocks the port, and a
            # tcsetattr failure there would otherwise propagate out of apply()
            # and leave the caller believing nothing was written. Broad on
            # purpose -- what must survive is the record of the write, whatever
            # went wrong after it.
            return Verdict("unconfirmed",
                           "%s; written, but the readback failed: %s: %s"
                           % (change.describe(), type(exc).__name__, exc), bud)

        # A passing budget can still have no headroom. The operator never sees
        # the Budget object, and a warning that is not said out loud is not a
        # warning -- this is the case where enabling a constellation fits the
        # sky now and cannot fit a full one.
        note = ""
        if bud is not None and bud.warn:
            note = " -- no headroom if the sky fills (%.0f%% at the ceiling)" % (
                bud.ceiling_pct,)
        text = "%s; %s%s" % (change.describe(), detail, note)
        if ok is None:
            return Verdict("unconfirmed", text, bud)
        return Verdict("ok" if ok else "nak", text, bud)

    # -- wire -------------------------------------------------------------
    def _read_window(self, timeout):
        """Read until `timeout`, returning every frame decoded in that window.

        Also records the window's bytes and their count, so a "silence" result
        carries its own evidence. Reads in short slices so the timeout is
        honoured reasonably tightly rather than to the nearest whole read.
        """
        end = time.monotonic() + timeout
        seen = []
        raw = bytearray()
        total = 0
        while True:
            left = end - time.monotonic()
            if left <= 0:
                break
            data = self.port.read(min(0.2, max(0.02, left)))
            if not data:
                continue
            total += len(data)
            if len(raw) < RAW_WINDOW:
                raw.extend(data[:RAW_WINDOW - len(raw)])
            self.nmea.feed(data)
            for sc in self.scanners.values():
                sc.feed(data)
                seen.extend(sc.take())
        self._window = bytes(raw)
        self._window_total = total
        return seen

    def _exchange(self, message):
        """Write one empty-payload Get and return the first matching frame.

        Takes a declared Message rather than a class, id and payload: the empty
        payload is the whole of the Get convention (§3.1), so there is nothing
        for a caller to supply -- and therefore no way through here to put bytes
        of their choosing on the wire.

        Returns the message asked for, in the framing it was asked in, or None.
        The scanners watch every framing because *detecting* an answer is the
        question `probe` exists to settle -- but decoding one is a different
        act. A u-blox CFG-PRT puts baudRate at a different offset from a CASIC
        one, so reading a foreign-framed reply with this framing's layout turns
        "it answered in another dialect" into a confident wrong number, and this
        is the path feeding current_hz (a guard input) and SetBaud.confirm (a
        truth claim). poll() reports the foreign answer as the finding it is;
        a readback has to decline it.
        """
        self.port.flush_input()
        for sc in self.scanners.values():
            sc.take()
        self.port.write(self.framing.encode(message.cls, message.mid, b""))
        for frame in self._read_window(self.timeout):
            if frame.framing != self.framing.name:
                continue
            if frame.key == message.key:
                return frame
            if (frame.key == ACK_NACK.key
                    and frame.payload[:2] == bytes(message.key)):
                return None
        return None

    def _probe_binary(self, p):
        self.port.flush_input()
        for sc in self.scanners.values():
            sc.take()

        def classify(fr):
            if fr.key == (p.cls, p.mid):
                return "reply"
            if (fr.key in (ACK_ACK.key, ACK_NACK.key) and len(fr.payload) >= 2
                    and (fr.payload[0], fr.payload[1]) == (p.cls, p.mid)):
                return "ack" if fr.key == ACK_ACK.key else "nak"
            return None

        self.port.write(self.framing.encode(p.cls, p.mid, p.payload))
        frames = self._read_window(self.timeout)

        tally = {}
        for fr in frames:
            k = "%s %02x-%02x" % (fr.framing, fr.cls, fr.mid)
            tally[k] = tally.get(k, 0) + 1

        for fr in frames:
            kind = classify(fr)
            if kind is None:
                continue
            return ProbeResult(p, kind,
                               self._decode(fr) if kind == "reply" else None,
                               fr.payload, answered_in=fr.framing,
                               window=self._window,
                               window_total=self._window_total, seen=tally)
        return ProbeResult(p, "silence", window=self._window,
                           window_total=self._window_total, seen=tally)

    @staticmethod
    def _decode(frame):
        """Field detail for a reply, when its message is declared.

        Looked up in the message table rather than dispatched on the poll's
        label, so a poll for a message this file does not describe reports the
        raw payload instead of nothing at all.
        """
        message = CASIC_MESSAGES.get(frame.key)
        if message is None:
            return None
        try:
            return message.describe(frame.payload)
        except ValueError:
            # Short payload: parse refuses rather than guessing, and an
            # undecodable reply is still a reply worth reporting as one.
            return None


# --------------------------------------------------------------------------
# init -- the boot-path setup that runs before gpsd opens the port
#
# Replaces gnss-set-baud, a shell script that did the same job at boot; it was
# removed from this repo in the same change that repointed gpsd's
# ExecStartPre at this file, so it no longer exists to read -- what it did is
# summarised below instead. Runs from gpsd's ExecStartPre, on every gpsd
# start, on a node whose GNSS receiver is its stratum-1 clock source. Three
# consequences:
#
#   * cmd_init must always return 0. A mis-tuned receiver is recoverable; a
#     node with no gpsd at all loses its clock. A failure here has to
#     surface as gpsd's own "no data received" -- diagnosable -- and never
#     as a failed ExecStartPre, which stops gpsd outright.
#   * It must be bounded: a hang in ExecStartPre blocks gpsd indefinitely.
#     _init_sequence checks its deadline before every step and gives up
#     cleanly rather than running one out.
#   * It must leave the port at 115200 -- the speed gpsd is about to open it
#     at -- so that if anything above went wrong the symptom is a clean "no
#     data" rather than a speed mismatch that looks like dead hardware.
#
# gnss-set-baud sent $PCAS01,5 at both 9600 and 115200 (the speed is
# volatile -- it returns to 9600 on power loss but survives a gpsd restart --
# and there is no way to ask which one the receiver is on) and then sent
# $PCAS02,200 unconditionally. That was safe only because $PCAS02,200 is
# unparseable noise at 9600; the script's own comments say so. That is a
# property of one sentence, not of the approach. _init_sequence instead
# reads CFG-PRT back at 115200 and sends the fix rate only once that
# readback confirms it, so the guard holds for any rate.
#
# _init_sequence writes directly (port.write(), not Session.apply()) -- see
# the comment at the _write_sites check for why that is a deliberate sixth
# entry in the read-only-guarantee's set, not a workaround.
# --------------------------------------------------------------------------

INIT_BAUD = 115200
INIT_INTERVAL_MS = 200
INIT_CANDIDATES = (9600, INIT_BAUD)
# Narrower than PROBE_TIMEOUT (1.5 s): PROBE_TIMEOUT is sized for probe's
# exploratory sweep of a receiver that might not answer at all. This window
# opens only after the receiver has already been told to move to 115200, on
# a local, no-propagation-delay UART -- a reply that is coming is coming
# fast.
INIT_CONFIRM_TIMEOUT = 0.2


def _init_sequence(port, deadline):
    """Send the speed at both candidate rates, prove it, then send the rate.

    A blind, fire-and-forget send at two candidate speeds, followed by one
    deliberate readback -- a primitive, not a transaction. It writes
    directly (port.write(nmea_wrap(...))) rather than through Session.apply(),
    by deliberate human ruling: apply() is built for the opposite shape --
    a guarded, confirmed, budget-checked change against a receiver whose
    current state can be observed -- and at boot none of that holds. The
    receiver's speed is unknown (that is the whole reason for trying two
    candidates) and its sentence mix is unobservable (nothing has been read
    yet), so apply()'s bandwidth guard can only substitute the Appendix C
    factory-default ceiling. Measured, that evaluated 99.2% of capacity
    against an assumed sky -- 0.8% of margin from silently declining to
    raise the rate, with no diagnosable symptom if any width estimate ever
    grew. The CFG-PRT readback below already establishes the one condition
    that makes 5 Hz safe (the port really is at 115200), so it already does
    the guard's job for this case. Routing through apply() also cost four
    extra frames on the wire -- a CFG-RATE probe and a CFG-PRT confirm on
    every apply(SetBaud(...)) call, whether a reply was reachable yet or
    not -- against a script this replaces that sent 3 and read nothing.

    Order is load-bearing, same as gnss-set-baud before it: both candidate
    sends happen unconditionally, then the fix rate is sent only once the
    CFG-PRT readback confirms 115200.

    Every exit path -- an expired deadline (whether already past at entry
    or reached partway through the candidate loop), an exception from
    write()/set_baud(), or reaching the end normally -- leaves the port
    clocked at 115200 (the `finally` below). gpsd is about to open this
    port at that speed; leaving it anywhere else turns a diagnosable "no
    data received" into a speed mismatch that looks like dead hardware --
    exactly the failure this function exists to prevent, so it cannot be
    contingent on which exit was taken.

    gnss-set-baud paused a full second between the 9600 and 115200
    attempts; this sends both back-to-back. That is a deliberate trade
    against the hard deadline this function has to honour, not an
    oversight, and it is unconfirmed against real hardware: the
    vendor-driver warning PROBE_SPACING's own comment cites is about rapid
    *binary polling*, a different case, and nothing here has evidence this
    part minds two NMEA sends with no gap -- but nobody has measured it on
    the actual receiver either. Do not read the absence of a sleep as
    settled; it is untested, not disproven.
    """
    speed = nmea_wrap(PCAS01.build(cmd=BAUD_CODE[INIT_BAUD]))
    try:
        for candidate in INIT_CANDIDATES:
            if time.monotonic() > deadline:
                return
            port.set_baud(candidate)
            port.write(speed)

        if time.monotonic() > deadline:
            return
        port.set_baud(INIT_BAUD)
        # The one read in this sequence. It goes through Session.get --
        # unlike the sends above, a read is exactly what Session is for, and
        # _exchange is already one of the permitted write sites (the
        # empty-payload Get it sends is not a caller-chosen frame; see
        # Session's own docstring).
        readback = Session(port, allow_apply=False,
                           timeout=min(INIT_CONFIRM_TIMEOUT,
                                      max(0.0, deadline - time.monotonic())))
        got = readback.get(CFG_PRT)
        if got is None or got.get("baudRate") != INIT_BAUD:
            # Unproven -- say nothing more than that. The `finally` below
            # leaves the port at 115200 regardless of whether the receiver
            # followed, so the failure surfaces as gpsd's own "no data
            # received" rather than a speed mismatch that looks like dead
            # hardware (see the section banner). Sending the fix rate here
            # would be presenting an assumption as a measurement.
            return

        if time.monotonic() > deadline:
            return
        port.write(nmea_wrap(PCAS02.build(interval=INIT_INTERVAL_MS)))
    finally:
        # Every exit lands here -- deadline expiry inside the loop (which,
        # without this, would leave the port at whichever candidate baud the
        # loop last set, or never touched at all), an exception from
        # write()/set_baud(), or the normal returns above. set_baud is a
        # local termios call, not a wire operation, so this cannot hang and
        # cannot itself blow the deadline.
        port.set_baud(INIT_BAUD)


def cmd_init(args, port_factory=Port):
    """Boot-path entry point for `gnssctl init DEVICE`. Always returns 0 --
    see the section banner for why a failure here must never stop gpsd
    starting.

    Runs from gpsd's ExecStartPre. Not finding the device is not an error
    either: a node with no GNSS HAT still starts gpsd for other devices.

    Catches BaseException, not Exception -- the one place in this file
    where that is the requirement, not a bug (everywhere else, swallowing
    BaseException would hide a real interrupt). Exception does not catch
    KeyboardInterrupt or SystemExit; they are BaseException's other
    children, not Exception's. A non-zero exit here stops ExecStartPre,
    which stops gpsd from starting at all -- and a node with no gpsd loses
    its clock outright, which is worse than whatever interrupted this run.
    A mis-tuned receiver is recoverable; a missing one is not.

    SIGTERM -- what systemd sends when ExecStartPre exceeds
    TimeoutStartSec -- has no Python-level default that raises anything
    (unlike SIGINT, which the interpreter already turns into
    KeyboardInterrupt on its own), so nothing would reach the except clause
    below without a handler; one is installed for the scope of this call,
    converting SIGTERM into the same KeyboardInterrupt SIGINT already
    produces, so both funnel through the one except below instead of
    needing two. Restored in a finally so a SIGTERM arriving after this
    function returns is not still routed through a handler with nothing
    left to protect.

    port_factory defaults to the real Port; --selftest injects a fake one
    to prove an interrupt mid-_init_sequence still returns 0 and still
    leaves the port at INIT_BAUD, without touching hardware.
    """
    if not os.path.exists(args.device):
        return 0
    deadline = time.monotonic() + args.timeout

    def _on_term(signum, frame):
        raise KeyboardInterrupt

    previous_term = signal.signal(signal.SIGTERM, _on_term)
    try:
        with port_factory(args.device, 9600) as port:
            _init_sequence(port, deadline)
    except BaseException as exc:
        print("gnssctl init: %s" % exc, file=sys.stderr)
    finally:
        signal.signal(signal.SIGTERM, previous_term)
    return 0


# --------------------------------------------------------------------------
# probe -- the read-only diagnostic
#
# Carried over from gnss-probe (which this file replaces). The finding that
# justifies its existence: what this receiver EMITS and what it ACCEPTS are
# different protocols. It emits u-blox b5 62 and ignores Allystar f1 d9
# entirely, but answers CASIC ba ce -- which it never emits on its own. A
# sweep that only tries the framing seen passively on the wire finds nothing
# but refusals; this is why Session scans every framing on every poll (see
# Session's own docstring) and why cmd_probe tries CASIC unconditionally
# rather than only the framing phase 1 happened to observe.
# --------------------------------------------------------------------------

def sweep(session, framing):
    """Poll every entry in POLLS in one framing.

    Drives Session.poll -- the frozen table, the only transmit path a probe is
    allowed -- rather than any lower-level send. Paced by PROBE_SPACING for the
    same reason apply() is: driver_allystar.c warns that some parts get cranky
    under rapid reconfiguration, and reading a chip that has fallen behind as
    "unsupported" would poison every remaining result in the sweep.
    """
    session.framing = framing
    results = []
    for i in range(len(POLLS)):
        results.append(session.poll(i))
        time.sleep(PROBE_SPACING)
    return results


def productive(results):
    """Did this framing actually yield data, as opposed to refusals?

    A sweep where every binary poll NAKs is a working conversation in which the
    chip declined every question -- which is exactly what a u-blox emulation
    layer does. It means "ask somewhere else", not "this is the answer", so it
    is the trigger for trying the next framing rather than a result to stop on.
    """
    return any(r.outcome in ("reply", "ack")
               for r in results if r.poll.kind == "bin")


# CASIC first, always. This receiver EMITS u-blox b5 62 and ignores Allystar
# f1 d9 entirely, but the protocol it ANSWERS is CASIC ba ce, which it never
# emits. Sweeping only the framing seen on the wire finds nothing but
# refusals -- that finding is why this tool exists, and the order below is
# the whole of its expression in code. A module-level constant rather than a
# local in cmd_probe so --selftest can pin it: this is pure, has no I/O
# dependency, and a future accidental reordering (or an ALL_FRAMINGS that no
# longer starts with CASIC) would otherwise pass the whole suite unnoticed.
PROBE_ORDER = (CASIC,) + tuple(f for f in ALL_FRAMINGS if f is not CASIC)


def hexdump(data, limit=64):
    if not data:
        return ""
    body = " ".join("%02x" % b for b in data[:limit])
    return body + (" ..." if len(data) > limit else "")


OUTCOME_LABEL = {
    "reply": "REPLY",
    "ack": "ACK",
    "nak": "NAK",
    "silence": "silent",
}


def render_probe(obs, sweeps, device):
    out = []
    w = out.append
    w("=" * 72)
    w("gnssctl probe: %s" % device)
    w("=" * 72)
    w("")
    w("PHASE 1 -- what is on the wire (nothing sent)")
    w("  port speed        %d baud" % obs.baud)
    w("  bytes read        %d" % obs.raw_bytes)
    w("")
    w("  binary framing:")
    for f in ALL_FRAMINGS:
        w("    %-9s sync %s  hits %-5d valid frames %-5d" % (
            f.name,
            " ".join("%02x" % b for b in f.sync),
            obs.sync_hits.get(f.name, 0),
            obs.valid_frames.get(f.name, 0)))
        ids = obs.frame_ids.get(f.name) or {}
        if ids:
            top = sorted(ids.items(), key=lambda kv: -kv[1])[:8]
            w("              messages: " +
              ", ".join("%s x%d" % (k, v) for k, v in top))
    w("")
    if obs.nmea_counts:
        w("  NMEA sentences emitted by the RECEIVER (not via gpsd):")
        for tag, n in sorted(obs.nmea_counts.items(), key=lambda kv: -kv[1]):
            w("    %-8s x%d" % (tag, n))
    else:
        w("  NMEA sentences: none seen")
    w("")

    if not sweeps:
        w("PHASE 2 -- skipped: no transmittable framing answered a version poll")
        w("")
        w("  Raw capture head:")
        w("    " + hexdump(obs.raw_head, 96))
    for framing, results in sweeps:
        w("PHASE 2 -- capability sweep in %s framing (%s)" % (
            framing.name, " ".join("%02x" % b for b in framing.sync)))
        if not productive(results):
            w("  Every binary poll was refused. The chip is talking, but it "
              "declines every")
            w("  question in this protocol -- which is what a u-blox emulation "
              "layer does.")
        w("")
        w("  %-12s %-8s %s" % ("POLL", "RESULT", "DETAIL"))
        w("  " + "-" * 68)
        for r in results:
            if r.outcome == "reply" and r.detail:
                parts = ["%s=%s" % (k, v) for k, v in r.detail.items()]
            elif r.outcome == "reply":
                parts = ["payload " + hexdump(r.raw, 24)]
            elif r.outcome == "nak":
                parts = ["not supported on this chip"]
            elif r.outcome == "ack":
                parts = ["supported, returned no data"]
            else:
                # Say what "silence" is actually made of. A busy wire with no
                # matching frame is a different claim from a dead wire, and
                # only the ProbeResult's own window/seen tally can tell them
                # apart -- see ProbeResult's docstring for why both are kept.
                other = ", ".join("%s x%d" % (k, v)
                                  for k, v in sorted(r.seen.items(),
                                                     key=lambda kv: -kv[1])[:5])
                parts = ["no matching frame; %d bytes arrived" % r.window_total,
                         "frames seen: %s" % (other or "NONE in any framing")]
            if r.answered_in and r.answered_in not in (framing.name, "nmea"):
                parts.insert(0, "ANSWERED IN %s FRAMING" % r.answered_in.upper())
            # Wrap rather than truncate. A cut-off line once hid galileo_e1 in
            # gnss-probe -- the single field this whole tool exists to read.
            lines = []
            cur = ""
            for part in parts:
                if cur and len(cur) + len(part) + 2 > 48:
                    lines.append(cur)
                    cur = part
                else:
                    cur = (cur + ", " + part) if cur else part
            if cur:
                lines.append(cur)
            w("  %-12s %-8s %s" % (r.poll.label,
                                   OUTCOME_LABEL[r.outcome], lines[0]))
            for extra in lines[1:]:
                w("  %-12s %-8s %s" % ("", "", extra))
            if r.outcome == "reply" and r.raw:
                w("  %-12s %-8s hex: %s" % ("", "", hexdump(r.raw, 32)))
            if r.outcome == "silence" and r.window:
                w("  %-12s %-8s saw: %s" % ("", "", hexdump(r.window, 28)))
        w("")
    w("=" * 72)
    return "\n".join(out)


def probe_json(obs, sweeps, device):
    return {
        "device": device,
        "baud": obs.baud,
        "bytes_read": obs.raw_bytes,
        "sync_hits": obs.sync_hits,
        "valid_frames": obs.valid_frames,
        "frame_ids": obs.frame_ids,
        "nmea_counts": obs.nmea_counts,
        "nmea_sample": obs.nmea_sample,
        # The raw window head, kept for the same reason ProbeResult keeps a
        # window per poll: without it, "recognised nothing" and "read nothing"
        # are indistinguishable, and only one of them supports concluding this
        # protocol is unsupported.
        "raw_head_hex": obs.raw_head.hex(),
        "sweeps": [
            {
                "framing": framing.name,
                "productive": productive(results),
                "probes": [
                    {
                        "poll": r.poll.label,
                        "why": r.poll.why,
                        "outcome": r.outcome,
                        "detail": r.detail,
                        "raw_hex": r.raw.hex() if r.raw else None,
                        "answered_in": r.answered_in,
                        "window_bytes": r.window_total,
                        "window_hex": r.window.hex() if r.window else None,
                        "frames_seen": r.seen,
                    }
                    for r in results
                ],
            }
            for framing, results in sweeps
        ],
    }


def cmd_probe(port, args):
    """Read-only diagnostic: what this receiver answers, and in which framing.

    Builds Session with allow_apply=False -- not a courtesy, a structural
    guarantee. That is the whole reason probe can be trusted on a live node:
    see Session's docstring and the --selftest check that walks this file's
    own syntax tree to confirm nothing outside {write, poll, apply, _exchange,
    _probe_binary} can reach the wire. The sweep itself is _probe_view,
    shared with the REPL's 'probe' command -- see the module comment above
    _repl_set for why the Session construction stays HERE, as this
    function's own first statement, rather than moving into the shared body.
    """
    session = Session(port, allow_apply=False)
    return _probe_view(session, args.listen_seconds, args.json)


def _probe_view(session, seconds, json_path):
    """The sweep-and-report body shared by cmd_probe (fresh read-only
    Session per one-shot run) and _repl_probe (the REPL's one shared
    session). Neither caller does anything to the port beyond handing in a
    Session; this is the entire probe.
    """
    print("Listening at %d baud for %.0fs (sending nothing)..."
          % (session.port.baud, seconds))
    obs = session.observe(seconds)

    # PROBE_ORDER puts CASIC first unconditionally -- not because phase 1
    # suggests it, but because it is the documented finding this tool exists
    # to act on: this receiver EMITS u-blox framing and ACCEPTS CASIC framing,
    # and those are different questions. Falling back through the rest of
    # PROBE_ORDER covers the case that finding does not hold on whatever chip
    # is actually attached today.
    sweeps = []
    for framing in PROBE_ORDER:
        print("Sweeping %s framing..." % framing.name)
        results = sweep(session, framing)
        sweeps.append((framing, results))
        if productive(results):
            break
        if framing is not PROBE_ORDER[-1]:
            print("  every binary poll refused; trying the next framing")

    print("")
    print(render_probe(obs, sweeps, session.port.path))

    if json_path:
        with open(json_path, "w") as fh:
            json.dump(probe_json(obs, sweeps, session.port.path), fh, indent=2)
        print("JSON written to %s" % json_path)

    return 0 if any(productive(results) for _, results in sweeps) else 2


# --------------------------------------------------------------------------
# show, monitor, bandwidth -- the operator-facing read-only views
#
# The trap these renderers face is the one the README already carries a scar
# for: gpsd synthesizes NMEA for its clients from binary data, so sentences
# the receiver never sent still appear downstream, and measuring that stream
# while calling it "the receiver" gets the conclusion exactly backwards. A
# CFG-PRT/CFG-RATE Get is a readback -- a real answer from the receiver, right
# now. Sentence rates and constellations are inferred by tallying what
# arrived (Session.current_rates/current_constellations). The fix itself is
# neither asked for nor counted -- GGA/GSA/GSV stream unsolicited -- so it is
# reported as observed, not read back. Every line below says which of the
# three it is, in brackets, so a reader cannot mistake one for another.
# --------------------------------------------------------------------------


def _code_text(table, code):
    """(code, text) for a documented spec code, or (code, None) if it is not
    in `table` -- an undocumented code renders as the raw number with a
    marker, not as a guess. code=None (field absent) renders as `(None, None)`
    so the caller's own "unknown" handling applies uniformly.
    """
    if code is None or code == "":
        return None, None
    return code, table.get(code)


def _render_code(table, code):
    """"unknown" for a missing field, "N (text)" for a code `table` documents,
    or "N (undocumented code)" for one it does not -- see _code_text. The raw
    code stays visible either way: an operator reading a bug report is better
    served by "quality 2 (differential/SBAS, fix valid)" than by prose alone.
    """
    code, text = _code_text(table, code)
    if code is None:
        return "unknown"
    if text is None:
        return "%s (undocumented code)" % (code,)
    return "%s (%s)" % (code, text)


def _or_unknown(value):
    """str(value), except a missing field (None or empty) says so.

    A parsed record may be incomplete -- Sentence.parse fills a missing field
    with "" or None rather than guessing -- and 0 is a real, present value
    (GGA <Quality> 0 is "no fix", not "field absent"), so this must not treat
    it as missing.
    """
    if value is None or value == "":
        return "unknown"
    return str(value)


def _one(bucket):
    """One (talker, record) from a talker-keyed dict.

    Does not prefer a talker by name -- the design rules rule that out (see
    "no name-based special-casing"). This receiver emits one combined-solution
    talker per epoch in practice, so there is normally exactly one entry;
    if more than one is present this returns whichever a plain dict yields
    first, which is not a policy choice, just a deterministic one.
    """
    if not bucket:
        return None
    return next(iter(bucket.items()))


def _field_describe(message, raw):
    """Field labels for an already-parsed reply, e.g. from Session.get().

    Message.describe() re-parses a payload's bytes; get() only ever hands
    back the parsed dict, not the frame it came from, so describe() cannot be
    reused directly. This mirrors it field-by-field over that dict instead.
    """
    return {f.name: f.describe(raw[f.name]) for f in message.fields}


def render_show(session, obs, readback=None):
    """Current configuration and fix -- see the module comment above for the
    provenance rule every line here follows.

    session may be None: current_rates/current_constellations need no live
    connection (they only ever look at obs), so the observed section renders
    the same with or without one, exactly as Session(None) already does in
    --selftest for the same methods. Only the two Gets below need a real
    session; without one they render as "not read back", never silently
    omitted.

    readback, when given, is (prt, rate) -- the already-parsed CFG-PRT/
    CFG-RATE dicts (either may be None) -- and is used INSTEAD of querying
    `session`, even if `session` is not None. This is what lets a caller that
    redraws repeatedly (cmd_monitor) do the two Gets ONCE, before its loop,
    and pass the result in on every redraw rather than calling this with a
    live session on a timer: the latter looks read-only but is not -- each
    call would re-transmit, re-flush the port's input buffer, and feed the
    reply into the SESSION's own NmeaCollector rather than the Observation
    on screen, silently undercounting exactly what the display claims to
    be measuring passively. cmd_show, a one-shot command, has no such loop
    and is correct to omit `readback` and let this query `session` directly.
    """
    out = []
    w = out.append
    w("gnssctl show")
    w("-" * 60)

    # current_rates/current_constellations touch no port state (see their own
    # docstrings) -- Session(None) is what --selftest already uses to call
    # them with no hardware, so the same construction covers session=None
    # here without a second implementation to drift out of step.
    inferrer = session if session is not None else Session(None)

    if readback is not None:
        prt, rate = readback
    else:
        prt = session.get(CFG_PRT) if session is not None else None
        rate = session.get(CFG_RATE) if session is not None else None

    if prt is not None:
        d = _field_describe(CFG_PRT, prt)
        w("  port            %d baud, %s, %s  [readback: CFG-PRT]" % (
            prt["baudRate"], d["mode"], ", ".join(d["protoMask"]) or "no protocols"))
    else:
        w("  port            unknown -- no CFG-PRT reply  [not read back]")

    if rate is not None and rate.get("interval"):
        w("  fix interval    %d ms (%.3g Hz)  [readback: CFG-RATE]" % (
            rate["interval"], 1000.0 / rate["interval"]))
    else:
        w("  fix interval    unknown -- no CFG-RATE reply  [not read back]")

    rates = inferrer.current_rates(obs)
    on = ", ".join("%s@%d" % kv for kv in sorted(rates.items())) or "none seen"
    w("  sentence rates  %s  [observed: tallied from the wire, +-1 epoch]" % on)

    cons = inferrer.current_constellations(obs)
    if obs.constellations:
        note = "observed: GSV talkers seen"
    else:
        note = "assumed: no GSV counted, so all of §2.3.4 is possible"
    w("  constellations  %s  [%s]" % ("+".join(sorted(cons)), note))

    w("")
    gga = _one(obs.records("GGA"))
    gsa = _one(obs.records("GSA"))
    if gga is None and gsa is None:
        w("  fix             none observed yet  [observed]")
    else:
        if gsa is not None:
            _, rec = gsa
            w("  fix type        %s  [observed: GSA <FixMode>]" % (
                _render_code(GSA_FIX_MODE, rec.get("fixMode"))))
            w("  DOP (P/H/V)     %s / %s / %s  [observed: GSA]" % (
                _or_unknown(rec.get("pdop")), _or_unknown(rec.get("hdop")),
                _or_unknown(rec.get("vdop"))))
        if gga is not None:
            _, rec = gga
            w("  quality         %s  [observed: GGA <Quality>]" % (
                _render_code(GGA_QUALITY, rec.get("quality"))))
            w("  satellites used %s  [observed: GGA <NumSatUsed>]" % (
                _or_unknown(rec.get("numSatUsed"))))
            w("  HDOP            %s  [observed: GGA <HDOP>]" % (
                _or_unknown(rec.get("hdop"))))
            w("  position        %s%s %s%s  alt %s%s  [observed: GGA]" % (
                _or_unknown(rec.get("lat")), rec.get("ns") or "",
                _or_unknown(rec.get("lon")), rec.get("ew") or "",
                _or_unknown(rec.get("alt")), rec.get("altUnit") or ""))
    return "\n".join(out)


def render_sky(obs):
    """The satellites currently in view -- entirely an observation.

    GSV and GSA both stream unsolicited; there is no Get to contrast them
    with, so unlike render_show this needs no line-by-line source tag -- the
    whole table is [observed].
    """
    sky = obs.sky
    if not sky:
        return "  sky  [observed: GSV]\n    none observed yet"

    # GSA's satID is a single-field repeat block, which Sentence.parse stores
    # as the raw field text rather than running it through IntC's decode (see
    # the "GSA parses..." vendor-vector check, which pins ["10","13",...] with
    # "" padding, not ints with None) -- the same text GSV's own Num-decoded
    # satID already is, so comparing them as strings, unconverted, is correct
    # rather than a shortcut.
    used = set()
    for rec in obs.records("GSA").values():
        for sid in rec.get("sats") or []:
            if sid:
                used.add(sid)

    out = ["  sky  [observed: GSV, cross-checked against GSA's used list]",
           "  %-6s %-4s %5s %5s %5s  %s" % (
               "talker", "sat", "elev", "az", "cn0", "used")]
    for talker in sorted(sky):
        for satid in sorted(sky[talker], key=lambda s: (len(s), s)):
            row = sky[talker][satid]
            out.append("  %-6s %-4s %5s %5s %5s  %s" % (
                talker, satid, _or_unknown(row.get("elev")),
                _or_unknown(row.get("az")), _or_unknown(row.get("cn0")),
                "yes" if satid in used else "-"))
    return "\n".join(out)


def _clear_screen():
    # print(), not sys.stdout.write(): _write_sites() (the read-only-guarantee
    # check) flags ANY function containing a .write() call, transmit or not --
    # see its own docstring -- and this is cosmetic, not a wire write.
    print("\x1b[2J\x1b[H", end="")


def cmd_show(port, args):
    """Read-only snapshot: current configuration (readback) and fix (observed).

    Session built allow_apply=False. render_show's own Gets (CFG-PRT,
    CFG-RATE) are the query convention §3.1 defines, not the apply() path --
    see Session's own docstring for why that is structural, not a promise.
    The report itself is _show_view, shared with the REPL's 'show' command.
    """
    session = Session(port, allow_apply=False)
    seconds = getattr(args, "listen_seconds", None) or session.observe_seconds
    _show_view(session, seconds)
    return 0


def _show_view(session, seconds):
    """The report body shared by cmd_show (fresh read-only Session per
    one-shot run) and _repl_show (the REPL's one shared session).
    """
    print("Listening at %d baud for %.1fs, plus CFG-PRT and CFG-RATE Gets..."
          % (session.port.baud, seconds))
    obs = session.observe(seconds)
    print("")
    print(render_show(session, obs))
    print("")
    print(render_sky(obs))


def cmd_monitor(port, args):
    """Live view: reads CFG-PRT/CFG-RATE ONCE, then feeds one long-lived
    Observation purely by watching, redrawing on a timer until Ctrl-C.

    Session built allow_apply=False -- read-only by construction, matching
    show and bandwidth. The loop itself is _monitor_loop, shared with the
    REPL's 'monitor' command; see its docstring for why the readback happens
    once, before the loop, rather than on every redraw.
    """
    # timeout overridable the same way listen_seconds is elsewhere in this
    # file -- not a production knob, but without it --selftest could only
    # drive this loop's real code at the production 1.5s-per-Get pace.
    session = Session(port, allow_apply=False,
                      timeout=getattr(args, "timeout", None) or PROBE_TIMEOUT)
    return _monitor_loop(session, bool(getattr(args, "raw", False)),
                         getattr(args, "interval", None) or 1.0)


def _monitor_loop(session, raw, interval):
    """The readback-once/redraw-loop body shared by cmd_monitor (fresh
    read-only Session per one-shot run) and _repl_monitor (the REPL's one
    shared session).

    Reads CFG-PRT/CFG-RATE ONCE; the redraw loop below is the ONLY other
    thing this function ever transmits, and it doesn't transmit at all --
    every redraw calls render_show(None, obs, readback=...) rather than
    handing the loop a live session, so a redraw can never re-send a Get.

    That distinction is not cosmetic. An earlier version called
    render_show(session, obs) from inside the loop. render_show does its own
    session.get(CFG_PRT)/get(CFG_RATE) whenever session is not None, and
    each get() flushes the port's input buffer, writes a frame, and reads
    for up to Session's timeout (1.5s default) -- feeding whatever NMEA
    arrives into the SESSION's own NmeaCollector, a different object from
    `obs`. So every redraw sent two frames, discarded buffered wire data
    twice, and diverted several seconds of real traffic away from the
    Observation the display claims to be built from -- while the banner
    printed "nothing sent". That is this task's own failure mode, produced
    by this task's own code: the measurement apparatus corrupting the
    measurement while asserting it is passive. See render_show's docstring
    for the `readback` parameter this loop uses to avoid it.

    Port.read already selects on the serial fd for `interval` seconds, so
    the loop body is one port.read() call per redraw with no separate wait
    step. Port.fd is public so a future interactive mode could select() on
    it alongside stdin for pause/toggle keys -- an open question with the
    human, deliberately not built here -- without restructuring this loop;
    it would replace the single port.read() call with a select() over
    {port.fd, stdin} and dispatch on which fired.
    """
    print("Reading CFG-PRT and CFG-RATE once...")
    readback = (session.get(CFG_PRT), session.get(CFG_RATE))

    obs = Observation(session.port.baud)
    scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS} if raw else {}

    print("Watching %s at %d baud -- nothing else is sent. Ctrl-C to stop."
          % (session.port.path, session.port.baud))
    try:
        while True:
            data = session.port.read(interval)
            # Decoded fresh each iteration, not accumulated: these are
            # printed AFTER the clear and the panels below, appended under
            # the sky table, so they are visible for this redraw's `interval`
            # seconds rather than erased by the very next line of output --
            # an earlier version cleared the screen immediately after
            # printing them, so the feature ran but nothing was ever visible
            # to a human watching the terminal.
            raw_lines = []
            if data:
                obs.absorb(data)
                if raw:
                    for sc in scanners.values():
                        sc.feed(data)
                        for fr in sc.take():
                            detail = Session._decode(fr)
                            raw_lines.append("  %-9s %02x-%02x  %s" % (
                                fr.framing, fr.cls, fr.mid,
                                detail if detail else hexdump(fr.payload, 24)))
            _clear_screen()
            print(render_show(None, obs, readback=readback))
            print("")
            print(render_sky(obs))
            if raw:
                print("")
                print("  raw frames this cycle:")
                for line in raw_lines:
                    print(line)
                if not raw_lines:
                    print("    none")
    except KeyboardInterrupt:
        print("")
    return 0


def _parse_rate_overrides(text):
    """{'GGA': 1, ...} from 'GGA=1,GSV=2'.

    Reuses SetSentences' own validation -- names from PCAS03's field table,
    the 0-9 bound from OptInt -- so a typo in --sentences is refused the same
    way it would be on the wire, rather than drifting from it. The instance
    is never sent; only .rates is read, and cmd_bandwidth is the only caller.
    """
    out = {}
    for item in text.split(","):
        item = item.strip()
        if not item:
            continue
        name, sep, value = item.partition("=")
        if not sep:
            raise ValueError("%r: expected NAME=RATE" % item)
        out[name.strip().upper()] = int(value)
    return SetSentences(out).rates


def cmd_bandwidth(port, args):
    """Bandwidth arithmetic for the current configuration, or a hypothetical
    one given --rate/--baud/--sentences. Sends nothing at all: session.observe
    is a passive listen, and that is the only thing this function does with
    the port -- no Get, no poll, no apply. (See the design doc: "prints the
    arithmetic ... without sending anything.") The arithmetic itself is
    _bandwidth_view, shared with the REPL's 'bandwidth' command.
    """
    session = Session(port, allow_apply=False)
    seconds = getattr(args, "listen_seconds", None) or session.observe_seconds
    return _bandwidth_view(session, seconds, rate=getattr(args, "rate", None),
                           baud=getattr(args, "baud", None),
                           sentences=getattr(args, "sentences", None))


def _bandwidth_view(session, seconds, rate=None, baud=None, sentences=None):
    """The arithmetic shared by cmd_bandwidth (fresh read-only Session per
    one-shot run) and _repl_bandwidth (the REPL's one shared session). Sends
    nothing, in either case: session.observe is a passive listen, and that
    is the only thing this does with the port.
    """
    print("Listening at %d baud for %.1fs (sending nothing)..."
          % (session.port.baud, seconds))
    obs = session.observe(seconds)

    rates = session.current_rates(obs)
    if sentences:
        # Only what the width model can price enters the budget -- see
        # SetSentences.projected's identical filter and its comment on ANT.
        rates.update({k: v for k, v in _parse_rate_overrides(sentences).items()
                      if k in STANDARD_SENTENCES})

    constellations = session.current_constellations(obs)
    baud = baud or session.port.baud

    if rate:
        hz = float(rate)
        hz_note = "given by --rate"
    else:
        # No CFG-RATE Get: this command sends nothing at all, so the real
        # rate cannot be read back. Assuming the fastest documented rate is
        # the same asymmetry Session.current_hz() applies when ITS Get fails
        # -- over-stating hz costs a refusal --force can override;
        # under-stating waves through exactly the overload the guard exists
        # to catch.
        hz = 1000.0 / min(NAV_INTERVALS)
        hz_note = "assumed: fastest documented rate (%.3g Hz) -- no Get sent" % hz

    bud = budget(rates, baud, hz, obs.sats_in_view, constellations)
    print("")
    print("  fix rate                %s" % hz_note)
    print(bud.render())
    return 0 if bud.ok else 1


# --------------------------------------------------------------------------
# The REPL -- the one place `apply` is reachable interactively.
#
# repl() is handed ONE already-open, already-writable Session (allow_apply=
# True) and never builds another: ServiceGuard stops gpsd.socket AND
# gpsd.service (see its own docstring), which drops the node's stratum-1
# clock for minutes, so that has to happen once per REPL run, not once per
# line typed at the prompt. The caller (the future CLI entry point) opens
# the port, runs ServiceGuard, builds this one Session, and only then calls
# repl(session, args).
#
# show/monitor/probe/bandwidth each have TWO entry points now: cmd_* for the
# one-shot CLI path (a fresh process, a fresh Session per invocation) and
# _repl_* for this REPL (one Session shared for the whole run). Both call
# the SAME shared view function -- _show_view, _monitor_loop, _probe_view,
# _bandwidth_view, defined next to their cmd_* caller above -- with a
# session already in hand. That sharing is what "the REPL dispatches
# read-only commands through the one session it was given, not a second
# one" actually looks like in code: the alternative, kept out on purpose,
# was two independent copies of each loop that a bug fix would have to be
# found and applied twice. That is not hypothetical: cmd_monitor's own
# redraw loop once transmitted on every redraw while its own banner claimed
# "sending nothing" -- it flushed the port and diverted NMEA into a
# different collector each time, starving the very display it was meant to
# refresh. One shared _monitor_loop means that class of bug gets fixed once,
# for both entry points, not once per copy.
#
# cmd_show/cmd_monitor/cmd_bandwidth keep their OWN
# Session(port, allow_apply=False, ...) construction as their literal first
# statement -- NOT delegated into the shared view -- because --selftest's
# _session_calls(name) asserts read-only-ness by finding that exact call
# inside each of THEIR OWN function bodies; moving it into a function they
# merely call would make that assertion find nothing rather than something
# wrong. Every _repl_* handler below, conversely, contains NO Session(...)
# call anywhere in its own body -- also asserted by _session_calls -- because
# it is handed the REPL's one session directly and passes it straight into
# the same shared view its cmd_* counterpart uses.
# --------------------------------------------------------------------------


def _parse_flags(tokens, flag_names):
    """(positional, {flag: value-or-True}) from a REPL argument list.

    The REPL's own microsyntax -- plain space-separated tokens, matching
    meshcorectl's commands -- rather than a second argparse tree next to the
    one the CLI entry point will build. `flag_names` maps each accepted
    `--name` to whether it takes a value. An unrecognised `--flag` raises
    rather than being folded into the positional list: the design rule
    against guessing on malformed input applies to REPL parsing too, not
    only to the spec-derived validation downstream of it.
    """
    positional = []
    flags = {}
    tokens = list(tokens)
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok.startswith("--"):
            name = tok[2:]
            if name not in flag_names:
                raise ValueError("unknown option --%s" % name)
            if flag_names[name]:
                i += 1
                if i >= len(tokens):
                    raise ValueError("--%s needs a value" % name)
                flags[name] = tokens[i]
            else:
                flags[name] = True
        else:
            positional.append(tok)
        i += 1
    return positional, flags


def _parse_set_rate(text):
    """Milliseconds for `set rate`, accepting either form this file's own
    module docstring advertises ("gnssctl set rate 5hz"): a bare number is
    milliseconds, one ending "hz" is a frequency. This only converts units --
    SetRate.__init__ is what decides which resulting interval is legal
    (NAV_INTERVALS, §2.3.2/§3.2.2.4), so a bad unit conversion still surfaces
    as SetRate's own spec-citing refusal rather than a silent guess here.
    """
    text = text.strip()
    if text.lower().endswith("hz"):
        hz = float(text[:-2])
        if hz <= 0:
            raise ValueError("rate must be a positive number of Hz")
        return int(round(1000.0 / hz))
    return int(text)


def _parse_set_constellation(tokens):
    """frozenset of constellation names from 'set constellation' tokens.

    'GPS+BDS', 'GPS,BDS' and 'GPS BDS' (separate tokens) all collapse to the
    same join-then-split, so none is a special case of another. This only
    tokenises; SetConstellation.__init__ validates the combination against
    §2.3.4.
    """
    joined = "+".join(tokens).replace(",", "+")
    return frozenset(p.strip().upper() for p in joined.split("+") if p.strip())


def _repl_set(session, rest):
    """'set baud|rate|sentences|constellation ...' -> one Change -> apply()
    on the session repl() was handed.
    """
    tokens = rest.split()
    if not tokens:
        raise ValueError("set needs a target: baud, rate, sentences or "
                         "constellation")
    target, tokens = tokens[0], tokens[1:]
    positional, flags = _parse_flags(tokens, {"force": False, "yes": False})

    if target == "baud":
        if len(positional) != 1:
            raise ValueError("set baud takes exactly one value, e.g. "
                             "'set baud 9600'")
        change = SetBaud(int(positional[0]))
    elif target == "rate":
        if len(positional) != 1:
            raise ValueError("set rate takes exactly one value, e.g. "
                             "'set rate 5hz' or 'set rate 200'")
        change = SetRate(_parse_set_rate(positional[0]))
    elif target == "sentences":
        if not positional:
            raise ValueError("set sentences needs at least one NAME=RATE "
                             "pair, e.g. 'set sentences GSV=1'")
        change = SetSentences(_parse_rate_overrides(",".join(positional)))
    elif target == "constellation":
        if not positional:
            raise ValueError("set constellation needs at least one "
                             "constellation, e.g. 'set constellation GPS+BDS'")
        change = SetConstellation(_parse_set_constellation(positional))
    else:
        raise ValueError("no such 'set' target: %r (baud, rate, sentences, "
                         "constellation)" % target)

    print(session.apply(change, force=flags.get("force", False),
                        yes=flags.get("yes", False)))


def _repl_restart(session, rest):
    """'restart hot|warm|cold|factory [--yes]' -> Restart -> apply()."""
    positional, flags = _parse_flags(rest.split(), {"force": False, "yes": False})
    if len(positional) != 1:
        raise ValueError("restart takes exactly one kind: %s"
                         % ", ".join(sorted(RESTART_FLAG)))
    change = Restart(positional[0])
    print(session.apply(change, force=flags.get("force", False),
                        yes=flags.get("yes", False)))


def _repl_show(session, rest):
    """'show' -> _show_view, the same body cmd_show uses, against the
    session repl() was handed.
    """
    if rest:
        raise ValueError("show takes no arguments")
    _show_view(session, session.observe_seconds)


def _repl_monitor(session, rest):
    """'monitor [--raw] [--interval N]' -> _monitor_loop, the same body
    cmd_monitor uses (see its docstring for why the CFG-PRT/CFG-RATE
    readback happens ONCE, before the loop), against the session repl() was
    handed.
    """
    positional, flags = _parse_flags(rest.split(), {"raw": False, "interval": True})
    if positional:
        raise ValueError("monitor takes no positional arguments -- only "
                         "--raw / --interval")
    raw = bool(flags.get("raw", False))
    interval = float(flags["interval"]) if "interval" in flags else 1.0
    _monitor_loop(session, raw, interval)


def _repl_probe(session, rest):
    """'probe [--json PATH]' -> _probe_view, the same body cmd_probe uses,
    against the session repl() was handed.
    """
    positional, flags = _parse_flags(rest.split(), {"json": True})
    if positional:
        raise ValueError("probe takes no positional arguments -- only --json")
    _probe_view(session, session.observe_seconds, flags.get("json"))


def _repl_bandwidth(session, rest):
    """'bandwidth [--rate N] [--baud N] [--sentences ...]' -> _bandwidth_view,
    the same body cmd_bandwidth uses, against the session repl() was handed.
    Sends nothing, same as cmd_bandwidth: no Get, no poll, no apply.
    """
    positional, flags = _parse_flags(
        rest.split(), {"rate": True, "baud": True, "sentences": True})
    if positional:
        raise ValueError("bandwidth takes no positional arguments -- only "
                         "--rate / --baud / --sentences")
    baud = int(flags["baud"]) if "baud" in flags else None
    _bandwidth_view(session, session.observe_seconds, rate=flags.get("rate"),
                    baud=baud, sentences=flags.get("sentences"))


# Keyed by the first word of every COMMANDS entry except "help"/"quit" -- see
# the --selftest check that walks COMMANDS and confirms none is missing here.
# Every value takes (session, rest): the one session repl() was handed, and
# whatever the user typed after the verb, unparsed.
DISPATCH = {
    "show": _repl_show,
    "monitor": _repl_monitor,
    "probe": _repl_probe,
    "bandwidth": _repl_bandwidth,
    "set": _repl_set,
    "restart": _repl_restart,
}

COMMANDS = ("show", "monitor", "probe", "bandwidth", "set baud", "set rate",
            "set sentences", "set constellation", "restart", "help", "quit")

HISTFILE = os.path.expanduser("~/.gnssctl_history")


def completer(text, state):
    matches = [c for c in COMMANDS if c.startswith(text)]
    return matches[state] if state < len(matches) else None


def _help_text():
    return "\n".join(
        ["Commands:"] + ["  " + c for c in COMMANDS] +
        ["", "Tab completes, Ctrl-D or 'quit' exits.",
         "'set'/'restart' take --force / --yes, same as the one-shot CLI."])


def repl(session, args):
    """Interactive command loop over one already-open, already-writable
    Session -- see the module comment above this section for why it takes a
    session rather than a port, and why DISPATCH's handlers do too.

    Follows meshcorectl's interactive() shape exactly, since that pattern is
    already proven in this repository and users of one tool will expect the
    other to behave the same way: readline imported locally (so a Python
    stripped of the readline module still runs one-shot commands -- the
    module-level code never imports it, only this function does, and this
    function is only reached for interactive use), persistent history in
    HISTFILE, Tab completion via `completer`, Ctrl-D to exit, and history
    saved via atexit -- not only on a clean loop exit -- so an exception
    that escapes the loop still leaves the session's history on disk, the
    same guarantee meshcorectl.interactive() gives its own history file.

    `args` is accepted for signature parity with the CLI entry point this
    file will grow (a parse_args() Namespace); nothing here reads it yet.
    """
    import readline
    try:
        readline.read_history_file(HISTFILE)
    except OSError:
        pass
    atexit.register(lambda: _save_history(readline))
    readline.set_history_length(1000)
    readline.set_completer_delims("")
    readline.set_completer(completer)
    readline.parse_and_bind("tab: complete")

    print("gnssctl -> %s at %d baud   (Tab completes, Ctrl-D quits)"
          % (session.port.path, session.port.baud))
    while True:
        try:
            line = input("gnssctl> ").strip()
        except EOFError:
            print("")
            break
        except KeyboardInterrupt:
            print("")
            continue
        if not line:
            continue
        if line in ("quit", "exit"):
            break
        if line == "help":
            print(_help_text())
            continue

        verb, _, rest = line.partition(" ")
        handler = DISPATCH.get(verb)
        if handler is None:
            print("gnssctl: no such command %r (try 'help')" % verb)
            continue
        try:
            handler(session, rest.strip())
        except ValueError as exc:
            # Surfaces the Change subclass's OWN spec-citing message (or this
            # REPL's own parsing errors, in the same voice) rather than
            # replacing it with something vaguer -- the design rule Tasks 9
            # and 11 both had to re-learn the hard way.
            print("gnssctl: %s" % exc)
        except KeyboardInterrupt:
            print("")
        except OSError as exc:
            print("gnssctl: %s: %s" % (type(exc).__name__, exc))

    return 0


def _save_history(readline):
    try:
        readline.write_history_file(HISTFILE)
    except OSError:
        pass


# --------------------------------------------------------------------------
# main -- the front door. Wires argparse onto the cmd_*/repl entry points
# above and owns the exit codes (see the design doc's "Exit status" table).
#
#   0   did what was asked, including a receiver NAK -- a NAK is an answer
#   1   refused to run, or could not get the port
#   2   ran, but recognised no framing at any speed
#   3   a guard rail refused the operation (--force overrides)
#   130 interrupted
#
# init is exempt: cmd_init always returns 0 (see its own section banner --
# a failed ExecStartPre stops gpsd outright, which is worse than a
# mis-tuned receiver).
# --------------------------------------------------------------------------

EXIT_OK = 0
EXIT_NO_PORT = 1
EXIT_NO_FRAMING = 2
EXIT_REFUSED = 3
EXIT_INTERRUPTED = 130

# The seven CLI verbs, in the order the design lists them. Used both to
# build the argparse tree and, in _split_device below, to tell a verb apart
# from a device positional without a second, drifting copy of this list.
COMMAND_NAMES = ("show", "monitor", "probe", "bandwidth", "set", "restart",
                 "init")


def _split_device(argv):
    """(device_or_None, remaining_argv).

    argparse cannot host an optional positional (device) ahead of
    subparsers the way this file's own docstring and the design doc want:
    verified empirically against a minimal reproduction of this exact tree
    -- parsing a single leftover token resolves it to the LATER positional
    (the subparsers command) before the earlier one (device), so a bare
    'gnssctl /dev/ttyUSB0' -- meant to enter the REPL against that device,
    same as bare 'gnssctl' does against the default one -- raises "invalid
    choice: '/dev/ttyUSB0'" instead. The split is therefore done by hand,
    here, before argparse ever sees argv: only argv[0] is inspected --
    device, if given at all, must be the first argument, before any flag or
    the subcommand (parse_args' own description says so) -- and it counts
    as the device only when it is not itself a flag or one of the seven
    known verbs.
    """
    if argv and not argv[0].startswith("-") and argv[0] not in COMMAND_NAMES:
        return argv[0], argv[1:]
    return None, argv


def _build_parser():
    """The argparse.ArgumentParser itself, built but not yet run against
    any argv.

    Factored out of parse_args() so --selftest can inspect the live tree
    argparse itself builds -- e.g. which verbs the top-level subparsers
    action actually offers, or which targets 'set's own sub-subparsers
    offer -- and assert SET_BUILDERS/CLI_DISPATCH against THAT, rather than
    against a second, hand-authored list that could drift from what the
    parser really accepts. See _subparser_choices below and the checks that
    use it.

    --force/--yes/--raw/--json/--interval reuse the REPL's own flag names
    for the same meanings (see _parse_flags and the DISPATCH handlers above)
    so a user moving between the REPL and one-shot commands finds the same
    vocabulary. Each is attached only to the subparser(s) it actually means
    something for -- exactly where the REPL itself accepts it -- rather than
    promoted to a single top-level flag: argparse writes an UNGIVEN option's
    own default into the shared namespace when ITS subparser runs, which
    would silently overwrite a same-named top-level flag's value the moment
    a subcommand that also declares it is chosen (verified empirically the
    same way as _split_device's own docstring). --baud is the one exception,
    global by construction rather than choice: it names the SAME port speed
    either way -- what to open the device at, and (for 'bandwidth', which
    reads it back out of args without a subparser-local copy) the
    hypothetical link speed to price -- so one flag serves both without
    that collision.
    """
    ap = argparse.ArgumentParser(
        prog="gnssctl",
        description="Read and configure the GNSS receiver on this node. "
                    "DEVICE, if given, must be the first argument, before "
                    "any flag or subcommand.")
    ap.add_argument("--baud", type=int, choices=sorted(BAUD_CODE),
                    default=None,
                    help="force a speed instead of auto-detecting over %s; "
                         "also prices 'bandwidth's hypothetical link" %
                         " then ".join(str(b) for b in BAUD_CANDIDATES))
    ap.add_argument("--no-service-control", action="store_true",
                    help="do not stop/start gpsd; assume the port is "
                         "already free")
    ap.add_argument("--via", choices=("pcas", "casic"), default="pcas",
                    help="protocol 'set'/'restart' write configuration "
                         "through (§2.3 vs §3.2) -- casic is not yet "
                         "implemented by any Change class in this file, "
                         "which only builds the $PCAS path, so 'set'/"
                         "'restart' refuse rather than silently falling "
                         "back to pcas")
    ap.add_argument("--selftest", action="store_true",
                    help="run built-in tests and exit; touches no hardware")

    # --force/--yes: only 'set's four targets and 'restart' mean anything by
    # them (needs_yes/the bandwidth guard -- see Change/Session.apply), so a
    # shared parent is attached to just those subparsers below, matching
    # exactly what the REPL's own _repl_set/_repl_restart accept.
    force_yes = argparse.ArgumentParser(add_help=False)
    force_yes.add_argument("--force", action="store_true",
                           help="override the bandwidth guard")
    force_yes.add_argument("--yes", action="store_true",
                           help="confirm a destructive change")

    sub = ap.add_subparsers(dest="command",
                            metavar="{%s}" % ",".join(COMMAND_NAMES))

    sub.add_parser("show", help="current configuration and fix")

    p = sub.add_parser("monitor", help="live view; Ctrl-C to stop")
    p.add_argument("--raw", action="store_true",
                   help="also show decoded raw frames")
    p.add_argument("--interval", type=float, default=None,
                   help="redraw interval in seconds (default 1.0)")
    p.add_argument("--timeout", type=float, default=None,
                   help="per-exchange timeout in seconds (default %.1f)"
                        % PROBE_TIMEOUT)

    p = sub.add_parser("probe", help="read-only capability sweep")
    p.add_argument("--listen-seconds", dest="listen_seconds", type=float,
                   default=10.0, help="phase 1 duration (default 10)")
    p.add_argument("--json", metavar="PATH", default=None,
                   help="also write results as JSON")

    p = sub.add_parser("bandwidth", help="bandwidth arithmetic for the "
                       "current, or a hypothetical, configuration")
    p.add_argument("--rate", type=float, default=None,
                   help="hypothetical fix rate in Hz")
    p.add_argument("--sentences", default=None,
                   help="hypothetical sentence rates, e.g. GSV=1,GGA=1")

    p = sub.add_parser("set", help="change a receiver setting, verified")
    set_sub = p.add_subparsers(dest="set_target", required=True,
                               metavar="{baud,rate,sentences,constellation}")
    b = set_sub.add_parser("baud", parents=[force_yes])
    b.add_argument("value", type=int, choices=sorted(BAUD_CODE))
    r = set_sub.add_parser("rate", parents=[force_yes])
    r.add_argument("value", type=_parse_set_rate,
                   help="milliseconds (%s), or e.g. '5hz'"
                        % "/".join(str(i) for i in NAV_INTERVALS))
    s = set_sub.add_parser("sentences", parents=[force_yes])
    s.add_argument("pairs", nargs="+", metavar="NAME=RATE")
    c = set_sub.add_parser("constellation", parents=[force_yes])
    c.add_argument("names", nargs="+", metavar="NAME")

    p = sub.add_parser("restart", parents=[force_yes],
                       help="restart the receiver")
    p.add_argument("kind", choices=sorted(RESTART_FLAG))

    p = sub.add_parser("init", help="boot-path setup for gpsd's "
                       "ExecStartPre; always exits 0")
    p.add_argument("--timeout", type=float, default=10.0,
                   help="deadline in seconds (default 10)")

    return ap


def _subparser_choices(parser):
    """{name: sub-ArgumentParser} for the first level of subparsers under
    `parser` -- argparse's own record of what a subcommand tree actually
    offers, read from the live parser object rather than restated as a
    second, driftable list. () if `parser` declares no subparsers action
    (a leaf, e.g. 'set baud').
    """
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return dict(action.choices)
    return {}


def parse_args(argv):
    """argparse.Namespace for one gnssctl invocation.

    Every attribute a cmd_* function reads via args.NAME (see each cmd_*'s
    own docstring, and the interface note at the top of this section) is
    guaranteed present here, with a sensible default, whether or not the
    corresponding flag was given on the command line -- see the --selftest
    checks below that walk this function's own output and assert exactly
    that for cmd_probe/cmd_monitor/cmd_bandwidth/cmd_init.
    """
    device, rest = _split_device(list(argv))
    args = _build_parser().parse_args(rest)
    args.device = device
    return args


# Which Change each 'set' target builds, keyed by argparse's own set_target
# dest -- a table, not an if/elif chain matching the target's name, per the
# design rule against name-based special-casing (the same rule _mode_flags,
# _absorb_sky and Field.describe's own comments cite). Reuses
# _parse_rate_overrides/_parse_set_constellation from the REPL section
# above rather than restating either parse.
SET_BUILDERS = {
    "baud": lambda a: SetBaud(a.value),
    "rate": lambda a: SetRate(a.value),
    "sentences": lambda a: SetSentences(_parse_rate_overrides(
        ",".join(a.pairs))),
    "constellation": lambda a: SetConstellation(_parse_set_constellation(
        a.names)),
}


def _via_refusal(args, verb):
    """A refusal message if --via casic was asked of `verb`, else None.

    Every Change class in this file (SetBaud, SetRate, SetSentences,
    SetConstellation, Restart -- see CHANGES) builds only $PCAS sentences;
    none builds the CASIC CFG-MSG/CFG-RST 'set' frames the design doc's own
    "Why both command paths are exposed" section describes as the
    alternative. Silently treating --via casic as --via pcas would answer a
    question the caller did not ask; refusing outright says so instead.
    """
    if args.via != "casic":
        return None
    return ("gnssctl: --via casic is not implemented for '%s' -- every "
           "Change class in this file only builds the $PCAS path. Drop "
           "--via, or pass --via pcas." % verb)


def cmd_set(port, args):
    """CLI entry point for 'gnssctl set TARGET ...'.

    Builds the Change parse_args' set_target subparser resolved (via
    SET_BUILDERS) and applies it through a fresh, writable Session --
    matching cmd_show/cmd_monitor/cmd_probe/cmd_bandwidth's own
    one-shot-per-invocation shape (a fresh process, a fresh Session), not
    the REPL's one-shared-Session-per-run shape; see the module comment
    above _repl_set for why the REPL needs the latter and this does not.

    timeout/observe_seconds are read the same way cmd_monitor reads its own
    `timeout` -- not real flags on 'set's argparse subparsers (nothing there
    asks for one), but an escape hatch getattr() leaves open so --selftest
    can drive apply()'s real code at something faster than its production
    1.5s-per-Get, 1.5s-per-observe pace.
    """
    reason = _via_refusal(args, "set %s" % args.set_target)
    if reason:
        print(reason, file=sys.stderr)
        return EXIT_NO_PORT
    try:
        change = SET_BUILDERS[args.set_target](args)
    except ValueError as exc:
        # The Change subclass's own spec-citing refusal (§2.3.x), the same
        # message the REPL surfaces from _repl_set -- not a vaguer one. No
        # Session has been built yet, so nothing has reached the wire.
        print("gnssctl: %s" % exc, file=sys.stderr)
        return EXIT_NO_PORT
    session = Session(port, allow_apply=True,
                      timeout=getattr(args, "timeout", None) or PROBE_TIMEOUT,
                      observe=getattr(args, "observe_seconds", None)
                              or OBSERVE_SECONDS)
    verdict = session.apply(change, force=args.force, yes=args.yes)
    print(verdict)
    return EXIT_REFUSED if verdict.status == "refused" else EXIT_OK


def cmd_restart(port, args):
    """CLI entry point for 'gnssctl restart KIND'. See cmd_set's docstring
    for why this builds its own Session (and reads the same timeout/
    observe_seconds escape hatch) rather than sharing one.
    """
    reason = _via_refusal(args, "restart")
    if reason:
        print(reason, file=sys.stderr)
        return EXIT_NO_PORT
    session = Session(port, allow_apply=True,
                      timeout=getattr(args, "timeout", None) or PROBE_TIMEOUT,
                      observe=getattr(args, "observe_seconds", None)
                              or OBSERVE_SECONDS)
    verdict = session.apply(Restart(args.kind), force=args.force,
                            yes=args.yes)
    print(verdict)
    return EXIT_REFUSED if verdict.status == "refused" else EXIT_OK


class _CliCommand:
    """One dispatchable CLI verb: its handler, and whether main() has to
    open the port (root check, ServiceGuard, baud auto-detection) before
    calling it.

    Declared per verb, in this one table (CLI_DISPATCH below), rather than
    as an 'if args.command == "init"' special case threaded through main()
    -- the same rule against dispatching on a name instead of a declared
    property that DISPATCH (the REPL's own table), POLLS and every Sentence's
    `repeat=` already follow. init is the sole needs_port=False entry: it
    runs before gpsd exists, manages its own Port, and must not require
    root beyond what ExecStartPre already grants (see its section banner).
    """
    __slots__ = ("fn", "needs_port")

    def __init__(self, fn, needs_port=True):
        self.fn = fn
        self.needs_port = needs_port


CLI_DISPATCH = {
    "show": _CliCommand(cmd_show),
    "monitor": _CliCommand(cmd_monitor),
    "probe": _CliCommand(cmd_probe),
    "bandwidth": _CliCommand(cmd_bandwidth),
    "set": _CliCommand(cmd_set),
    "restart": _CliCommand(cmd_restart),
    "init": _CliCommand(cmd_init, needs_port=False),
}


def _open_with_baud_detection(device, forced_baud, seconds, port_factory=Port):
    """(Port, Observation) at whichever candidate baud recognised something,
    or (None, the last Observation tried) if none did.

    Mirrors gnss-probe's own arrangement (see the design doc: "Port access
    reuses gnss-probe's existing arrangements: baud auto-detection over
    115200 then 9600") -- BAUD_CANDIDATES is that same order, reused rather
    than restated. Tries only `forced_baud` (--baud) when one is given.

    Raises whatever port_factory(device, baud) raises (OSError, for the
    real Port, if the device cannot be opened at all) rather than catching
    it here and trying the next candidate: an open failure is a property of
    the device, not the baud, and will not go away at a different speed --
    the same judgment gnss-probe's own main() already made.

    port_factory defaults to the real Port so main() gets real hardware
    access; --selftest passes a fake one instead, so this is exercised
    without touching hardware (see _baud_fake_factory below).
    """
    bauds = [forced_baud] if forced_baud else list(BAUD_CANDIDATES)
    obs = None
    for baud in bauds:
        port = port_factory(device, baud)
        print("Listening at %d baud for %.1fs (sending nothing)..."
              % (baud, seconds))
        obs = listen(port, seconds)
        if obs.recognised:
            return port, obs
        print("  nothing recognisable at %d baud" % baud)
        port.close()
    return None, obs


def _on_interrupt(guard):
    """Restore the ServiceGuard, then exit EXIT_INTERRUPTED.

    Named and factored out from where main() installs it -- for SIGTERM
    only (signal.signal(SIGTERM, lambda *_a: _on_interrupt(guard));
    SIGINT is deliberately left at Python's own default, see main()'s own
    docstring) -- so --selftest can call it directly against a fake guard
    and inspect what happened, rather than installing a real OS signal
    handler (which --selftest must not do -- there would be no safe way to
    fire it without either skipping the assertion or raising SystemExit
    through the test harness itself). Leaving gpsd stopped after a SIGTERM
    would silently cost the node its clock, so this runs before the exit,
    not after.
    """
    guard.restore()
    sys.exit(EXIT_INTERRUPTED)


def main(argv, port_factory=Port):
    """The front door. See the section banner above for the exit codes.

    --selftest is handled before anything else: no root, no device, no
    ServiceGuard. init bypasses the root check and the ServiceGuard
    entirely -- see _CliCommand's docstring -- via CLI_DISPATCH's own
    needs_port flag, not a name comparison here. Everything else requires
    root (to stop gpsd and open the port) unless --no-service-control is
    given. A bare invocation (no subcommand) enters the REPL, against one
    Session built here and handed to repl() -- see repl()'s own docstring
    for why it, unlike every cmd_*, does not build one itself.

    Only SIGTERM gets a custom handler, installed once the device is known
    to exist (so an interrupt before that has nothing to restore) -- see
    _on_interrupt. SIGINT is deliberately left at Python's own default,
    which raises KeyboardInterrupt: repl() catches it at the prompt and
    per-command (return to 'gnssctl>', not exit) and _monitor_loop catches
    it to stop cleanly and return 0 ("Ctrl-C to stop", its own --help text)
    -- both narrower, more specific handlers than this function has any
    business overriding. Installing a custom SIGINT handler here would stop
    Python from ever raising KeyboardInterrupt at all for the rest of the
    process (a signal handler REPLACES the default disposition, it does not
    sit in front of it), which would silently turn "Ctrl-C returns to the
    prompt" and "Ctrl-C stops monitor" into "Ctrl-C kills the process" --
    confirmed by executing the module before this fix. The `except
    KeyboardInterrupt` below is the outer net: it only catches what escapes
    repl()'s and _monitor_loop's own handling (there is none for
    show/probe/bandwidth/set/restart, and baud auto-detection itself has
    none either), and restores the guard the same way _on_interrupt does
    for SIGTERM.

    That outer net wraps `with guard:` itself, not just its body.
    ServiceGuard.__enter__ blocks for a second or two -- two
    systemctl("stop", ...) calls plus a settle sleep -- immediately after
    printing that the GNSS clock source is about to drop, which is exactly
    the moment an operator reconsidering reaches for Ctrl-C. Python does
    not call __exit__ when __enter__ itself raises, so a KeyboardInterrupt
    landing there would never reach restore() if the catch were only
    around the body (confirmed by executing the module before this fix:
    __enter__ raised, __exit__ was never called, gpsd stayed stopped, and
    the process still exited 130 by CPython's own top-level handling, so
    the exit code alone gave no sign anything had gone wrong). Catching
    outside `with guard:` and calling guard.restore() explicitly covers
    that window too; restore() is idempotent (its own _armed gate), so the
    same call after an interrupt from inside the body -- where __exit__
    already ran it once, normally, as part of the exception propagating
    through the `with` statement -- is a harmless no-op there.

    Port.close() is not idempotent (a second call raises "Bad file
    descriptor" -- inherited from gnss-probe's own Port, see its own
    docstring): every path below that opens a port closes it exactly once,
    in the single `finally` at the bottom, never both there and inline.

    port_factory defaults to the real Port; --selftest injects a fake one
    for the check that drives an interrupt through this function's own
    composition (not a separately factored copy of it) without hardware or
    root.
    """
    try:
        args = parse_args(argv)
    except SystemExit as exc:
        # argparse's own usage-error (2) and --help (0) exits, converted to
        # a plain returned int rather than left to propagate: main(argv) ->
        # int is a real contract here, not just the common case, so a
        # caller (or --selftest, driving main() in-process) never has to
        # catch SystemExit to find out what a bad argv did.
        return exc.code if isinstance(exc.code, int) else EXIT_NO_PORT

    if args.selftest:
        return selftest()

    args.device = args.device or device_from_gpsd_defaults() or DEFAULT_DEVICE

    spec = CLI_DISPATCH.get(args.command) if args.command else None

    if spec is not None and not spec.needs_port:
        return spec.fn(args)

    if not args.no_service_control and os.geteuid() != 0:
        print("gnssctl: need root to stop gpsd and open %s" % args.device,
              file=sys.stderr)
        print("  run with sudo, or use --no-service-control if gpsd is "
              "already stopped", file=sys.stderr)
        return EXIT_NO_PORT

    if not os.path.exists(args.device):
        print("gnssctl: %s does not exist" % args.device, file=sys.stderr)
        return EXIT_NO_PORT

    guard = ServiceGuard(enabled=not args.no_service_control)
    signal.signal(signal.SIGTERM, lambda signum, frame: _on_interrupt(guard))

    try:
        with guard:
            port = None
            try:
                port, obs = _open_with_baud_detection(
                    args.device, args.baud, OBSERVE_SECONDS,
                    port_factory=port_factory)
                if port is None:
                    bauds = [args.baud] if args.baud else list(BAUD_CANDIDATES)
                    print("gnssctl: no recognisable data at %s" %
                          " or ".join(str(b) for b in bauds), file=sys.stderr)
                    holders = port_holder(args.device)
                    if holders:
                        print("  held by: %s" % ", ".join(holders),
                              file=sys.stderr)
                    return EXIT_NO_FRAMING

                if spec is None:
                    session = Session(port, allow_apply=True)
                    return repl(session, args)
                return spec.fn(port, args)
            except OSError as exc:
                print("gnssctl: cannot open %s: %s" % (args.device, exc),
                      file=sys.stderr)
                holders = port_holder(args.device)
                if holders:
                    print("  still held by: %s" % ", ".join(holders),
                          file=sys.stderr)
                return EXIT_NO_PORT
            finally:
                if port is not None:
                    port.close()
    except KeyboardInterrupt:
        # Also covers an interrupt raised inside ServiceGuard.__enter__
        # itself, which `with guard:`'s own exception handling cannot --
        # see the __enter__-blocks-for-a-second-or-two paragraph above.
        # guard.restore() is idempotent (its own _armed gate), so calling
        # it here is a no-op on the (more common) path where __exit__
        # already ran it while this exception was propagating out of the
        # `with` statement, and the one thing that actually restores gpsd
        # on the path where __exit__ never ran at all.
        print("")
        guard.restore()
        return EXIT_INTERRUPTED


def check(name, fn):
    """Record one assertion.

    Takes a thunk rather than a value on purpose. A check written before the
    function it exercises exists must report FAIL and let the rest of the suite
    run -- evaluating eagerly would raise NameError and abort the whole file,
    which makes red-green cycles impossible in a single-file script.
    """
    try:
        ok = bool(fn())
    except Exception as exc:
        print("  FAIL %s [%s: %s]" % (name, type(exc).__name__, exc))
        _FAILS.append(name)
        return
    print(("  ok   " if ok else "  FAIL ") + name)
    if not ok:
        _FAILS.append(name)


def _raises(fn, expect=Exception):
    """True if fn() raised `expect`.

    NameError and AttributeError are re-raised rather than swallowed: those mean
    the check itself is broken -- a renamed or missing symbol -- and a safety
    assertion that passes because its subject vanished is worse than no
    assertion at all. Several of the checks below use this to assert that a
    write is refused.
    """
    try:
        fn()
    except (NameError, AttributeError):
        raise
    except expect:
        return True
    return False


def _write_sites():
    """Names of every function in this file that can call something's write().

    Read from the module's own syntax tree, because the property being asserted
    is "only these functions transmit" and a blacklist of method names asserts a
    naming convention instead. A Session.emit(cls, mid, body) passes any list of
    forbidden names and any search for the word "payload", and still puts a
    caller's bytes on the wire; it fails this.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    out = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef):
            continue
        for inner in ast.walk(node):
            if (isinstance(inner, ast.Call)
                    and isinstance(inner.func, ast.Attribute)
                    and inner.func.attr == "write"):
                out.add(node.name)
    return out


def _uses_apply():
    """Names of every function in this file that can call something's apply(.

    Same AST-walk approach as _write_sites, turned on Session.apply instead
    of write(): used to confirm cmd_show/cmd_monitor/cmd_bandwidth -- all
    three declared read-only in the design -- never reach it, the one path
    that can put a Change on the wire.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    out = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef):
            continue
        for inner in ast.walk(node):
            if (isinstance(inner, ast.Call)
                    and isinstance(inner.func, ast.Attribute)
                    and inner.func.attr == "apply"):
                out.add(node.name)
    return out


def _reaches(func_name, attrs):
    """True if the top-level function `func_name` calls obj.<attr>(...) for
    any attr in `attrs`.

    AST-based rather than a source-text search over inspect.getsource(): this
    file's own docstrings explain, in prose, exactly which of these
    cmd_bandwidth does NOT call (to justify why it sends nothing) -- a
    substring search would match that explanation and pass whether or not the
    code agrees with it.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == func_name:
            return any(isinstance(inner, ast.Call)
                      and isinstance(inner.func, ast.Attribute)
                      and inner.func.attr in attrs
                      for inner in ast.walk(node))
    return False


def _session_calls(func_name):
    """The keyword args of every Session(...) call inside the top-level
    function `func_name`, as {arg: constant value} dicts.

    AST-based for the same reason _reaches is: read-only-ness has to be
    checked from the call itself, not from a docstring's prose about it.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    out = []
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == func_name:
            for inner in ast.walk(node):
                if (isinstance(inner, ast.Call)
                        and isinstance(inner.func, ast.Name)
                        and inner.func.id == "Session"):
                    out.append({kw.arg: getattr(kw.value, "value", None)
                               for kw in inner.keywords})
    return out


def _all_subclasses(cls):
    """Every subclass of cls, however deeply nested.

    Recursive because apply() gates on isinstance, which is: a subclass of a
    subclass is accepted there, so the closed-set check has to see it too.
    __subclasses__() alone reports only direct children.
    """
    out = set()
    for sub in cls.__subclasses__():
        out.add(sub)
        out |= _all_subclasses(sub)
    return out


def _sky(counts, sats):
    """An observation stated directly, so inference can be checked off a wire.

    Injects the GSV records rather than restating how sats_in_view and
    constellations are derived, so the check exercises the real derivation.
    """
    obs = Observation(9600)
    obs.nmea_counts = dict(counts)
    obs._nmea.records["GSV"] = {t: {"totalNumSat": n} for t, n in sats.items()}
    return obs


# The wire window the fake-port checks run with. They assert ordering, refusal
# and classification, none of which depends on how long the window is: the fake
# port hands over its whole reply on the first read, so the rest of a real
# 1.5 s window would be pure sleep. The production defaults are untouched.
_TEST_WINDOW = 0.05

# One whole epoch of a twelve-satellite GPS sky, and a wire with no GSV on it
# at all -- the two fixtures the apply() checks need, since "what the sky is"
# and "whether the sky can be seen" are what the bandwidth guard turns on.
_EPOCH = (nmea_wrap("GPGSV,3,1,12,02,49,123,43,0")
          + nmea_wrap("GPGSV,3,2,12,05,60,005,43,0")
          + nmea_wrap("GPGSV,3,3,12,06,06,127,29,0")
          + nmea_wrap("GNGSA,A,3,10,13,15,20,,,,,,,,,2.5,2.0,1.5,1"))
_NO_GSV = nmea_wrap("GNRMC,071556.000,A,3149.29103,N,11706.92916,E,"
                    "0.00,0.00,250420,,,A,V")


class _FakePort:
    """A quiet port that records what was written to it. Not hardware.

    Enough of Port's surface for the checks that exercise apply()'s ordering:
    what matters there is what reaches write(), and for a refusal that nothing
    does. read() sleeps rather than returning immediately, because a real port
    blocks and a busy spin would burn a core for the length of every window.

    fail_write, when set, is raised by every write() call instead of
    recording one -- for the init checks that need to prove a write failure
    still leaves the port at the right speed (Port.write's own real failure
    mode is an OSError from the underlying os.write/tcdrain, which this
    stands in for without a real, failing fd).
    """

    def __init__(self, baud=9600, data=b"", fail_write=None):
        self.baud = baud
        self.writes = []
        self._data = data
        self._fail_write = fail_write
        # Not read by any check that predates this one -- added for
        # _open_with_baud_detection's own checks, which need to see that a
        # candidate that recognised nothing was closed before the next
        # candidate was tried, and that the WINNING one was not.
        self.closed = False

    def read(self, timeout):
        if self._data:
            out, self._data = self._data, b""
            return out
        time.sleep(timeout)
        return b""

    def write(self, data):
        if self._fail_write is not None:
            raise self._fail_write
        self.writes.append(data)

    def flush_input(self):
        pass

    def set_baud(self, baud):
        self.baud = baud

    def close(self):
        self.closed = True

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False


class _QuietThenInterrupt:
    """A port that answers `iterations` reads with nothing, then raises
    KeyboardInterrupt -- the only way to end cmd_monitor's own `while True`
    loop, so this drives a couple of REAL redraw cycles through cmd_monitor
    itself rather than only its call graph.

    Exists for exactly one gap: _reaches()/_session_calls() inspect
    cmd_monitor's own AST body, which no longer contains a live-session
    render_show call -- but they cannot see what render_show ITSELF does
    with whatever cmd_monitor hands it. Only actually running the loop and
    checking what reached write() closes that.
    """

    def __init__(self, iterations=3):
        self.baud = 9600
        self.path = "/dev/fake"
        self.writes = []
        self._left = iterations

    def read(self, timeout):
        if self._left <= 0:
            raise KeyboardInterrupt
        self._left -= 1
        # Paces itself against the SAME wall-clock budget _read_window checks
        # (like _FakePort's own read()) rather than returning instantly: an
        # instant return lets _read_window's while loop busy-spin through its
        # whole window in a handful of Python instructions, exhausting
        # `iterations` in one call before any real time (or a second read())
        # happens, and this port's whole purpose -- driving a fixed, known
        # number of real read() calls -- depends on that not happening.
        time.sleep(timeout)
        return b""

    def write(self, data):
        self.writes.append(data)

    def flush_input(self):
        pass


class _Args:
    """A bare attribute bag, standing in for argparse's Namespace so cmd_*
    functions can be driven in --selftest without argparse in the loop.
    """

    def __init__(self, **kw):
        self.__dict__.update(kw)


def _apply_on_quiet_port(change, sky=None, **kw):
    """(port, verdict) for one apply() against a port showing `sky`.

    The default is a WHOLE epoch, not a sample of one: twelve GPS satellites
    take three GSV sentences to report (§2.2.3, four per transmission), so a
    single one would correctly infer "GSV every third fix" and price the stream
    at a third of what it costs. The budget must be refusing real traffic here,
    not an artefact of the fixture.
    """
    port = _FakePort(9600, _EPOCH if sky is None else sky)
    return port, Session(port, allow_apply=True, timeout=_TEST_WINDOW,
                         observe=_TEST_WINDOW).apply(change, **kw)


def _breaking_readback(change, exc):
    """Give one Change instance a readback that fails.

    Patched onto the instance rather than subclassed: a sixth Change subclass
    would break the closed-set assertion, which is a property worth more than
    the convenience.
    """
    def confirm(session):
        raise exc
    change.confirm = confirm
    return change


def _poll_on_quiet_port(n, data):
    """(port, result) for one poll against a port that answers once, then quiets.

    On a read-only session, which is where a poll belongs. The read window runs
    its course rather than stopping at the first answer -- silence and an answer
    cost the same -- which is why these run on a shortened one.
    """
    port = _FakePort(9600, data)
    return port, Session(port, timeout=_TEST_WINDOW).poll(n)


def _probe_session():
    return Session(None, allow_apply=False)


def _dispatch_capture(verb, rest, data=b""):
    """(port, session, stdout) from one DISPATCH call against a fake port --
    what "the REPL dispatches through the one session it was given" actually
    produces, without a terminal or hardware. allow_apply=True: this is the
    session shape repl() itself builds, not the read-only one cmd_show et al
    use for the one-shot path.
    """
    import io          # only used here, and this is the only caller
    import contextlib  # only used here, and this is the only caller
    port = _FakePort(9600, data)
    session = Session(port, allow_apply=True, timeout=_TEST_WINDOW,
                      observe=_TEST_WINDOW)
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        DISPATCH[verb](session, rest)
    return port, session, out.getvalue()


def _dispatch_error(verb, rest):
    """The message a DISPATCH handler raises for `rest`, or None if it did
    not raise -- lets a check assert on the TEXT of a refusal (a spec
    citation, or this file's own parsing complaint) rather than only that
    something was raised.
    """
    session = Session(_FakePort(9600), allow_apply=True, timeout=_TEST_WINDOW,
                      observe=_TEST_WINDOW)
    try:
        DISPATCH[verb](session, rest)
    except ValueError as exc:
        return str(exc)
    return None


def _scan(framing, *chunks):
    sc = Scanner(framing)
    for chunk in chunks:
        sc.feed(chunk)
    return sc.take()


def _collect(data, keep=40):
    nc = NmeaCollector(keep=keep)
    nc.feed(data)
    return nc


def _observe(data):
    obs = Observation(115200)
    obs.absorb(data)
    return obs


def _complete(prefix):
    """Every completion `completer` offers for `prefix`, in readline's own
    state-index protocol (state 0, 1, 2, ... until None) rather than by
    reaching into COMMANDS directly -- this is what --selftest can exercise
    without a real terminal or readline itself being importable.
    """
    out = []
    i = 0
    while True:
        got = completer(prefix, i)
        if got is None:
            return out
        out.append(got)
        i += 1


# Two canned CFG-PRT readbacks for the init checks below -- one at the speed
# init is trying to reach, one that answered but did not actually move.
# Baud is written literally (not via INIT_BAUD) so these stay evaluable at
# import time regardless of where that constant is declared.
_PRT_AT_INIT_BAUD = CASIC.encode(*CFG_PRT.key,
                                 CFG_PRT.build(portID=1, protoMask=0x07,
                                              mode=0x08C0, baudRate=115200))
_PRT_AT_WRONG_BAUD = CASIC.encode(*CFG_PRT.key,
                                  CFG_PRT.build(portID=1, protoMask=0x07,
                                               mode=0x08C0, baudRate=9600))

# The three frames _init_sequence's own checks below assert an exact order
# for. Built from the same declared tables init itself uses (PCAS01/PCAS02/
# CFG_PRT), not restated as separate literals, so a change to the wire
# encoding cannot drift the fixture and the assertion apart. Baud/interval
# are literal (not INIT_BAUD/INIT_INTERVAL_MS) for the same import-time
# reason as the readbacks above.
_INIT_SPEED = nmea_wrap(PCAS01.build(cmd=BAUD_CODE[115200]))
_INIT_RATE = nmea_wrap(PCAS02.build(interval=200))
_INIT_CFG_PRT_POLL = CASIC.encode(*CFG_PRT.key)

_INIT_WRITES_CACHE = {}


def _init_run(reply=b"", deadline=None):
    """(port.writes, port.baud) after one _init_sequence run against a
    fresh _FakePort that answers every read with `reply` (default: silence).

    Both, not just the writes: the port's final speed is exactly what a
    fix round found nothing here was asserting -- _init_writes(deadline=an
    already-expired one) == [] passed while _init_sequence left the port at
    9600, because nothing looked at .baud. _init_writes/_init_baud below
    both read this same tuple so that mistake can't recur by only checking
    one half of it.

    Memoized per (reply, deadline): several checks below ask different
    questions about the same run rather than each driving their own, and
    the CFG-PRT readback's own read window is real wall-clock time even
    against a fake port.
    """
    key = (reply, deadline)
    if key not in _INIT_WRITES_CACHE:
        port = _FakePort(9600, reply)
        dl = time.monotonic() + 5.0 if deadline is None else deadline
        _init_sequence(port, dl)
        _INIT_WRITES_CACHE[key] = (port.writes, port.baud)
    return _INIT_WRITES_CACHE[key]


def _init_writes(reply=b"", deadline=None):
    return _init_run(reply, deadline)[0]


def _init_baud(reply=b"", deadline=None):
    return _init_run(reply, deadline)[1]


def _init_mid_loop():
    """(writes, baud) when the deadline expires between the two candidate
    sends, i.e. after 9600's but before 115200's.

    A real deadline a fraction of a second out cannot reliably land in that
    gap against a fake port with no artificial per-write delay -- that would
    be a race, not a test, and adding a delay to _FakePort.write() itself
    would slow down every other check that uses it. time.monotonic is
    stubbed for the scope of this one _init_sequence call instead, so the
    boundary is exact: not-yet-expired for the loop's first deadline check,
    expired for every one after.
    """
    port = _FakePort(9600, b"")
    real_monotonic = time.monotonic
    calls = [0]

    def fake_monotonic():
        calls[0] += 1
        return 0.0 if calls[0] == 1 else 1000.0

    time.monotonic = fake_monotonic
    try:
        _init_sequence(port, 0.5)
    finally:
        time.monotonic = real_monotonic
    return port.writes, port.baud


def _init_on_write_failure():
    """(writes, baud) when port.write raises on every call.

    Proof the `finally` in _init_sequence runs on an exception exit the
    same as a normal one. _init_sequence does not catch this itself --
    cmd_init does, the same as any other hardware failure -- so this
    catches what cmd_init would, to get at what the finally left behind.
    """
    port = _FakePort(9600, b"", fail_write=OSError(5, "Input/output error"))
    try:
        _init_sequence(port, time.monotonic() + 5.0)
    except OSError:
        pass
    return port.writes, port.baud


def _init_args(device="/dev/fake", timeout=10.0):
    return _Args(device=device, timeout=timeout)


def _usage(*args):
    """The --help text parse_args(...) prints for a given (sub)command path,
    captured rather than let reach the real stdout/stderr -- e.g. _usage()
    for the top-level --help, _usage("set", "baud") for 'set baud --help'.
    Exists so the checks below can assert on real argparse output (every
    subcommand name, every baud choice) instead of restating what the tree
    is supposed to contain as a second, driftable list.
    """
    import io
    import contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        try:
            parse_args(list(args) + ["--help"] if args else ["--help"])
        except SystemExit:
            pass
    return buf.getvalue()


def _main_as_nonroot(argv):
    """main(argv), with os.geteuid() made to look non-root for the
    duration of the call -- deterministic regardless of who actually runs
    --selftest (root or not, e.g. under sudo or some CI containers), for
    the checks below that assert what happens WITHOUT root. Reverted in a
    finally so a failure mid-call cannot leave the real os.geteuid patched.
    """
    real = os.geteuid
    os.geteuid = lambda: 1000
    try:
        return main(argv)
    finally:
        os.geteuid = real


def _cmd_set_capture(**kw):
    """(exit_code, stdout, port) from one cmd_set call against a fresh,
    quiet _FakePort -- lets a check assert on the Verdict's own printed
    status (NAK/OK/REFUSED/UNCONFIRMED), not just the exit code: several
    different Verdict.status values map to the same EXIT_OK, so an
    exit-code-only check cannot tell a nak from an unconfirmed from an
    outright ok. The port is returned too, for checks that also want a
    side effect like the re-clocked baud. _TEST_WINDOW is applied
    automatically -- see cmd_set's own docstring for the timeout/
    observe_seconds escape hatch this uses.
    """
    import io          # only used here, and this is the only caller
    import contextlib  # only used here, and this is the only caller
    port = _FakePort(9600, b"")
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        code = cmd_set(port, _Args(timeout=_TEST_WINDOW,
                                   observe_seconds=_TEST_WINDOW, **kw))
    return code, out.getvalue(), port


def _baud_fake_factory(recognisable_at, calls=None):
    """A port_factory for _open_with_baud_detection: a real Port's
    constructor takes (path, baud) and opens hardware; this ignores the
    path and returns a _FakePort instead, carrying wire bytes (a whole GSV
    epoch, so Observation.recognised is genuinely true, not a fluke of a
    truncated sentence) only at the baud(s) named in `recognisable_at`.
    `calls`, when given, records every baud tried, in order -- what the
    checks below use to confirm auto-detection tries BAUD_CANDIDATES in
    order and a forced --baud skips the loop rather than merely returning
    the right answer by coincidence.
    """
    def factory(device, baud):
        if calls is not None:
            calls.append(baud)
        return _FakePort(baud, _EPOCH if baud in recognisable_at else b"")
    return factory


class _FakeGuard:
    """Stands in for ServiceGuard in _on_interrupt's own check: records
    whether .restore() was called, without touching systemctl or a real
    unit.
    """

    def __init__(self):
        self.restored = False

    def restore(self):
        self.restored = True


def _interrupt_exit_code(guard):
    """The SystemExit code _on_interrupt(guard) raises."""
    try:
        _on_interrupt(guard)
    except SystemExit as exc:
        return exc.code
    return None


def _guard_interrupted_stop():
    """The units ServiceGuard.restore() starts back up after a ServiceGuard
    whose FIRST stop call raises (a stand-in for a SIGINT/SIGTERM landing
    mid-__enter__, which _on_interrupt's real call to guard.restore() would
    see the same way: __enter__ never reaches its own `self._armed = True`
    line if that line still ran only after the stop loop).

    This is the check that pins the arming-order fix: __enter__ now arms
    BEFORE the stop loop runs, so restore() -- called here directly, since
    the raised OSError means __exit__ is never reached either -- still does
    its job even though __enter__ itself never returned normally. Before
    the fix, restore() would have no-op'd (_armed still False), silently
    leaving both units down.

    systemctl is a plain module-level name, patched here (not passed as a
    parameter -- ServiceGuard's own methods call it unparameterised) and
    restored in a finally so no other check can observe the patch.
    """
    global systemctl
    real_systemctl = systemctl
    calls = []

    class _Result:
        returncode = 0

    def fake(*args):
        calls.append(args)
        if args[0] == "is-active":
            return _Result()  # both units report active
        if args[0] == "stop":
            raise OSError(5, "Input/output error")
        return None

    systemctl = fake
    guard = ServiceGuard(enabled=True)
    try:
        try:
            guard.__enter__()
        except OSError:
            pass
        guard.restore()
    finally:
        systemctl = real_systemctl
    return [c[1] for c in calls if c[0] == "start"]


def _guard_enter_interrupted():
    """(units started again, main()'s exit code) when a KeyboardInterrupt
    lands inside ServiceGuard.__enter__'s own settle sleep, driven through
    main() itself.

    Distinct from _guard_interrupted_stop above: that one interrupts the
    STOP call and asserts on ServiceGuard.restore() directly, which is
    enough to pin round 1's arming-order fix but not this one. This drives
    an interrupt through the __enter__ call THAT with guard: ITSELF makes,
    inside main() -- because Python does not call __exit__ when __enter__
    raises, `with guard: ... except KeyboardInterrupt:` (the body only)
    never reaches restore() on this path at all, whether or not
    __enter__'s own arming order is correct. Only a catch OUTSIDE `with
    guard:` can. _main_interrupted's own systemctl fake reports both units
    INACTIVE specifically so __enter__ returns immediately and never blocks
    -- it exists to test a different escape point (baud auto-detection)
    and would sidestep this window entirely, which is exactly why it did
    not catch the regression this pins. Here, systemctl reports both units
    ACTIVE, so __enter__ takes its stop-then-sleep branch, and time.sleep
    itself is faked to raise instead of blocking -- the settle sleep is
    the one and only time.sleep call reached before main()'s own dispatch
    would begin, so a blanket patch lands exactly there without needing to
    distinguish it from any other sleep in the file.
    """
    global systemctl
    real_systemctl = systemctl
    real_geteuid = os.geteuid
    real_sleep = time.sleep

    class _Result:
        returncode = 0  # "active" -- both units, so __enter__ takes the
                        # stop-then-sleep branch, not the immediate return

    calls = []

    def fake_systemctl(*args):
        calls.append(args)
        if args[0] == "is-active":
            return _Result()
        return None

    def fake_sleep(seconds):
        raise KeyboardInterrupt

    systemctl = fake_systemctl
    os.geteuid = lambda: 0
    time.sleep = fake_sleep
    try:
        code = main([os.devnull, "show"],
                   port_factory=_interrupting_port_factory)
    except KeyboardInterrupt:
        # Same defensive wrapping as _main_interrupted/_init_interrupted:
        # an escaping interrupt would otherwise crash --selftest instead
        # of reporting one clean FAIL, since check()'s `except Exception`
        # cannot catch a BaseException sibling.
        code = "escaped uncaught"
    finally:
        systemctl = real_systemctl
        os.geteuid = real_geteuid
        time.sleep = real_sleep
    started = sorted(c[1] for c in calls if c[0] == "start")
    return started, code


def _signals_installed(func_name):
    """The set of signal.SIGXXX names `func_name`'s own body passes to
    signal.signal(...), read from the module's own syntax tree -- same
    AST-walk approach as _write_sites/_uses_apply/_session_calls. Pins
    that main() installs a handler for SIGTERM only, leaving SIGINT at
    Python's own default (which raises KeyboardInterrupt) so repl()'s and
    _monitor_loop's own, narrower handlers get first refusal at it -- see
    main()'s own docstring for why installing one for SIGINT too would
    silently break both.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == func_name:
            out = set()
            for inner in ast.walk(node):
                if (isinstance(inner, ast.Call)
                        and isinstance(inner.func, ast.Attribute)
                        and inner.func.attr == "signal"
                        and isinstance(inner.func.value, ast.Name)
                        and inner.func.value.id == "signal"
                        and inner.args
                        and isinstance(inner.args[0], ast.Attribute)):
                    out.add(inner.args[0].attr)
            return out
    return set()


def _interrupting_port_factory(device, baud):
    """A port_factory that raises KeyboardInterrupt instead of returning
    anything -- a stand-in for a real Ctrl-C/SIGTERM landing exactly as
    _open_with_baud_detection is about to open the port, before repl() or
    _monitor_loop even start. Neither of their own, narrower handling can
    be what catches this one -- only main()'s own outer `except
    KeyboardInterrupt` can, which is the property this exists to drive.
    """
    raise KeyboardInterrupt


def _main_interrupted(argv):
    """main(argv, port_factory=_interrupting_port_factory), with
    os.geteuid() made to look like root -- so main()'s own root check
    passes and ServiceGuard actually runs, rather than being skipped by
    --no-service-control, which would make "the guard's own __exit__ still
    running" trivially true for the wrong reason -- and systemctl patched
    to report both gpsd units inactive, so ServiceGuard's real
    __enter__/restore execute for real but touch no actual systemd. For
    the check that drives a KeyboardInterrupt through main()'s own
    composition end to end, not a separately factored copy of its logic,
    without hardware or real root.

    Catches a KeyboardInterrupt that escapes main() entirely and returns
    the string "escaped uncaught" instead of letting it propagate -- same
    reason _interrupt_exit_code catches _on_interrupt's SystemExit rather
    than letting the check's own comparison see it: check()'s `except
    Exception` does not catch a BaseException sibling like this one, so an
    actually-broken main() would otherwise crash the whole --selftest run
    instead of reporting one clean FAIL. Confirmed by deliberately
    reverting main()'s own fix in a scratch copy and re-running: without
    this, the same regression that print("") + "return EXIT_INTERRUPTED"
    normally converts to a clean 130 instead aborts --selftest mid-run
    with an uncaught KeyboardInterrupt traceback.
    """
    global systemctl
    real_systemctl = systemctl
    real_geteuid = os.geteuid

    class _Result:
        returncode = 1  # "not active" -- nothing for ServiceGuard to stop

    def fake_systemctl(*args):
        if args[0] == "is-active":
            return _Result()
        return None

    systemctl = fake_systemctl
    os.geteuid = lambda: 0
    try:
        return main(argv, port_factory=_interrupting_port_factory)
    except KeyboardInterrupt:
        return "escaped uncaught"
    finally:
        systemctl = real_systemctl
        os.geteuid = real_geteuid


def _init_interrupted():
    """(result, port.baud, port.closed) from cmd_init when a write inside
    _init_sequence raises KeyboardInterrupt -- a stand-in for a SIGINT (or,
    via cmd_init's own SIGTERM-to-KeyboardInterrupt handler, a SIGTERM)
    landing mid-sequence.

    Pins cmd_init's own `except BaseException` -- `except Exception` does
    not catch KeyboardInterrupt, a BaseException sibling, not one of
    Exception's subclasses -- so before that fix this would have propagated
    straight out of cmd_init, and out of ExecStartPre non-zero: the one
    outcome cmd_init's whole existence is meant to prevent. The port ending
    at INIT_BAUD is _init_sequence's own `finally`, unrelated to this fix
    and unchanged by it -- checked here too because interrupting mid-write
    is exactly the scenario that finally exists for.

    Catches a KeyboardInterrupt that escapes cmd_init entirely and returns
    "escaped uncaught" for the whole tuple, rather than letting it
    propagate -- same reason _main_interrupted does: check()'s own
    `except Exception` cannot catch a BaseException sibling, so an
    actually-broken cmd_init would otherwise crash --selftest instead of
    reporting one clean FAIL. Confirmed by deliberately reverting cmd_init's
    fix in a scratch copy: without this, the same regression aborts
    --selftest mid-run with an uncaught KeyboardInterrupt traceback instead
    of a clean FAIL line.
    """
    made = []

    def factory(device, baud):
        port = _FakePort(baud, b"", fail_write=KeyboardInterrupt())
        made.append(port)
        return port

    import io          # only used here, and this is the only caller
    import contextlib  # only used here, and this is the only caller
    err = io.StringIO()
    try:
        with contextlib.redirect_stderr(err):
            # os.devnull, not an arbitrary made-up path: cmd_init's own
            # first line is `if not os.path.exists(args.device): return 0`,
            # so the device given here has to genuinely exist -- os.devnull
            # always does, on every platform, without touching real
            # hardware.
            result = cmd_init(_Args(device=os.devnull, timeout=5.0),
                              port_factory=factory)
    except KeyboardInterrupt:
        return "escaped uncaught", "escaped uncaught", "escaped uncaught"
    return result, made[0].baud, made[0].closed


def _repl_survives_interrupt():
    """(repl()'s return value, number of input() calls it made) when the
    FIRST prompt read raises KeyboardInterrupt and the SECOND raises
    EOFError -- proof that repl()'s own `except KeyboardInterrupt:
    print(""); continue` (see repl()'s own body) is what a Ctrl-C at the
    prompt does: the loop keeps running (a second input() call happens at
    all, rather than the exception propagating out) and then exits cleanly
    once it is actually told to (EOFError, i.e. Ctrl-D).

    This is the property main()'s own SIGINT-handling composition depends
    on: SIGINT is deliberately left at Python's own default specifically so
    repl() (and _monitor_loop) see the KeyboardInterrupt themselves, before
    anything in main() would -- see main()'s own docstring and
    _signals_installed's check.

    Patches builtins.input (repl()'s only blocking read), atexit.register
    (so repl()'s own history-save callback is never actually registered
    with the real atexit machinery -- left alone, it would leak into this
    process's real shutdown and write to the real HISTFILE) and
    readline.read_history_file/write_history_file (so no real file under
    ~/.gnssctl_history is touched either way), all reverted in a finally.
    Nothing else about repl() is faked -- readline itself is the real
    module, and DISPATCH is never reached because the loop never gets a
    real command line to hand it.
    """
    import builtins
    import readline as rl
    import io          # only used here, and this is the only caller
    import contextlib  # only used here, and this is the only caller

    calls = {"n": 0}

    def fake_input(prompt):
        calls["n"] += 1
        if calls["n"] == 1:
            raise KeyboardInterrupt
        if calls["n"] == 2:
            raise EOFError
        raise AssertionError("repl() read a third line; it should have "
                             "exited on the EOFError above")

    real_input = builtins.input
    real_register = atexit.register
    real_read_hist = rl.read_history_file
    real_write_hist = rl.write_history_file
    builtins.input = fake_input
    atexit.register = lambda *a, **kw: None
    rl.read_history_file = lambda *a, **kw: None
    rl.write_history_file = lambda *a, **kw: None
    try:
        port = _FakePort(9600, b"")
        port.path = "/dev/fake"
        session = Session(port, allow_apply=True, timeout=_TEST_WINDOW,
                          observe=_TEST_WINDOW)
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            result = repl(session, _Args())
    finally:
        builtins.input = real_input
        atexit.register = real_register
        rl.read_history_file = real_read_hist
        rl.write_history_file = real_write_hist
    return result, calls["n"]


def selftest():
