class NmeaCollector:
    """Tallies and parses NMEA sentences seen on the wire."""

    def __init__(self, keep=40):
        self.buf = bytearray()
        self.counts = {}
        self.lines = []
        self.records = {}
        # Per-talker satellite table, accumulated across a GSV group's parts
        # rather than overwritten like `records` above -- see _absorb_sky.
        self.sky = {}
        # Per talker: has this talker's CURRENT group seen its own <SenNum>
        # 1 line yet? Tracked separately from `sky` itself so a group whose
        # first line was dropped can be told apart from one in progress --
        # see _absorb_sky.
        self._sky_started = {}
        self.bad_checksums = 0
        self.keep = keep

    def feed(self, data):
        self.buf.extend(data)
        while True:
            i = self.buf.find(b"\n")
            if i < 0:
                if len(self.buf) > 1024:
                    del self.buf[:-1024]
                return
            raw = bytes(self.buf[:i])
            del self.buf[:i + 1]
            # Resync to the last '$' rather than assuming the sentence starts at
            # the head of the buffer. Binary frames and NMEA share this wire and
            # binary payloads contain no newline, so whatever binary arrived
            # before a sentence is still sitting in front of it. rfind, not
            # find: a sentence carries one '$', but preceding binary may contain
            # 0x24 bytes.
            start = raw.rfind(b"$")
            if start < 0:
                continue
            text = raw[start:].decode("ascii", "replace").strip()
            body, ok = nmea_split(text)
            if body is None:
                continue
            if not ok:
                self.bad_checksums += 1
                continue
            tag = body.split(",")[0]
            self.counts[tag] = self.counts.get(tag, 0) + 1
            if len(self.lines) < self.keep:
                self.lines.append(text)
            name = tag[2:] if len(tag) == 5 and not tag.startswith("P") else tag
            sentence = STANDARD_SENTENCES.get(name)
            if sentence is not None:
                # Live serial data contains truncated sentences routinely --
                # a partial read, line noise, a receiver mid-reconfiguration --
                # and Sentence.parse() now raises on one rather than guessing
                # (see GSV's repeat-block check). One malformed sentence must
                # not abort the read loop, so this is load-bearing, not
                # defensive boilerplate.
                try:
                    rec = sentence.parse(body)
                except Exception:
                    pass
                else:
                    self.records.setdefault(name, {})[tag[:2]] = rec
                    self._absorb_sky(tag[:2], rec)

    def _absorb_sky(self, talker, rec):
        """Merge one sentence's per-satellite rows into the running sky table.

        Detected structurally -- a "sats" repeat block whose rows are
        per-satellite detail dicts -- rather than by matching the sentence's
        name: GSA also declares a "sats" repeat block (§2.2.4), but with a
        single field, so Sentence.parse's own repeat-block handling stores
        its rows as plain satellite IDs, not dicts. Only GSV's shape (four
        fields per row) qualifies.

        A GSV sky is reported across up to four sentences (<TotalNumSen>,
        §2.2.3), each carrying at most four satellites; `records` above keeps
        only the LAST one per talker, so reading it for a sky table would show
        at most four satellites no matter how many are actually in view. This
        accumulates across the group instead.

        Starts a fresh table on <SenNum> 1 -- the group's first line -- same
        as when a talker is seen for the very first time: the guarantee this
        exists for is "a table missing its first line comes up a satellite
        short, never two epochs mixed together", and that has to hold in the
        MIDDLE of a session too, not only at start-up. A truncated sentence is
        routine (NmeaCollector.feed's own try/except exists because of it), so
        a group's <SenNum> 1 line going missing mid-session is not a corner
        case: without _sky_started tracking this, the next line seen for that
        talker (<SenNum> 2 or 3) would merge onto whatever the PREVIOUS,
        now-stale, completed group left behind -- which is exactly the mixing
        the docstring used to claim could not happen. So a non-1 line arriving
        for a talker that has not seen its own group's <SenNum> 1 clears the
        stale table first, then contributes only its own rows: a satellite
        short (or, worst case, only what one line reports), never stale ones
        lingering indistinguishable from current ones.
        """
        sats = rec.get("sats")
        if not sats or not isinstance(sats[0], dict) or "satID" not in sats[0]:
            return
        sen_num = rec.get("senNum")
        if sen_num == 1 or not self._sky_started.get(talker):
            self.sky[talker] = {}
            self._sky_started[talker] = True
        bucket = self.sky.setdefault(talker, {})
        for row in sats:
            if row.get("satID"):
                bucket[row["satID"]] = row
        total = rec.get("totalNumSen")
        if sen_num is not None and total is not None and sen_num >= total:
            # Group complete (or this line claims to be the last one it will
            # see) -- ready for the next group to require its own <SenNum> 1
            # again, rather than silently accepting whatever arrives next as
            # a continuation of this one.
            self._sky_started[talker] = False

    def take_lines(self):
        out, self.lines = self.lines, []
        return out


class Observation:
    def __init__(self, baud):
        self.baud = baud
        self.sync_hits = {}
        self.valid_frames = {}
        self.frame_ids = {}
        self.nmea_counts = {}
        self.nmea_sample = []
        self.raw_bytes = 0
        self.raw_head = b""
        self._scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS}
        self._nmea = NmeaCollector()

    def absorb(self, data):
        self.raw_bytes += len(data)
        if len(self.raw_head) < 512:
            self.raw_head += data[:512 - len(self.raw_head)]
        self._nmea.feed(data)
        for sc in self._scanners.values():
            sc.feed(data)
        self.finish()
        return self

    def finish(self):
        for name, sc in self._scanners.items():
            self.sync_hits[name] = sc.sync_hits
            ids = self.frame_ids.setdefault(name, {})
            for fr in sc.take():
                self.valid_frames[name] = self.valid_frames.get(name, 0) + 1
                k = "%02x-%02x" % (fr.cls, fr.mid)
                ids[k] = ids.get(k, 0) + 1
        self.nmea_counts = dict(self._nmea.counts)
        self.nmea_sample = self._nmea.lines[:10]

    @property
    def recognised(self):
        return bool(self.nmea_counts) or any(self.valid_frames.values())

    @property
    def sats_in_view(self):
        """Satellites per GSV talker -- the 'sky now' input to the budget."""
        out = {}
        for talker, rec in (self._nmea.records.get("GSV") or {}).items():
            if rec.get("totalNumSat") is not None:
                out[talker] = rec["totalNumSat"]
        return out

    @property
    def constellations(self):
        seen = {"GP": "GPS", "GL": "GLO", "BD": "BDS"}
        return frozenset(seen[t] for t in self.sats_in_view if t in seen)

    def records(self, name):
        """Parsed sentences of `name`, keyed by talker.

        A general accessor for renderers that need more than sats_in_view/
        constellations above (which only ever look at GSV): render_show wants
        GGA and GSA too. Returns whatever NmeaCollector has kept -- the LAST
        parsed sentence per talker, which is exactly right for a one-line
        fix report like GGA/GSA and exactly wrong for GSV's multi-line
        groups, which is why GSV has its own accumulation (see `sky` below).
        """
        return self._nmea.records.get(name, {})

    @property
    def sky(self):
        """Per-talker satellite table, accumulated across a GSV group.

        Copied out rather than handed back live, so a caller mutating the
        result cannot corrupt NmeaCollector's own bookkeeping.
        """
        return {t: dict(sats) for t, sats in self._nmea.sky.items()}


def listen(port, seconds):
    """Read the device without transmitting anything."""
    obs = Observation(port.baud)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        data = port.read(min(0.5, max(0.05, deadline - time.monotonic())))
        if data:
            obs.absorb(data)
    return obs


def _parse_gpsd_defaults(text):
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("DEVICES="):
            continue
        val = line.split("=", 1)[1].strip().strip('"').strip("'").split()
        if val and val[0].startswith("/dev/"):
            return val[0]
    return None


def device_from_gpsd_defaults():
    try:
        with open(GPSD_DEFAULTS) as fh:
            return _parse_gpsd_defaults(fh.read())
    except OSError:
        return None


class Port:
    """Raw 8N1 access to the serial device at a chosen speed."""

    def __init__(self, path, baud):
        self.path = path
        self.baud = baud
        self.fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        try:
            self.saved = termios.tcgetattr(self.fd)
            self._configure(baud)
        except Exception:
            os.close(self.fd)
            raise

    def _configure(self, baud):
        speed = BAUD_CONST[baud]
        iflag, oflag, cflag, lflag, _, _, cc = termios.tcgetattr(self.fd)
        iflag &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK |
                   termios.ISTRIP | termios.INLCR | termios.IGNCR |
                   termios.ICRNL | termios.IXON)
        oflag &= ~termios.OPOST
        lflag &= ~(termios.ECHO | termios.ECHONL | termios.ICANON |
                   termios.ISIG | termios.IEXTEN)
        cflag &= ~(termios.CSIZE | termios.PARENB | termios.CSTOPB)
        cflag |= termios.CS8 | termios.CLOCAL | termios.CREAD
        cc = list(cc)
        cc[termios.VMIN] = 0
        cc[termios.VTIME] = 0
        termios.tcsetattr(self.fd, termios.TCSANOW,
                          [iflag, oflag, cflag, lflag, speed, speed, cc])
        termios.tcflush(self.fd, termios.TCIOFLUSH)

    def set_baud(self, baud):
        """Re-clock the port in place, so 'set baud' can confirm at the new speed."""
        self._configure(baud)
        self.baud = baud

    def flush_input(self):
        termios.tcflush(self.fd, termios.TCIFLUSH)

    def read(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return b""
        try:
            return os.read(self.fd, 4096)
        except OSError as e:
            if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                return b""
            raise

    def write(self, data):
        os.write(self.fd, data)
        termios.tcdrain(self.fd)

    def close(self):
        try:
            termios.tcsetattr(self.fd, termios.TCSANOW, self.saved)
        except Exception:
            pass
        os.close(self.fd)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False


def systemctl(*args):
    try:
        return subprocess.run(("systemctl",) + args,
                              capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        return None
    except subprocess.TimeoutExpired:
        return None


def unit_active(unit):
    r = systemctl("is-active", "--quiet", unit)
    return bool(r) and r.returncode == 0


class ServiceGuard:
    """Stops gpsd and restores whatever state it found.

    Restores the PRIOR state, not "running": if gpsd was already stopped, it
    stays stopped. Both gpsd.socket and gpsd.service are stopped: gpsd is
    socket-activated, and meshcored reconnects to it with backoff, so
    stopping the service alone gets it respawned mid-operation and it takes
    the port back.
    """

    UNITS = ("gpsd.socket", "gpsd.service")

    def __init__(self, enabled=True):
        self.enabled = enabled
        self.was_active = {}
        self._armed = False

    def __enter__(self):
        if not self.enabled:
            return self
        for unit in self.UNITS:
            self.was_active[unit] = unit_active(unit)
        stopping = [u for u in self.UNITS if self.was_active.get(u)]
        if stopping:
            print("Stopping %s." % ", ".join(stopping))
            print("The GNSS clock source drops until this finishes; chrony "
                  "falls back to the pool\nand takes a couple of minutes to "
                  "return to stratum 1 afterwards.\n")
            for unit in self.UNITS:
                if self.was_active.get(unit):
                    systemctl("stop", unit)
            time.sleep(1.0)
        self._armed = True
        return self

    def restore(self):
        if not self._armed:
            return
        self._armed = False
        started = []
        for unit in reversed(self.UNITS):
            if self.was_active.get(unit):
                systemctl("start", unit)
                started.append(unit)
        if started:
            print("\nRestarted %s." % ", ".join(started))

    def __exit__(self, *exc):
        self.restore()
        return False


def port_holder(path):
    """Who still has the device open, if anyone. Best effort."""
    try:
        r = subprocess.run(("fuser", path), capture_output=True, text=True,
                           timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    pids = r.stdout.split() + r.stderr.replace(path + ":", "").split()
    names = []
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/comm" % pid) as fh:
                names.append(fh.read().strip())
        except OSError:
            pass
    return names or None


# Pause between writes. driver_allystar.c:1800 warns that "some parts get
# cranky when they get too many configuration changes at once" and spaces its
# own polls four parse cycles apart. Rushing risks reading a chip that has
# fallen behind as "unsupported", which poisons every result at once.
PROBE_SPACING = 0.25
PROBE_TIMEOUT = 1.5

# How long apply() watches the wire before it decides whether a change fits.
# One second is not enough at 1 Hz to see a whole epoch of GSV.
OBSERVE_SECONDS = 1.5

# Bytes of each read window kept as evidence. Enough to show several frames and
# a few sentences without hauling the whole stream around.
RAW_WINDOW = 256


class Change:
    """One documented configuration change.

    Subclasses are the ONLY things Session.apply accepts. There is deliberately
    no way to express a frame outside this set -- that is what keeps "gnssctl
    probe cannot write" a structural fact rather than a promise.

    Validation lives in __init__ rather than in Sentence.build(): build() is a
    thin trusted internal API driven by the spec's field table, and this is the
    layer that accepts input from a person. If a range is not enforced here,
    nothing else stops a malformed command reaching the receiver.
    """

    needs_yes = False

    def describe(self):
        raise NotImplementedError

    def sentences(self):
        raise NotImplementedError

    def confirm(self, session):
        """(ok, detail) -- read the setting back and say whether it took.

        ok is None for "cannot tell from here", which is a third answer and not
        a failure: reporting an unreadable setting as applied would be a claim
        this tool cannot support.
        """
        return None, "no readback available"

    def projected(self, session, obs):
        """(rates, baud, hz, constellations) after this change, for the budget.

        None means this change cannot alter what the link has to carry, so
        there is nothing to weigh.
        """
        return None


class SetBaud(Change):
    def __init__(self, baud):
        if baud not in BAUD_CODE:
            raise ValueError("baud must be one of %s (§2.3.1)"
                             % ", ".join(str(b) for b in sorted(BAUD_CODE)))
        self.baud = baud

    def describe(self):
        return "port speed -> %d" % self.baud

    def sentences(self):
        return [nmea_wrap(PCAS01.build(cmd=BAUD_CODE[self.baud]))]

    def confirm(self, session):
        # Re-clock the port and read CFG-PRT *there*: "the receiver moved" and
        # "we followed it" are separate claims and both need establishing.
        session.port.set_baud(self.baud)
        got = session.get(CFG_PRT)
        if got is None:
            # Say what state this leaves behind. The port is now clocked at the
            # requested speed whether or not the receiver followed, and there is
            # no way to ask the receiver which speed it is on -- it returns to
            # 9600 on power loss, which is the only way back to a known state.
            return False, ("no CFG-PRT reply at %d; the port is clocked there "
                           "but the receiver's speed is now unknown -- it "
                           "returns to 9600 on power loss" % self.baud)
        return got["baudRate"] == self.baud, "CFG-PRT reads %d" % got["baudRate"]

    def projected(self, session, obs):
        # A speed change moves the denominator, not the load, and dropping to
        # 9600 with GSV at 5 Hz is exactly the way to make a node mute. The
        # budget is the only thing that catches that, so it runs here too --
        # at the NEW speed, against the traffic already on the wire.
        return (session.current_rates(obs), self.baud,
                session.current_hz(), session.current_constellations(obs))


# §2.3.2 and §3.2.2.4 Table 13. The only navigation intervals the spec lists.
NAV_INTERVALS = (200, 500, 1000)


class SetRate(Change):
    def __init__(self, interval_ms):
        if interval_ms not in NAV_INTERVALS:
            raise ValueError("interval must be %s ms (§2.3.2, §3.2.2.4 Table 13)"
                             % " or ".join(str(i) for i in NAV_INTERVALS))
        self.interval = interval_ms

    def describe(self):
        return "fix interval -> %d ms (%.3g Hz)" % (self.interval,
                                                    1000.0 / self.interval)

    def sentences(self):
        return [nmea_wrap(PCAS02.build(interval=self.interval))]

    def confirm(self, session):
        got = session.get(CFG_RATE)
        if got is None:
            return None, "CFG-RATE did not answer"
        return got["interval"] == self.interval, ("CFG-RATE reads %d ms"
                                                  % got["interval"])

    def projected(self, session, obs):
        return (session.current_rates(obs), session.port.baud,
                1000.0 / self.interval, session.current_constellations(obs))


# Which sentences $PCAS03 can address, read off the command's own field table
# (§2.3.3) rather than restated: the rate fields are exactly the ones built by
# OptInt, and a separately maintained list would drift into accepting a name
# build() then refuses. TXT is a standard sentence and is NOT one of them --
# the antenna status arrives as a $GPTXT (§2.2.7) but is configured under
# <nANT>, so a validator checking STANDARD_SENTENCES would accept "TXT" and
# fail two lines later.
PCAS03_FIELD = {f.name[1:]: f for f in PCAS03.parts
                if isinstance(f, F) and f.codec.name == "OptInt"}


class SetSentences(Change):
    def __init__(self, rates):
        for name, rate in rates.items():
            field = PCAS03_FIELD.get(name)
            if field is None:
                raise ValueError("$PCAS03 cannot address %s; it sets %s (§2.3.3)"
                                 % (name, ", ".join(sorted(PCAS03_FIELD))))
            # Bounds come from the field's own codec, so the range is stated
            # once, where the field is declared.
            lo, hi = field.codec.lo, field.codec.hi
            if not isinstance(rate, int) or not lo <= rate <= hi:
                raise ValueError("%s: rate must be %d-%d (§2.3.3)" % (name, lo, hi))
        self.rates = dict(rates)

    def describe(self):
        return "sentence rates -> " + ", ".join(
            "%s=%d" % kv for kv in sorted(self.rates.items()))

    def sentences(self):
        kw = {PCAS03_FIELD[k].name: v for k, v in self.rates.items()}
        return [nmea_wrap(PCAS03.build(**kw))]

    def projected(self, session, obs):
        rates = session.current_rates(obs)
        # Only what the width model can price enters the budget. ANT has no
        # sentence table of its own, so its cost is whatever $GPTXT already
        # costs and is counted there or not at all.
        rates.update({k: v for k, v in self.rates.items()
                      if k in STANDARD_SENTENCES})
        return (rates, session.port.baud, session.current_hz(),
                session.current_constellations(obs))


class SetConstellation(Change):
    def __init__(self, constellations):
        key = frozenset(constellations)
        if key not in CONSTELLATION_MODE:
            raise ValueError("no such combination (§2.3.4 lists seven; there is "
                             "no Galileo mode)")
        self.constellations = key

    def describe(self):
        return "constellations -> %s (QZSS always on)" % "+".join(
            sorted(self.constellations))

    def sentences(self):
        return [nmea_wrap(PCAS04.build(
            mode=CONSTELLATION_MODE[self.constellations]))]

    def projected(self, session, obs):
        return (session.current_rates(obs), session.port.baud,
                session.current_hz(), self.constellations)


class Restart(Change):
    def __init__(self, kind, bbr_mask=None):
        if kind not in RESTART_FLAG:
            raise ValueError("restart must be one of %s (§2.3.5)"
                             % ", ".join(sorted(RESTART_FLAG)))
        self.kind = kind
        # $PCAS10 carries no mask; CFG-RST's <navBbrMask> (§3.2.2.3 Table 12) is
        # where a partial clear would go, and this carries the caller's choice
        # for it.
        self.bbr_mask = bbr_mask
        # A cold start discards the almanac and costs minutes of reacquisition;
        # a factory reset additionally returns the constellation set to the
        # Appendix C default of GPS + BeiDou. Nothing in this repository
        # re-applies GLONASS, so that would silently drop a constellation.
        self.needs_yes = kind in ("cold", "factory")

    def describe(self):
        return "%s restart" % self.kind

    def sentences(self):
        return [nmea_wrap(PCAS10.build(flag=RESTART_FLAG[self.kind]))]


CHANGES = (SetBaud, SetRate, SetSentences, SetConstellation, Restart)


class Poll:
    __slots__ = ("label", "kind", "cls", "mid", "payload", "why")

    def __init__(self, label, kind, cls, mid, payload, why):
        self.label = label
        self.kind = kind
        self.cls = cls
        self.mid = mid
        self.payload = payload
        self.why = why


# The frozen poll table. An empty payload IS the Get convention (§3.1), and
# every binary entry here has one -- but the table is explicit rather than a
# length check, because the reverse rule would not be safe: the per-port CFG-PRT
# poll legitimately carries a one-byte port ID in gpsd's Allystar driver, so
# "empty means harmless" is not a property of the protocol.
POLLS = (
    Poll("CFG-PRT", "bin", 0x06, 0x00, b"", "port ID, framing and baud readback"),
    Poll("CFG-RATE", "bin", 0x06, 0x04, b"", "navigation interval"),
    Poll("CFG-MSG", "bin", 0x06, 0x01, b"", "message rates"),
    Poll("$PCAS06", "nmea", None, None, "PCAS06,0",
         "version, over the NMEA path that works"),
    Poll("MON-VER", "bin", 0x0A, 0x04, b"", "chip and firmware -- expect NAK"),
    Poll("CFG-NAVSAT", "bin", 0x06, 0x0C, b"", "constellation mask -- expect NAK"),
    Poll("CFG-PPS", "bin", 0x06, 0x07, b"", "pulse period and polarity"),
    Poll("CFG-SBAS", "bin", 0x06, 0x0E, b"", "SBAS PRNs -- expect NAK"),
)


class ProbeResult:
    def __init__(self, poll, outcome, detail=None, raw=None,
                 answered_in=None, window=b"", window_total=0, seen=None):
        self.poll = poll
        self.outcome = outcome        # ack | nak | reply | silence
        self.detail = detail
        self.raw = raw
        # Which framing the answer actually arrived in. Usually the one we
        # asked in; if it differs, that is a major finding, not a footnote.
        self.answered_in = answered_in
        # Bytes seen during the probe window. Without this a "silence" verdict
        # is unfalsifiable: on a wire that is never quiet, "no matching frame"
        # and "nothing arrived" are completely different claims and only one
        # of them supports concluding the message is unsupported.
        self.window = window
        self.window_total = window_total
        # Tally of EVERY frame the scanners decoded in this window, across all
        # framings, matching or not. The raw window is capped at RAW_WINDOW
        # bytes and so is only a sample; this covers the whole window. It is
        # what makes "no answer" checkable -- specifically, whether any ACK or
        # NAK appeared at all, rather than only one naming the polled message.
        self.seen = seen or {}


class Verdict:
    def __init__(self, status, detail, budget=None):
        self.status = status          # ok | nak | unconfirmed | refused
        self.detail = detail
        self.budget = budget

    def __str__(self):
        return "%-12s %s" % (self.status.upper(), self.detail)


class Session:
    """The only transmit paths in this file.

    poll(n) indexes a frozen table. apply(change) takes an instance of a closed
    set of Change classes. There is no method that accepts a class, id and
    payload from a caller -- get() takes a declared Message and sends the empty
    payload that §3.1 defines as a query, so even the read path has nothing for
    a caller to fill in. That is what makes `probe` read-only by construction
    rather than by convention, and why --selftest can assert it.
    """

    def __init__(self, port, allow_apply=False, timeout=PROBE_TIMEOUT,
                 observe=OBSERVE_SECONDS):
        self.port = port
        self.allow_apply = allow_apply
        # How long to sit on the wire, per read window and per pre-flight
        # observation. Parameters rather than module lookups so --selftest can
        # shrink its own windows against a fake port without touching the real
        # defaults. PROBE_SPACING is deliberately NOT one of these: the pause
        # between writes is what keeps a receiver that gets cranky under rapid
        # reconfiguration from being misread as broken.
        self.timeout = timeout
        self.observe_seconds = observe
        self.framing = CASIC
        # Scan for EVERY framing, not just the one being asked in. A chip with
        # one command parser and one output formatter may well answer a foreign
        # request in its own dialect, and a single-framing scanner would score
        # that as silence -- turning "it answered, just not how we expected"
        # into "it does not support this", which is the opposite conclusion.
        self.scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS}
        self.nmea = NmeaCollector()
        self._window = b""
        self._window_total = 0

    # -- reads ------------------------------------------------------------
    def observe(self, seconds):
        """Watch the wire without transmitting."""
        return listen(self.port, seconds)

    def get(self, message):
        """Send an empty-payload Get and return the parsed reply, or None."""
        frame = self._exchange(message)
        if frame is None:
            return None
        try:
            return message.parse(frame.payload)
        except ValueError:
            # Message.parse refuses a short payload rather than guessing at the
            # missing fields; a reply we cannot read is not a reading.
            return None

    def current_rates(self, obs):
        """Sentence rates inferred from what is actually arriving.

        Labelled "observed" wherever it is printed: CFG-MSG's Get returns one
        message's rate, not the whole set, so the full picture can only come
        from counting the wire. Reporting an inference as a readback is the
        same trap the README records about measuring gpsd's synthesized NMEA.

        Accurate to +-1 epoch: the observation window is wall clock, not a
        whole number of fixes, so at 1 Hz a 1.5 s window catches one epoch or
        two depending on where it lands. Rates are ratios, so a partial epoch
        mostly cancels, but a sentence at rate 2 can read as 1 or 3.
        """
        # Accumulate per sentence NAME across talkers. $GPGSV, $BDGSV and
        # $GLGSV are all GSV, and assigning rather than adding would keep only
        # whichever talker happened to be counted last.
        counts = {}
        for tag, count in obs.nmea_counts.items():
            name = tag[2:] if len(tag) == 5 and not tag.startswith("P") else tag
            if name in STANDARD_SENTENCES and count:
                counts[name] = counts.get(name, 0) + count

        # A raw count is sentences, not fixes: GSV repeats once per four
        # satellites per talker and GSA once per constellation. Dividing by the
        # multiplicity each sentence declares is what turns one into the other.
        # Skipping it inflates the epoch estimate by GSV's multiplicity, and
        # every once-per-fix sentence then infers "every Nth fix" instead of
        # every fix -- an under-count in the guard's input, which is the
        # direction current_hz's docstring explains cannot be recovered from.
        #
        # Normalised against the sky that was OBSERVED, not the projected one:
        # these counts were produced by the sky that was actually there, and
        # pricing them against a substituted ceiling would divide real
        # sentences by an imaginary multiplicity.
        talkers = talkers_for(obs.constellations)
        per_epoch = {}
        unknown = []
        for name, count in counts.items():
            times = STANDARD_SENTENCES[name].repeat(obs.sats_in_view, talkers)
            if times:
                per_epoch[name] = float(count) / times
            else:
                # Arriving, but the model cannot say how many per fix -- GSA
                # with GSV switched off leaves no talker list to count. Left
                # out of the epoch estimate rather than counted as one per fix:
                # too small a multiplicity here inflates epochs and thins out
                # every other sentence's inferred rate.
                unknown.append(name)

        epochs = max(per_epoch.values()) if per_epoch else 1.0
        rates = {name: max(1, int(round(epochs / n)))
                 for name, n in per_epoch.items()}
        # An unknown multiplicity is priced at the most demanding rate there
        # is, for the same asymmetry as current_hz.
        rates.update(dict.fromkeys(unknown, 1))
        return rates

    def current_constellations(self, obs):
        """Which constellations are enabled, inferred from the talkers seen.

        Only GSV reveals this, so with GSV switched off there is nothing to
        count -- and the honest answer is then "unknown", which is NOT the same
        as "none" even though frozenset() prices them identically. Unknown
        falls back to every constellation §2.3.4 offers, for the same asymmetry
        as current_hz: `set sentences GSV=1` is precisely the command run to
        turn GSV on, and pricing it against a sky only GSV can show prices the
        sentence being enabled at zero bytes and waves it through on the way to
        muting the node.
        """
        return obs.constellations or ALL_CONSTELLATIONS

    def current_hz(self):
        """Fix rate, read back from CFG-RATE.

        When the readback fails this assumes the FASTEST documented rate rather
        than the 1 Hz factory default. The number feeds the bandwidth guard, and
        the two ways of being wrong are not symmetric: over-stating the rate
        costs a refusal the operator can override with --force, while
        under-stating it waves through exactly the change the guard exists to
        catch. A node already running at 5 Hz is the normal case here.
        """
        got = self.get(CFG_RATE)
        if got and got.get("interval"):
            return 1000.0 / got["interval"]
        return 1000.0 / min(NAV_INTERVALS)

    def poll(self, n):
        """Send POLLS[n]. Takes an index, never a message."""
        p = POLLS[n]
        if p.kind == "nmea":
            # Drain first rather than slicing from a mark: NmeaCollector caps
            # how many lines it retains, and by this point earlier polls' read
            # windows have already filled it. Slicing would silently see
            # nothing.
            self.port.flush_input()
            self.nmea.take_lines()
            self.port.write(nmea_wrap(p.payload))
            self._read_window(self.timeout)
            # A reply is any sentence that is not routine positioning data --
            # and routine positioning data is exactly what $PCAS03 meters, so
            # the set comes from that command's field table rather than from a
            # hand-kept list. STANDARD_SENTENCES would be the wrong set: it
            # contains TXT, and $GPTXT is precisely what $PCAS06 answers with.
            new = [ln for ln in self.nmea.take_lines()
                   if ln[3:6] not in PCAS03_FIELD]
            if new:
                return ProbeResult(p, "reply", {"sentences": new[:4]},
                                   answered_in="nmea", window=self._window,
                                   window_total=self._window_total)
            return ProbeResult(p, "silence", window=self._window,
                               window_total=self._window_total)
        return self._probe_binary(p)

    # -- writes -----------------------------------------------------------
    def apply(self, change, force=False, yes=False):
        if not self.allow_apply:
            raise PermissionError(
                "this session is read-only; apply() is not available")
        if not isinstance(change, Change):
            raise TypeError("apply() takes a Change, not %r" % (change,))
        if change.needs_yes and not yes:
            return Verdict("refused", "%s needs --yes" % change.describe())

        # The budget needs to know what the sky looks like right now, so this
        # reads before it writes -- and refuses before it writes, because a
        # guard that runs after the write is not a guard. A change that cannot
        # alter what the link carries returns no projection and skips it.
        #
        # projected() may itself poll (current_hz reads CFG-RATE back), so a Get
        # can reach the receiver before the refusal. A Get is not a change:
        # what the guard stands in front of is change.sentences(), and none of
        # those is written until the budget has passed or been overridden.
        bud = None
        obs = self.observe(self.observe_seconds)
        projection = change.projected(self, obs)
        if projection is not None:
            rates, baud, hz, constellations = projection
            bud = budget(rates, baud, hz, obs.sats_in_view, constellations)
            if not bud.ok and not force:
                # Say which number this is refusing on. With GSV off the sky
                # cannot be counted and is priced at the Table 16 ceiling, which
                # is the safe direction but is an assumption -- and refusing an
                # operator on an assumption without saying so is how "re-enable
                # GSV at 9600", the documented reason this tooling exists, turns
                # into an unexplained wall.
                why = ""
                if not bud.measured:
                    why = (" The sky was assumed, not measured (%s): GSV is off, "
                           "so there is nothing to count. If you know the sky is "
                           "sparse, --force." % "+".join(sorted(bud.assumed)))
                return Verdict(
                    "refused",
                    "%s: %.0f%% of the link (%s) -- the stream would never "
                    "drain. Cut the load or raise the speed first, or --force.%s"
                    % (change.describe(), bud.now_pct, bud.sky_note, why),
                    bud)

        for sentence in change.sentences():
            self.port.write(sentence)
            time.sleep(PROBE_SPACING)

        try:
            ok, detail = change.confirm(self)
        except Exception as exc:
            # The change is already on the wire. A readback that fails must not
            # take that fact with it: SetBaud.confirm re-clocks the port, and a
            # tcsetattr failure there would otherwise propagate out of apply()
            # and leave the caller believing nothing was written. Broad on
            # purpose -- what must survive is the record of the write, whatever
            # went wrong after it.
            return Verdict("unconfirmed",
                           "%s; written, but the readback failed: %s: %s"
                           % (change.describe(), type(exc).__name__, exc), bud)

        # A passing budget can still have no headroom. The operator never sees
        # the Budget object, and a warning that is not said out loud is not a
        # warning -- this is the case where enabling a constellation fits the
        # sky now and cannot fit a full one.
        note = ""
        if bud is not None and bud.warn:
            note = " -- no headroom if the sky fills (%.0f%% at the ceiling)" % (
                bud.ceiling_pct,)
        text = "%s; %s%s" % (change.describe(), detail, note)
        if ok is None:
            return Verdict("unconfirmed", text, bud)
        return Verdict("ok" if ok else "nak", text, bud)

    # -- wire -------------------------------------------------------------
    def _read_window(self, timeout):
        """Read until `timeout`, returning every frame decoded in that window.

        Also records the window's bytes and their count, so a "silence" result
        carries its own evidence. Reads in short slices so the timeout is
        honoured reasonably tightly rather than to the nearest whole read.
        """
        end = time.monotonic() + timeout
        seen = []
        raw = bytearray()
        total = 0
        while True:
            left = end - time.monotonic()
            if left <= 0:
                break
            data = self.port.read(min(0.2, max(0.02, left)))
            if not data:
                continue
            total += len(data)
            if len(raw) < RAW_WINDOW:
                raw.extend(data[:RAW_WINDOW - len(raw)])
            self.nmea.feed(data)
            for sc in self.scanners.values():
                sc.feed(data)
                seen.extend(sc.take())
        self._window = bytes(raw)
        self._window_total = total
        return seen

    def _exchange(self, message):
        """Write one empty-payload Get and return the first matching frame.

        Takes a declared Message rather than a class, id and payload: the empty
        payload is the whole of the Get convention (§3.1), so there is nothing
        for a caller to supply -- and therefore no way through here to put bytes
        of their choosing on the wire.

        Returns the message asked for, in the framing it was asked in, or None.
        The scanners watch every framing because *detecting* an answer is the
        question `probe` exists to settle -- but decoding one is a different
        act. A u-blox CFG-PRT puts baudRate at a different offset from a CASIC
        one, so reading a foreign-framed reply with this framing's layout turns
        "it answered in another dialect" into a confident wrong number, and this
        is the path feeding current_hz (a guard input) and SetBaud.confirm (a
        truth claim). poll() reports the foreign answer as the finding it is;
        a readback has to decline it.
        """
        self.port.flush_input()
        for sc in self.scanners.values():
            sc.take()
        self.port.write(self.framing.encode(message.cls, message.mid, b""))
        for frame in self._read_window(self.timeout):
            if frame.framing != self.framing.name:
                continue
            if frame.key == message.key:
                return frame
            if (frame.key == ACK_NACK.key
                    and frame.payload[:2] == bytes(message.key)):
                return None
        return None

    def _probe_binary(self, p):
        self.port.flush_input()
        for sc in self.scanners.values():
            sc.take()

        def classify(fr):
            if fr.key == (p.cls, p.mid):
                return "reply"
            if (fr.key in (ACK_ACK.key, ACK_NACK.key) and len(fr.payload) >= 2
                    and (fr.payload[0], fr.payload[1]) == (p.cls, p.mid)):
                return "ack" if fr.key == ACK_ACK.key else "nak"
            return None

        self.port.write(self.framing.encode(p.cls, p.mid, p.payload))
        frames = self._read_window(self.timeout)

        tally = {}
        for fr in frames:
            k = "%s %02x-%02x" % (fr.framing, fr.cls, fr.mid)
            tally[k] = tally.get(k, 0) + 1

        for fr in frames:
            kind = classify(fr)
            if kind is None:
                continue
            return ProbeResult(p, kind,
                               self._decode(fr) if kind == "reply" else None,
                               fr.payload, answered_in=fr.framing,
                               window=self._window,
                               window_total=self._window_total, seen=tally)
        return ProbeResult(p, "silence", window=self._window,
                           window_total=self._window_total, seen=tally)

    @staticmethod
    def _decode(frame):
        """Field detail for a reply, when its message is declared.

        Looked up in the message table rather than dispatched on the poll's
        label, so a poll for a message this file does not describe reports the
        raw payload instead of nothing at all.
        """
        message = CASIC_MESSAGES.get(frame.key)
        if message is None:
            return None
        try:
            return message.describe(frame.payload)
        except ValueError:
            # Short payload: parse refuses rather than guessing, and an
            # undecodable reply is still a reply worth reporting as one.
            return None


# --------------------------------------------------------------------------
# probe -- the read-only diagnostic
#
# Carried over from gnss-probe (which this file replaces). The finding that
# justifies its existence: what this receiver EMITS and what it ACCEPTS are
# different protocols. It emits u-blox b5 62 and ignores Allystar f1 d9
# entirely, but answers CASIC ba ce -- which it never emits on its own. A
# sweep that only tries the framing seen passively on the wire finds nothing
# but refusals; this is why Session scans every framing on every poll (see
# Session's own docstring) and why cmd_probe tries CASIC unconditionally
# rather than only the framing phase 1 happened to observe.
# --------------------------------------------------------------------------

def sweep(session, framing):
    """Poll every entry in POLLS in one framing.

    Drives Session.poll -- the frozen table, the only transmit path a probe is
    allowed -- rather than any lower-level send. Paced by PROBE_SPACING for the
    same reason apply() is: driver_allystar.c warns that some parts get cranky
    under rapid reconfiguration, and reading a chip that has fallen behind as
    "unsupported" would poison every remaining result in the sweep.
    """
    session.framing = framing
    results = []
    for i in range(len(POLLS)):
        results.append(session.poll(i))
        time.sleep(PROBE_SPACING)
    return results


def productive(results):
    """Did this framing actually yield data, as opposed to refusals?

    A sweep where every binary poll NAKs is a working conversation in which the
    chip declined every question -- which is exactly what a u-blox emulation
    layer does. It means "ask somewhere else", not "this is the answer", so it
    is the trigger for trying the next framing rather than a result to stop on.
    """
    return any(r.outcome in ("reply", "ack")
               for r in results if r.poll.kind == "bin")


# CASIC first, always. This receiver EMITS u-blox b5 62 and ignores Allystar
# f1 d9 entirely, but the protocol it ANSWERS is CASIC ba ce, which it never
# emits. Sweeping only the framing seen on the wire finds nothing but
# refusals -- that finding is why this tool exists, and the order below is
# the whole of its expression in code. A module-level constant rather than a
# local in cmd_probe so --selftest can pin it: this is pure, has no I/O
# dependency, and a future accidental reordering (or an ALL_FRAMINGS that no
# longer starts with CASIC) would otherwise pass the whole suite unnoticed.
PROBE_ORDER = (CASIC,) + tuple(f for f in ALL_FRAMINGS if f is not CASIC)


def hexdump(data, limit=64):
    if not data:
        return ""
    body = " ".join("%02x" % b for b in data[:limit])
    return body + (" ..." if len(data) > limit else "")


OUTCOME_LABEL = {
    "reply": "REPLY",
    "ack": "ACK",
    "nak": "NAK",
    "silence": "silent",
}


def render_probe(obs, sweeps, device):
    out = []
    w = out.append
    w("=" * 72)
    w("gnssctl probe: %s" % device)
    w("=" * 72)
    w("")
    w("PHASE 1 -- what is on the wire (nothing sent)")
    w("  port speed        %d baud" % obs.baud)
    w("  bytes read        %d" % obs.raw_bytes)
    w("")
    w("  binary framing:")
    for f in ALL_FRAMINGS:
        w("    %-9s sync %s  hits %-5d valid frames %-5d" % (
            f.name,
            " ".join("%02x" % b for b in f.sync),
            obs.sync_hits.get(f.name, 0),
            obs.valid_frames.get(f.name, 0)))
        ids = obs.frame_ids.get(f.name) or {}
        if ids:
            top = sorted(ids.items(), key=lambda kv: -kv[1])[:8]
            w("              messages: " +
              ", ".join("%s x%d" % (k, v) for k, v in top))
    w("")
    if obs.nmea_counts:
        w("  NMEA sentences emitted by the RECEIVER (not via gpsd):")
        for tag, n in sorted(obs.nmea_counts.items(), key=lambda kv: -kv[1]):
            w("    %-8s x%d" % (tag, n))
    else:
        w("  NMEA sentences: none seen")
    w("")

    if not sweeps:
        w("PHASE 2 -- skipped: no transmittable framing answered a version poll")
        w("")
        w("  Raw capture head:")
        w("    " + hexdump(obs.raw_head, 96))
    for framing, results in sweeps:
        w("PHASE 2 -- capability sweep in %s framing (%s)" % (
            framing.name, " ".join("%02x" % b for b in framing.sync)))
        if not productive(results):
            w("  Every binary poll was refused. The chip is talking, but it "
              "declines every")
            w("  question in this protocol -- which is what a u-blox emulation "
              "layer does.")
        w("")
        w("  %-12s %-8s %s" % ("POLL", "RESULT", "DETAIL"))
        w("  " + "-" * 68)
        for r in results:
            if r.outcome == "reply" and r.detail:
                parts = ["%s=%s" % (k, v) for k, v in r.detail.items()]
            elif r.outcome == "reply":
                parts = ["payload " + hexdump(r.raw, 24)]
            elif r.outcome == "nak":
                parts = ["not supported on this chip"]
            elif r.outcome == "ack":
                parts = ["supported, returned no data"]
            else:
                # Say what "silence" is actually made of. A busy wire with no
                # matching frame is a different claim from a dead wire, and
                # only the ProbeResult's own window/seen tally can tell them
                # apart -- see ProbeResult's docstring for why both are kept.
                other = ", ".join("%s x%d" % (k, v)
                                  for k, v in sorted(r.seen.items(),
                                                     key=lambda kv: -kv[1])[:5])
                parts = ["no matching frame; %d bytes arrived" % r.window_total,
                         "frames seen: %s" % (other or "NONE in any framing")]
            if r.answered_in and r.answered_in not in (framing.name, "nmea"):
                parts.insert(0, "ANSWERED IN %s FRAMING" % r.answered_in.upper())
            # Wrap rather than truncate. A cut-off line once hid galileo_e1 in
            # gnss-probe -- the single field this whole tool exists to read.
            lines = []
            cur = ""
            for part in parts:
                if cur and len(cur) + len(part) + 2 > 48:
                    lines.append(cur)
                    cur = part
                else:
                    cur = (cur + ", " + part) if cur else part
            if cur:
                lines.append(cur)
            w("  %-12s %-8s %s" % (r.poll.label,
                                   OUTCOME_LABEL[r.outcome], lines[0]))
            for extra in lines[1:]:
                w("  %-12s %-8s %s" % ("", "", extra))
            if r.outcome == "reply" and r.raw:
                w("  %-12s %-8s hex: %s" % ("", "", hexdump(r.raw, 32)))
            if r.outcome == "silence" and r.window:
                w("  %-12s %-8s saw: %s" % ("", "", hexdump(r.window, 28)))
        w("")
    w("=" * 72)
    return "\n".join(out)


def probe_json(obs, sweeps, device):
    return {
        "device": device,
        "baud": obs.baud,
        "bytes_read": obs.raw_bytes,
        "sync_hits": obs.sync_hits,
        "valid_frames": obs.valid_frames,
        "frame_ids": obs.frame_ids,
        "nmea_counts": obs.nmea_counts,
        "nmea_sample": obs.nmea_sample,
        # The raw window head, kept for the same reason ProbeResult keeps a
        # window per poll: without it, "recognised nothing" and "read nothing"
        # are indistinguishable, and only one of them supports concluding this
        # protocol is unsupported.
        "raw_head_hex": obs.raw_head.hex(),
        "sweeps": [
            {
                "framing": framing.name,
                "productive": productive(results),
                "probes": [
                    {
                        "poll": r.poll.label,
                        "why": r.poll.why,
                        "outcome": r.outcome,
                        "detail": r.detail,
                        "raw_hex": r.raw.hex() if r.raw else None,
                        "answered_in": r.answered_in,
                        "window_bytes": r.window_total,
                        "window_hex": r.window.hex() if r.window else None,
                        "frames_seen": r.seen,
                    }
                    for r in results
                ],
            }
            for framing, results in sweeps
        ],
    }


def cmd_probe(port, args):
    """Read-only diagnostic: what this receiver answers, and in which framing.

    Builds Session with allow_apply=False -- not a courtesy, a structural
    guarantee. That is the whole reason probe can be trusted on a live node:
    see Session's docstring and the --selftest check that walks this file's
    own syntax tree to confirm nothing outside {write, poll, apply, _exchange,
    _probe_binary} can reach the wire.
    """
    session = Session(port, allow_apply=False)
    print("Listening at %d baud for %.0fs (sending nothing)..."
          % (port.baud, args.listen_seconds))
    obs = session.observe(args.listen_seconds)

    # PROBE_ORDER puts CASIC first unconditionally -- not because phase 1
    # suggests it, but because it is the documented finding this tool exists
    # to act on: this receiver EMITS u-blox framing and ACCEPTS CASIC framing,
    # and those are different questions. Falling back through the rest of
    # PROBE_ORDER covers the case that finding does not hold on whatever chip
    # is actually attached today.
    sweeps = []
    for framing in PROBE_ORDER:
        print("Sweeping %s framing..." % framing.name)
        results = sweep(session, framing)
        sweeps.append((framing, results))
        if productive(results):
            break
        if framing is not PROBE_ORDER[-1]:
            print("  every binary poll refused; trying the next framing")

    print("")
    print(render_probe(obs, sweeps, port.path))

    if args.json:
        with open(args.json, "w") as fh:
            json.dump(probe_json(obs, sweeps, port.path), fh, indent=2)
        print("JSON written to %s" % args.json)

    return 0 if any(productive(results) for _, results in sweeps) else 2


# --------------------------------------------------------------------------
# show, monitor, bandwidth -- the operator-facing read-only views
#
# The trap these renderers face is the one the README already carries a scar
# for: gpsd synthesizes NMEA for its clients from binary data, so sentences
# the receiver never sent still appear downstream, and measuring that stream
# while calling it "the receiver" gets the conclusion exactly backwards. A
# CFG-PRT/CFG-RATE Get is a readback -- a real answer from the receiver, right
# now. Sentence rates and constellations are inferred by tallying what
# arrived (Session.current_rates/current_constellations). The fix itself is
# neither asked for nor counted -- GGA/GSA/GSV stream unsolicited -- so it is
# reported as observed, not read back. Every line below says which of the
# three it is, in brackets, so a reader cannot mistake one for another.
# --------------------------------------------------------------------------


def _code_text(table, code):
    """(code, text) for a documented spec code, or (code, None) if it is not
    in `table` -- an undocumented code renders as the raw number with a
    marker, not as a guess. code=None (field absent) renders as `(None, None)`
    so the caller's own "unknown" handling applies uniformly.
    """
    if code is None or code == "":
        return None, None
    return code, table.get(code)


def _render_code(table, code):
    """"unknown" for a missing field, "N (text)" for a code `table` documents,
    or "N (undocumented code)" for one it does not -- see _code_text. The raw
    code stays visible either way: an operator reading a bug report is better
    served by "quality 2 (differential/SBAS, fix valid)" than by prose alone.
    """
    code, text = _code_text(table, code)
    if code is None:
        return "unknown"
    if text is None:
        return "%s (undocumented code)" % (code,)
    return "%s (%s)" % (code, text)


def _or_unknown(value):
    """str(value), except a missing field (None or empty) says so.

    A parsed record may be incomplete -- Sentence.parse fills a missing field
    with "" or None rather than guessing -- and 0 is a real, present value
    (GGA <Quality> 0 is "no fix", not "field absent"), so this must not treat
    it as missing.
    """
    if value is None or value == "":
        return "unknown"
    return str(value)


def _one(bucket):
    """One (talker, record) from a talker-keyed dict.

    Does not prefer a talker by name -- the design rules rule that out (see
    "no name-based special-casing"). This receiver emits one combined-solution
    talker per epoch in practice, so there is normally exactly one entry;
    if more than one is present this returns whichever a plain dict yields
    first, which is not a policy choice, just a deterministic one.
    """
    if not bucket:
        return None
    return next(iter(bucket.items()))


def _field_describe(message, raw):
    """Field labels for an already-parsed reply, e.g. from Session.get().

    Message.describe() re-parses a payload's bytes; get() only ever hands
    back the parsed dict, not the frame it came from, so describe() cannot be
    reused directly. This mirrors it field-by-field over that dict instead.
    """
    return {f.name: f.describe(raw[f.name]) for f in message.fields}


def render_show(session, obs, readback=None):
    """Current configuration and fix -- see the module comment above for the
    provenance rule every line here follows.

    session may be None: current_rates/current_constellations need no live
    connection (they only ever look at obs), so the observed section renders
    the same with or without one, exactly as Session(None) already does in
    --selftest for the same methods. Only the two Gets below need a real
    session; without one they render as "not read back", never silently
    omitted.

    readback, when given, is (prt, rate) -- the already-parsed CFG-PRT/
    CFG-RATE dicts (either may be None) -- and is used INSTEAD of querying
    `session`, even if `session` is not None. This is what lets a caller that
    redraws repeatedly (cmd_monitor) do the two Gets ONCE, before its loop,
    and pass the result in on every redraw rather than calling this with a
    live session on a timer: the latter looks read-only but is not -- each
    call would re-transmit, re-flush the port's input buffer, and feed the
    reply into the SESSION's own NmeaCollector rather than the Observation
    on screen, silently undercounting exactly what the display claims to
    be measuring passively. cmd_show, a one-shot command, has no such loop
    and is correct to omit `readback` and let this query `session` directly.
    """
    out = []
    w = out.append
    w("gnssctl show")
    w("-" * 60)

    # current_rates/current_constellations touch no port state (see their own
    # docstrings) -- Session(None) is what --selftest already uses to call
    # them with no hardware, so the same construction covers session=None
    # here without a second implementation to drift out of step.
    inferrer = session if session is not None else Session(None)

    if readback is not None:
        prt, rate = readback
    else:
        prt = session.get(CFG_PRT) if session is not None else None
        rate = session.get(CFG_RATE) if session is not None else None

    if prt is not None:
        d = _field_describe(CFG_PRT, prt)
        w("  port            %d baud, %s, %s  [readback: CFG-PRT]" % (
            prt["baudRate"], d["mode"], ", ".join(d["protoMask"]) or "no protocols"))
    else:
        w("  port            unknown -- no CFG-PRT reply  [not read back]")

    if rate is not None and rate.get("interval"):
        w("  fix interval    %d ms (%.3g Hz)  [readback: CFG-RATE]" % (
            rate["interval"], 1000.0 / rate["interval"]))
    else:
        w("  fix interval    unknown -- no CFG-RATE reply  [not read back]")

    rates = inferrer.current_rates(obs)
    on = ", ".join("%s@%d" % kv for kv in sorted(rates.items())) or "none seen"
    w("  sentence rates  %s  [observed: tallied from the wire, +-1 epoch]" % on)

    cons = inferrer.current_constellations(obs)
    if obs.constellations:
        note = "observed: GSV talkers seen"
    else:
        note = "assumed: no GSV counted, so all of §2.3.4 is possible"
    w("  constellations  %s  [%s]" % ("+".join(sorted(cons)), note))

    w("")
    gga = _one(obs.records("GGA"))
    gsa = _one(obs.records("GSA"))
    if gga is None and gsa is None:
        w("  fix             none observed yet  [observed]")
    else:
        if gsa is not None:
            _, rec = gsa
            w("  fix type        %s  [observed: GSA <FixMode>]" % (
                _render_code(GSA_FIX_MODE, rec.get("fixMode"))))
            w("  DOP (P/H/V)     %s / %s / %s  [observed: GSA]" % (
                _or_unknown(rec.get("pdop")), _or_unknown(rec.get("hdop")),
                _or_unknown(rec.get("vdop"))))
        if gga is not None:
            _, rec = gga
            w("  quality         %s  [observed: GGA <Quality>]" % (
                _render_code(GGA_QUALITY, rec.get("quality"))))
            w("  satellites used %s  [observed: GGA <NumSatUsed>]" % (
                _or_unknown(rec.get("numSatUsed"))))
            w("  HDOP            %s  [observed: GGA <HDOP>]" % (
                _or_unknown(rec.get("hdop"))))
            w("  position        %s%s %s%s  alt %s%s  [observed: GGA]" % (
                _or_unknown(rec.get("lat")), rec.get("ns") or "",
                _or_unknown(rec.get("lon")), rec.get("ew") or "",
                _or_unknown(rec.get("alt")), rec.get("altUnit") or ""))
    return "\n".join(out)


def render_sky(obs):
    """The satellites currently in view -- entirely an observation.

    GSV and GSA both stream unsolicited; there is no Get to contrast them
    with, so unlike render_show this needs no line-by-line source tag -- the
    whole table is [observed].
    """
    sky = obs.sky
    if not sky:
        return "  sky  [observed: GSV]\n    none observed yet"

    # GSA's satID is a single-field repeat block, which Sentence.parse stores
    # as the raw field text rather than running it through IntC's decode (see
    # the "GSA parses..." vendor-vector check, which pins ["10","13",...] with
    # "" padding, not ints with None) -- the same text GSV's own Num-decoded
    # satID already is, so comparing them as strings, unconverted, is correct
    # rather than a shortcut.
    used = set()
    for rec in obs.records("GSA").values():
        for sid in rec.get("sats") or []:
            if sid:
                used.add(sid)

    out = ["  sky  [observed: GSV, cross-checked against GSA's used list]",
           "  %-6s %-4s %5s %5s %5s  %s" % (
               "talker", "sat", "elev", "az", "cn0", "used")]
    for talker in sorted(sky):
        for satid in sorted(sky[talker], key=lambda s: (len(s), s)):
            row = sky[talker][satid]
            out.append("  %-6s %-4s %5s %5s %5s  %s" % (
                talker, satid, _or_unknown(row.get("elev")),
                _or_unknown(row.get("az")), _or_unknown(row.get("cn0")),
                "yes" if satid in used else "-"))
    return "\n".join(out)


def _clear_screen():
    # print(), not sys.stdout.write(): _write_sites() (the read-only-guarantee
    # check) flags ANY function containing a .write() call, transmit or not --
    # see its own docstring -- and this is cosmetic, not a wire write.
    print("\x1b[2J\x1b[H", end="")


def cmd_show(port, args):
    """Read-only snapshot: current configuration (readback) and fix (observed).

    Session built allow_apply=False. render_show's own Gets (CFG-PRT,
    CFG-RATE) are the query convention §3.1 defines, not the apply() path --
    see Session's own docstring for why that is structural, not a promise.
    """
    session = Session(port, allow_apply=False)
    seconds = getattr(args, "listen_seconds", None) or session.observe_seconds
    print("Listening at %d baud for %.1fs, plus CFG-PRT and CFG-RATE Gets..."
          % (port.baud, seconds))
    obs = session.observe(seconds)
    print("")
    print(render_show(session, obs))
    print("")
    print(render_sky(obs))
    return 0


def cmd_monitor(port, args):
    """Live view: reads CFG-PRT/CFG-RATE ONCE, then feeds one long-lived
    Observation purely by watching, redrawing on a timer until Ctrl-C.

    Session built allow_apply=False -- read-only by construction, matching
    show and bandwidth. The one-time readback above is the ONLY thing this
    function ever transmits; every redraw inside the loop calls
    render_show(None, obs, readback=...) rather than handing the loop a live
    session, so a redraw can never re-send a Get.

    That distinction is not cosmetic. An earlier version called
    render_show(session, obs) from inside the loop. render_show does its own
    session.get(CFG_PRT)/get(CFG_RATE) whenever session is not None, and
    each get() flushes the port's input buffer, writes a frame, and reads
    for up to Session's timeout (1.5s default) -- feeding whatever NMEA
    arrives into the SESSION's own NmeaCollector, a different object from
    `obs`. So every redraw sent two frames, discarded buffered wire data
    twice, and diverted several seconds of real traffic away from the
    Observation the display claims to be built from -- while the banner
    printed "nothing sent". That is this task's own failure mode, produced
    by this task's own code: the measurement apparatus corrupting the
    measurement while asserting it is passive. See render_show's docstring
    for the `readback` parameter this loop uses to avoid it.

    Port.read already selects on the serial fd for `interval` seconds, so
    the loop body is one port.read() call per redraw with no separate wait
    step. Port.fd is public so a future interactive mode could select() on
    it alongside stdin for pause/toggle keys -- an open question with the
    human, deliberately not built here -- without restructuring this loop;
    it would replace the single port.read() call with a select() over
    {port.fd, stdin} and dispatch on which fired.
    """
    # timeout overridable the same way listen_seconds is elsewhere in this
    # file -- not a production knob, but without it --selftest could only
    # drive this loop's real code at the production 1.5s-per-Get pace.
    session = Session(port, allow_apply=False,
                      timeout=getattr(args, "timeout", None) or PROBE_TIMEOUT)
    print("Reading CFG-PRT and CFG-RATE once...")
    readback = (session.get(CFG_PRT), session.get(CFG_RATE))

    obs = Observation(port.baud)
    raw = bool(getattr(args, "raw", False))
    interval = getattr(args, "interval", None) or 1.0
    scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS} if raw else {}

    print("Watching %s at %d baud -- nothing else is sent. Ctrl-C to stop."
          % (port.path, port.baud))
    try:
        while True:
            data = port.read(interval)
            # Decoded fresh each iteration, not accumulated: these are
            # printed AFTER the clear and the panels below, appended under
            # the sky table, so they are visible for this redraw's `interval`
            # seconds rather than erased by the very next line of output --
            # an earlier version cleared the screen immediately after
            # printing them, so the feature ran but nothing was ever visible
            # to a human watching the terminal.
            raw_lines = []
            if data:
                obs.absorb(data)
                if raw:
                    for sc in scanners.values():
                        sc.feed(data)
                        for fr in sc.take():
                            detail = Session._decode(fr)
                            raw_lines.append("  %-9s %02x-%02x  %s" % (
                                fr.framing, fr.cls, fr.mid,
                                detail if detail else hexdump(fr.payload, 24)))
            _clear_screen()
            print(render_show(None, obs, readback=readback))
            print("")
            print(render_sky(obs))
            if raw:
                print("")
                print("  raw frames this cycle:")
                for line in raw_lines:
                    print(line)
                if not raw_lines:
                    print("    none")
    except KeyboardInterrupt:
        print("")
        return 0


def _parse_rate_overrides(text):
    """{'GGA': 1, ...} from 'GGA=1,GSV=2'.

    Reuses SetSentences' own validation -- names from PCAS03's field table,
    the 0-9 bound from OptInt -- so a typo in --sentences is refused the same
    way it would be on the wire, rather than drifting from it. The instance
    is never sent; only .rates is read, and cmd_bandwidth is the only caller.
    """
    out = {}
    for item in text.split(","):
        item = item.strip()
        if not item:
            continue
        name, sep, value = item.partition("=")
        if not sep:
            raise ValueError("%r: expected NAME=RATE" % item)
        out[name.strip().upper()] = int(value)
    return SetSentences(out).rates


def cmd_bandwidth(port, args):
    """Bandwidth arithmetic for the current configuration, or a hypothetical
    one given --rate/--baud/--sentences. Sends nothing at all: session.observe
    is a passive listen, and that is the only thing this function does with
    the port -- no Get, no poll, no apply. (See the design doc: "prints the
    arithmetic ... without sending anything.")
    """
    session = Session(port, allow_apply=False)
    seconds = getattr(args, "listen_seconds", None) or session.observe_seconds
    print("Listening at %d baud for %.1fs (sending nothing)..."
          % (port.baud, seconds))
    obs = session.observe(seconds)

    rates = session.current_rates(obs)
    sentences = getattr(args, "sentences", None)
    if sentences:
        # Only what the width model can price enters the budget -- see
        # SetSentences.projected's identical filter and its comment on ANT.
        rates.update({k: v for k, v in _parse_rate_overrides(sentences).items()
                      if k in STANDARD_SENTENCES})

    constellations = session.current_constellations(obs)
    baud = getattr(args, "baud", None) or port.baud

    rate = getattr(args, "rate", None)
    if rate:
        hz = float(rate)
        hz_note = "given by --rate"
    else:
        # No CFG-RATE Get: this command sends nothing at all, so the real
        # rate cannot be read back. Assuming the fastest documented rate is
        # the same asymmetry Session.current_hz() applies when ITS Get fails
        # -- over-stating hz costs a refusal --force can override;
        # under-stating waves through exactly the overload the guard exists
        # to catch.
        hz = 1000.0 / min(NAV_INTERVALS)
        hz_note = "assumed: fastest documented rate (%.3g Hz) -- no Get sent" % hz

    bud = budget(rates, baud, hz, obs.sats_in_view, constellations)
    print("")
    print("  fix rate                %s" % hz_note)
    print(bud.render())
    return 0 if bud.ok else 1


def check(name, fn):
    """Record one assertion.

    Takes a thunk rather than a value on purpose. A check written before the
    function it exercises exists must report FAIL and let the rest of the suite
    run -- evaluating eagerly would raise NameError and abort the whole file,
    which makes red-green cycles impossible in a single-file script.
    """
    try:
        ok = bool(fn())
    except Exception as exc:
        print("  FAIL %s [%s: %s]" % (name, type(exc).__name__, exc))
        _FAILS.append(name)
        return
    print(("  ok   " if ok else "  FAIL ") + name)
    if not ok:
        _FAILS.append(name)


def _raises(fn, expect=Exception):
    """True if fn() raised `expect`.

    NameError and AttributeError are re-raised rather than swallowed: those mean
    the check itself is broken -- a renamed or missing symbol -- and a safety
    assertion that passes because its subject vanished is worse than no
    assertion at all. Several of the checks below use this to assert that a
    write is refused.
    """
    try:
        fn()
    except (NameError, AttributeError):
        raise
    except expect:
        return True
    return False


def _write_sites():
    """Names of every function in this file that can call something's write().

    Read from the module's own syntax tree, because the property being asserted
    is "only these functions transmit" and a blacklist of method names asserts a
    naming convention instead. A Session.emit(cls, mid, body) passes any list of
    forbidden names and any search for the word "payload", and still puts a
    caller's bytes on the wire; it fails this.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    out = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef):
            continue
        for inner in ast.walk(node):
            if (isinstance(inner, ast.Call)
                    and isinstance(inner.func, ast.Attribute)
                    and inner.func.attr == "write"):
                out.add(node.name)
    return out


def _uses_apply():
    """Names of every function in this file that can call something's apply(.

    Same AST-walk approach as _write_sites, turned on Session.apply instead
    of write(): used to confirm cmd_show/cmd_monitor/cmd_bandwidth -- all
    three declared read-only in the design -- never reach it, the one path
    that can put a Change on the wire.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    out = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef):
            continue
        for inner in ast.walk(node):
            if (isinstance(inner, ast.Call)
                    and isinstance(inner.func, ast.Attribute)
                    and inner.func.attr == "apply"):
                out.add(node.name)
    return out


def _reaches(func_name, attrs):
    """True if the top-level function `func_name` calls obj.<attr>(...) for
    any attr in `attrs`.

    AST-based rather than a source-text search over inspect.getsource(): this
    file's own docstrings explain, in prose, exactly which of these
    cmd_bandwidth does NOT call (to justify why it sends nothing) -- a
    substring search would match that explanation and pass whether or not the
    code agrees with it.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == func_name:
            return any(isinstance(inner, ast.Call)
                      and isinstance(inner.func, ast.Attribute)
                      and inner.func.attr in attrs
                      for inner in ast.walk(node))
    return False


def _session_calls(func_name):
    """The keyword args of every Session(...) call inside the top-level
    function `func_name`, as {arg: constant value} dicts.

    AST-based for the same reason _reaches is: read-only-ness has to be
    checked from the call itself, not from a docstring's prose about it.
    """
    import ast  # only used here, and this is the only caller
    with open(__file__) as fh:
        tree = ast.parse(fh.read())
    out = []
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == func_name:
            for inner in ast.walk(node):
                if (isinstance(inner, ast.Call)
                        and isinstance(inner.func, ast.Name)
                        and inner.func.id == "Session"):
                    out.append({kw.arg: getattr(kw.value, "value", None)
                               for kw in inner.keywords})
    return out


def _all_subclasses(cls):
    """Every subclass of cls, however deeply nested.

    Recursive because apply() gates on isinstance, which is: a subclass of a
    subclass is accepted there, so the closed-set check has to see it too.
    __subclasses__() alone reports only direct children.
    """
    out = set()
    for sub in cls.__subclasses__():
        out.add(sub)
        out |= _all_subclasses(sub)
    return out


def _sky(counts, sats):
    """An observation stated directly, so inference can be checked off a wire.

    Injects the GSV records rather than restating how sats_in_view and
    constellations are derived, so the check exercises the real derivation.
    """
    obs = Observation(9600)
    obs.nmea_counts = dict(counts)
    obs._nmea.records["GSV"] = {t: {"totalNumSat": n} for t, n in sats.items()}
    return obs


# The wire window the fake-port checks run with. They assert ordering, refusal
# and classification, none of which depends on how long the window is: the fake
# port hands over its whole reply on the first read, so the rest of a real
# 1.5 s window would be pure sleep. The production defaults are untouched.
_TEST_WINDOW = 0.05

# One whole epoch of a twelve-satellite GPS sky, and a wire with no GSV on it
# at all -- the two fixtures the apply() checks need, since "what the sky is"
# and "whether the sky can be seen" are what the bandwidth guard turns on.
_EPOCH = (nmea_wrap("GPGSV,3,1,12,02,49,123,43,0")
          + nmea_wrap("GPGSV,3,2,12,05,60,005,43,0")
          + nmea_wrap("GPGSV,3,3,12,06,06,127,29,0")
          + nmea_wrap("GNGSA,A,3,10,13,15,20,,,,,,,,,2.5,2.0,1.5,1"))
_NO_GSV = nmea_wrap("GNRMC,071556.000,A,3149.29103,N,11706.92916,E,"
                    "0.00,0.00,250420,,,A,V")


class _FakePort:
    """A quiet port that records what was written to it. Not hardware.

    Enough of Port's surface for the checks that exercise apply()'s ordering:
    what matters there is what reaches write(), and for a refusal that nothing
    does. read() sleeps rather than returning immediately, because a real port
    blocks and a busy spin would burn a core for the length of every window.
    """

    def __init__(self, baud=9600, data=b""):
        self.baud = baud
        self.writes = []
        self._data = data

    def read(self, timeout):
        if self._data:
            out, self._data = self._data, b""
            return out
        time.sleep(timeout)
        return b""

    def write(self, data):
        self.writes.append(data)

    def flush_input(self):
        pass

    def set_baud(self, baud):
        self.baud = baud


class _QuietThenInterrupt:
    """A port that answers `iterations` reads with nothing, then raises
    KeyboardInterrupt -- the only way to end cmd_monitor's own `while True`
    loop, so this drives a couple of REAL redraw cycles through cmd_monitor
    itself rather than only its call graph.

    Exists for exactly one gap: _reaches()/_session_calls() inspect
    cmd_monitor's own AST body, which no longer contains a live-session
    render_show call -- but they cannot see what render_show ITSELF does
    with whatever cmd_monitor hands it. Only actually running the loop and
    checking what reached write() closes that.
    """

    def __init__(self, iterations=3):
        self.baud = 9600
        self.path = "/dev/fake"
        self.writes = []
        self._left = iterations

    def read(self, timeout):
        if self._left <= 0:
            raise KeyboardInterrupt
        self._left -= 1
        # Paces itself against the SAME wall-clock budget _read_window checks
        # (like _FakePort's own read()) rather than returning instantly: an
        # instant return lets _read_window's while loop busy-spin through its
        # whole window in a handful of Python instructions, exhausting
        # `iterations` in one call before any real time (or a second read())
        # happens, and this port's whole purpose -- driving a fixed, known
        # number of real read() calls -- depends on that not happening.
        time.sleep(timeout)
        return b""

    def write(self, data):
        self.writes.append(data)

    def flush_input(self):
        pass


class _Args:
    """A bare attribute bag, standing in for argparse's Namespace so cmd_*
    functions can be driven in --selftest without argparse in the loop.
    """

    def __init__(self, **kw):
        self.__dict__.update(kw)


def _apply_on_quiet_port(change, sky=None, **kw):
    """(port, verdict) for one apply() against a port showing `sky`.

    The default is a WHOLE epoch, not a sample of one: twelve GPS satellites
    take three GSV sentences to report (§2.2.3, four per transmission), so a
    single one would correctly infer "GSV every third fix" and price the stream
    at a third of what it costs. The budget must be refusing real traffic here,
    not an artefact of the fixture.
    """
    port = _FakePort(9600, _EPOCH if sky is None else sky)
    return port, Session(port, allow_apply=True, timeout=_TEST_WINDOW,
                         observe=_TEST_WINDOW).apply(change, **kw)


def _breaking_readback(change, exc):
    """Give one Change instance a readback that fails.

    Patched onto the instance rather than subclassed: a sixth Change subclass
    would break the closed-set assertion, which is a property worth more than
    the convenience.
    """
    def confirm(session):
        raise exc
    change.confirm = confirm
    return change


def _poll_on_quiet_port(n, data):
    """(port, result) for one poll against a port that answers once, then quiets.

    On a read-only session, which is where a poll belongs. The read window runs
    its course rather than stopping at the first answer -- silence and an answer
    cost the same -- which is why these run on a shortened one.
    """
    port = _FakePort(9600, data)
    return port, Session(port, timeout=_TEST_WINDOW).poll(n)


def _probe_session():
    return Session(None, allow_apply=False)


def _scan(framing, *chunks):
    sc = Scanner(framing)
    for chunk in chunks:
        sc.feed(chunk)
    return sc.take()


def _collect(data, keep=40):
    nc = NmeaCollector(keep=keep)
    nc.feed(data)
    return nc


def _observe(data):
    obs = Observation(115200)
    obs.absorb(data)
    return obs


def selftest():
    del _FAILS[:]
    print("gnssctl --selftest")
    print("")
    print("data types (§3.1.1 Table 4):")
    check("U1 is one byte", lambda: U1.size == 1)
    check("I1 is one byte", lambda: I1.size == 1)
    check("U2 is two bytes", lambda: U2.size == 2)
    check("I2 is two bytes", lambda: I2.size == 2)
    check("U4 is four bytes", lambda: U4.size == 4)
    check("I4 is four bytes", lambda: I4.size == 4)
    check("R4 is four bytes", lambda: R4.size == 4)
    check("R8 is eight bytes", lambda: R8.size == 8)
    check("U2 packs little-endian",
          lambda: U2.pack(1000) == b"\xe8\x03")
    check("U4 packs little-endian",
          lambda: U4.pack(9600) == b"\x80\x25\x00\x00")
    check("I1 is two's complement (§3.1.1 'Complement')",
          lambda: I1.pack(-1) == b"\xff" and I1.unpack(b"\xff") == -1)
    check("every integer type round-trips",
          lambda: all(c.unpack(c.pack(v)) == v
                      for c, v in ((U1, 255), (I1, -128), (U2, 65535),
                                   (I2, -32768), (U4, 4294967295), (I4, -1))))

    print("")
    print("NMEA framing against the spec's own examples (§2.2, §2.3):")
    check("all 20 vendor checksums verify",
          lambda: [s for s in SPEC_NMEA
                   if nmea_checksum(s.rsplit("*", 1)[0]) != s.rsplit("*", 1)[1]] == [])
    check("wrap produces the sentence gnss-set-baud sent",
          lambda: nmea_wrap("PCAS01,5") == b"$PCAS01,5*19\r\n")
    check("split round-trips a wrapped sentence",
          lambda: nmea_split(nmea_wrap("PCAS02,1000").decode()) == ("PCAS02,1000", True))
    check("split rejects a corrupted checksum",
          lambda: nmea_split("$PCAS01,5*1A") == ("PCAS01,5", False))
    check("split rejects a line that is not a sentence",
          lambda: nmea_split("garbage") == (None, False))
    check("checksum covers neither $ nor * (§2.1)",
          lambda: nmea_checksum("GPTXT,01,01,02,MA=CASIC") == "27")

    print("")
    print("CASIC framing against the spec's own frames (§3.1, §3.2):")
    check("the CFG-PRT Get poll matches the spec byte for byte",
          lambda: CASIC.encode(0x06, 0x00) == bytes.fromhex(SPEC_CASIC["CFG-PRT get"]))
    check("the CFG-MSG Get poll matches the spec byte for byte",
          lambda: CASIC.encode(0x06, 0x01) == bytes.fromhex(SPEC_CASIC["CFG-MSG get"]))
    check("the CFG-RATE Get poll matches the spec byte for byte",
          lambda: CASIC.encode(0x06, 0x04) == bytes.fromhex(SPEC_CASIC["CFG-RATE get"]))
    check("every vendor frame decodes with a valid checksum",
          lambda: [k for k, v in SPEC_CASIC.items()
                   if CASIC.decode(bytes.fromhex(v)) is None] == [])
    check("the CFG-PRT UART0 response decodes to the documented payload",
          lambda: CASIC.decode(bytes.fromhex(SPEC_CASIC["CFG-PRT resp UART0"]))
                  == (0x06, 0x00, bytes.fromhex("00ffc00880250000")))
    check("a corrupted checksum is rejected",
          lambda: CASIC.decode(bytes.fromhex(SPEC_CASIC["CFG-RATE resp"])[:-1] + b"\xff")
                  is None)
    check("length is read from offset 2 in CASIC and offset 4 in u-blox",
          lambda: CASIC.payload_len(bytes.fromhex(SPEC_CASIC["CFG-PRT resp UART0"])) == 8
                  and UBX.payload_len(UBX.encode(0x06, 0x00, b"\x01\x02")) == 2)
    check("a payload that is not a multiple of 4 is refused (§3.1)",
          lambda: _raises(lambda: CASIC.encode(0x06, 0x00, b"\x01")))
    check("u-blox and Allystar differ only in their sync bytes",
          lambda: ALLY.encode(0x06, 0x0C)[2:] == UBX.encode(0x06, 0x0C)[2:])

    print("")
    print("scanner:")
    _f = CASIC.encode(0x06, 0x04, bytes.fromhex("e8030000"))
    check("one clean frame", lambda: len(_scan(CASIC, _f)) == 1)
    check("garbage before a frame", lambda: len(_scan(CASIC, b"\x00\xff\x12junk" + _f)) == 1)
    check("frame split across two reads",
          lambda: _scan(CASIC, _f[:5], _f[5:]) and len(_scan(CASIC, _f[:5], _f[5:])) == 1)
    check("sync pair straddling two reads",
          lambda: len(_scan(CASIC, b"\xba", b"\xce" + _f[2:])) == 1)
    check("sync bytes inside a payload do not truncate the frame",
          lambda: [fr.payload for fr in
                   _scan(CASIC, CASIC.encode(0x06, 0x04, b"\xba\xce\xba\xce"))]
                  == [b"\xba\xce\xba\xce"])
    check("a bad frame is skipped and the next one still found",
          lambda: len(_scan(CASIC, bytes(bytearray(_f[:-1]) + b"\xff") + _f)) == 1)

    print("")
    print("CASIC message tables (§3.2):")
    check("CFG-MSG builds the spec's GGA-enable frame",
          lambda: CASIC.encode(CFG_MSG.cls, CFG_MSG.mid,
                               CFG_MSG.build(clsID=0x4E, msgID=0x00, rate=1))
                  == bytes.fromhex(SPEC_CASIC["CFG-MSG set GGA"]))
    check("CFG-RATE builds the spec's 2 Hz frame",
          lambda: CASIC.encode(CFG_RATE.cls, CFG_RATE.mid,
                               CFG_RATE.build(interval=500, res=0))
                  == bytes.fromhex(SPEC_CASIC["CFG-RATE set 500"]))
    check("CFG-RST builds the spec's clear-configuration frame",
          lambda: CASIC.encode(CFG_RST.cls, CFG_RST.mid,
                               CFG_RST.build(navBbrMask=0x01FF, resetMode=0, startMode=0))
                  == bytes.fromhex(SPEC_CASIC["CFG-RST clear cfg"]))
    check("CFG-PRT parses the spec's UART0 response (§3.2.2.1 Table 8)",
          lambda: CFG_PRT.parse(bytes.fromhex("00ffc00880250000"))
                  == {"portID": 0, "protoMask": 0xFF, "mode": 0x08C0, "baudRate": 9600})
    check("CFG-RATE parses the spec's 1000 ms response",
          lambda: CFG_RATE.parse(bytes.fromhex("e8030000"))["interval"] == 1000)
    check("ACK-ACK names the message it acknowledges",
          lambda: ACK_ACK.parse(bytes.fromhex("06000000"))["clsID"] == 0x06)
    check("every CASIC payload is a multiple of 4 bytes (§3.1)",
          lambda: all(m.size % 4 == 0 for m in CASIC_MESSAGES.values()))
    check("every message round-trips: parse(build(x)) == x",
          lambda: all(m.parse(m.build(**v)) == v for m, v in (
              (CFG_PRT, {"portID": 1, "protoMask": 0x07, "mode": 0x08C0,
                         "baudRate": 115200}),
              (CFG_MSG, {"clsID": 0x4E, "msgID": 0x03, "rate": 0xFFFF}),
              (CFG_RST, {"navBbrMask": 0x0200, "resetMode": 1, "startMode": 2}),
              (CFG_RATE, {"interval": 200, "res": 0}),
              (ACK_NACK, {"clsID": 0x06, "msgID": 0x0C, "res": 0}))))
    check("build refuses an out-of-range value rather than truncating",
          lambda: _raises(lambda: CFG_MSG.build(clsID=0x4E, msgID=0, rate=70000)))
    check("build refuses a missing field",
          lambda: _raises(lambda: CFG_RATE.build(interval=200)))
    check("mode 0x08C0 describes as 8N1 (§3.2.2.1 Table 10)",
          lambda: CFG_PRT.describe(bytes.fromhex("00ffc00880250000"))["mode"] == "8N1")
    check("protoMask 0xff describes all four protocol bits (Table 9)",
          lambda: set(CFG_PRT.describe(bytes.fromhex("00ffc00880250000"))["protoMask"])
                  == {"binary in", "text in", "binary out", "text out"})
    check("NMEA message IDs use CASIC class 0x4E, not u-blox 0xf0 (Table 5)",
          lambda: NMEA_MSG_ID["GGA"] == (0x4E, 0x00)
                  and NMEA_MSG_ID["ZDA"] == (0x4E, 0x08))
    check("every Table 10 parity encoding decodes, Reserved included",
          lambda: [_mode_flags((0b11 << 6) | (p << 9))[1] for p in range(8)]
                  == ["E", "O", "?", "?", "N", "N", "?", "?"])
    check("describe is declared per field, not matched on the field's name",
          lambda: CFG_PRT.describe(bytes.fromhex("00ffc00880250000"))["mode"] == "8N1"
