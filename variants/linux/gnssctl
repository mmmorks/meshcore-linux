class F:
    __slots__ = ("name", "codec")

    def __init__(self, name, codec):
        self.name = name
        self.codec = codec


class Repeat:
    """A repeat block. `times` is a fixed count, or (min, max) if variable."""

    __slots__ = ("times", "fields", "key")

    def __init__(self, times, key, *fields):
        self.times = times
        self.key = key
        self.fields = fields

    @property
    def max_times(self):
        return self.times if isinstance(self.times, int) else self.times[1]


class Sentence:
    def __init__(self, name, *parts, repeat=None):
        self.name = name
        self.parts = parts
        # How many times this sentence is emitted per position fix, given
        # the sky and the enabled talkers. Declared per sentence rather
        # than matched on the sentence's name at the call site: the
        # multiplicity is a property of the sentence, and a new sentence
        # that forgot to declare one would otherwise be silently counted
        # once per fix -- an under-count in the bandwidth guard.
        self._repeat = repeat

    def repeat(self, sats, talkers):
        if self._repeat is None:
            return 1
        return self._repeat(sats, talkers)

    def _flat_fields(self, count=None):
        """Expand repeat blocks for a body with `count` data fields."""
        out = []
        for part in self.parts:
            if isinstance(part, F):
                out.append(part)
                continue
            times = part.times
            if not isinstance(times, int):
                # Variable block: everything not accounted for by the fixed
                # fields belongs to it. GSV is header(3) + 4n + signalID(1).
                fixed = sum(1 for p in self.parts if isinstance(p, F))
                leftover = max(0, count - fixed)
                # A truncated sentence (dropped byte, cut-off read) leaves a
                # remainder that doesn't fill a whole row. Guessing here would
                # silently misattribute a field -- e.g. a stray satID read as
                # signalID -- so refuse rather than parse it wrong.
                if leftover % len(part.fields):
                    raise ValueError(
                        "%s: %d field(s) do not fill whole %d-field repeat blocks"
                        % (self.name, leftover, len(part.fields)))
                times = leftover // len(part.fields)
            out.append((part, times))
        return out

    def parse(self, body):
        fields = body.split(",")[1:]
        out = {}
        idx = 0
        for item in self._flat_fields(len(fields)):
            if isinstance(item, F):
                out[item.name] = item.codec.decode(
                    fields[idx] if idx < len(fields) else "")
                idx += 1
                continue
            block, times = item
            rows = []
            for _ in range(times):
                if len(block.fields) == 1:
                    rows.append(fields[idx] if idx < len(fields) else "")
                    idx += 1
                else:
                    row = {}
                    for f in block.fields:
                        row[f.name] = f.codec.decode(
                            fields[idx] if idx < len(fields) else "")
                        idx += 1
                    rows.append(row)
            out[block.key] = rows
        return out

    def build(self, **kw):
        parts = [self.name]
        for part in self.parts:
            if isinstance(part, F):
                codec = part.codec
                parts.append(codec.fixed if hasattr(codec, "fixed")
                             else codec.encode(kw.get(part.name)))
                continue
            # A variable repeat emits exactly as many blocks as the caller
            # supplied rows: on the wire a GSV sentence carries 1-4 satellites
            # and the count is implicit in the field count, so there is nothing
            # else it could mean. A fixed repeat always emits its full width --
            # GSA pads unused satellite slots with empty fields (§2.2.4).
            rows = kw.get(part.key) or []
            times = part.times if isinstance(part.times, int) else len(rows)
            for i in range(times):
                row = rows[i] if i < len(rows) else None
                for f in part.fields:
                    if len(part.fields) == 1:
                        parts.append(f.codec.encode(row))
                    else:
                        parts.append(f.codec.encode((row or {}).get(f.name)))
        return ",".join(parts)

    def max_width(self):
        """Worst-case bytes on the wire: '$' + address + fields + '*CS' + CRLF.

        Clamped to the NMEA 0183 82-byte sentence limit, which is a hard ceiling
        no conforming sentence can exceed.
        """
        n_fields = 0
        width = 0
        for part in self.parts:
            if isinstance(part, F):
                n_fields += 1
                width += part.codec.max_width
            else:
                n_fields += part.max_times * len(part.fields)
                width += part.max_times * sum(f.codec.max_width
                                              for f in part.fields)
        total = 1 + len(self.name) + 2 + n_fields + width + 3 + 2
        return min(total, 82)


