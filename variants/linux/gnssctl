class Codec:
    """One CASIC data type (§3.1.1, Table 4).

    Little-endian throughout: the spec's worked frames encode Len, BaudRate and
    the checksum little-endian (e.g. CFG-RATE 1000 ms as 'E8 03 00 00', §3.2.2.4).
    """

    __slots__ = ("name", "size", "_fmt")

    def __init__(self, name, size, fmt):
        self.name = name
        self.size = size
        self._fmt = "<" + fmt

    def pack(self, value):
        return struct.pack(self._fmt, value)

    def unpack(self, raw):
        return struct.unpack(self._fmt, raw[:self.size])[0]

    def __repr__(self):
        return "<%s>" % self.name


