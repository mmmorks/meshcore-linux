def capacity(baud):
    """Bytes per second the link can carry.

    8N1 framing is 1 start + 8 data + 1 stop = 10 bits per byte, so this is
    exact rather than an estimate.
    """
    if baud <= 0:
        raise ValueError("baud must be positive, got %r" % (baud,))
    return baud / 10.0


def talkers_for(constellations):
    """Which GSV/GSA talker IDs a constellation set produces (§2.2 Table 2).

    QZSS shares the GP talker with GPS and is always enabled (§1 note 1), so it
    adds no talker of its own.
    """
    return tuple(_TALKER[c] for c in ("GPS", "GLO", "BDS") if c in constellations)


def epoch_bytes(rates, sats, talkers):
    """Worst-case bytes emitted per position fix.

    Multiplicity (how many times a sentence repeats per fix) is declared on
    the sentence itself -- see GSV's and GSA's `repeat=` -- not matched here
    by name, so a sentence that forgot to declare one can't silently be
    under-counted. A rate of N means once every N fixes (§2.3.3).
    """
    total = 0.0
    for name, rate in rates.items():
        if not rate:
            continue
        sentence = STANDARD_SENTENCES[name]
        total += sentence.repeat(sats, talkers) * sentence.max_width() / float(rate)
    return total


def projected_sky(sats_now, constellations):
    """(satellites per talker, the talkers whose count had to be assumed).

    A talker contributes no satellites either because its constellation is
    genuinely absent or because GSV is switched off and there is nothing to
    count -- and to the budget those are the same zero. Since GSV is the only
    sentence that reveals the sky, pricing a change against what GSV shows
    prices GSV itself at zero on any node where it is currently off, and both
    of budget()'s operating points go blind together, so not even the ceiling
    warning fires.

    An unobservable sky is unknown, not empty, so it is priced at the Table 16
    ceiling: over-stating costs a refusal the operator can --force,
    under-stating costs the node. Which talkers were assumed is returned rather
    than discarded, because a figure that justifies a refusal has to be able to
    say whether it was measured.
    """
    out = dict(sats_now)
    assumed = set()
    for talker in talkers_for(constellations):
        if not out.get(talker):
            out[talker] = TALKER_CEILING[talker]
            assumed.add(talker)
    return out, frozenset(assumed)


class Budget:
    def __init__(self, rates, baud, hz, now_bps, ceiling_bps, assumed=frozenset()):
        self.rates = rates
        self.baud = baud
        self.hz = hz
        self.now_bps = now_bps
        self.ceiling_bps = ceiling_bps
        self.capacity_bps = capacity(baud)
        # Talkers whose satellite count was substituted rather than counted.
        # Carried so the report can say which of its two numbers is a
        # measurement -- see sky_note.
        self.assumed = assumed

    @property
    def now_pct(self):
        return 100.0 * self.now_bps / self.capacity_bps

    @property
    def ceiling_pct(self):
        return 100.0 * self.ceiling_bps / self.capacity_bps

    @property
    def ok(self):
        """False means physically impossible at the current sky -- a hard error."""
        return self.now_bps <= self.capacity_bps

    @property
    def warn(self):
        """True means no headroom if every enabled constellation fills the sky."""
        return self.ceiling_bps > self.capacity_bps

    @property
    def measured(self):
        """True if every contributing talker's sky was actually counted."""
        return not self.assumed

    @property
    def sky_note(self):
        """How the first operating point was arrived at.

        A substituted count is an assumption, and printing it under "sky now"
        reports an assumption as a measurement. This repository already has the
        scar: the README warns that gpsd synthesizes NMEA for its clients, so
        measuring the client stream and calling it the receiver yields
        conclusions that are backwards. A number that exists to justify
        refusing an operator has to say where it came from.
        """
        if self.measured:
            return "sky now"
        return "sky assumed for %s -- GSV is off" % "+".join(sorted(self.assumed))

    def render(self):
        on = ", ".join("%s@%d" % (k, v) for k, v in sorted(self.rates.items()) if v)
        return "\n".join((
            "  bandwidth check (8N1, 10 bits/byte):",
            "    link capacity         %6d baud -> %7.0f B/s" % (
                self.baud, self.capacity_bps),
            "    %-22s %5.1f Hz -> %7.0f B/s  %6.1f%%  (%s)" % (
                on or "nothing enabled", self.hz, self.now_bps, self.now_pct,
                self.sky_note),
            "    %-22s %5s    -> %7.0f B/s  %6.1f%%  (ceiling)" % (
                "all constellations", "", self.ceiling_bps, self.ceiling_pct),
        ))


def budget(rates, baud, hz, sats_now, constellations):
    """Two operating points, because one number cannot do both jobs.

    At the ceiling the vendor's own factory default -- all eight sentences,
    1 Hz, 9600 baud (§6 Appendix C) -- computes to 238% and would be refused. At
    a realistic sky it is 95.6%, which both passes and explains why the vendor
    ships 1 Hz rather than faster. So "sky now" is the hard error and the
    ceiling is the headroom warning.

    The substitution for an uncountable sky happens HERE rather than at the call
    site, so that no caller can price a projection without it and none can lose
    track of which talkers were assumed. That provenance travels on the Budget.
    """
    talkers = talkers_for(constellations)
    sats, assumed = projected_sky(sats_now, constellations)
    now = epoch_bytes(rates, sats, talkers) * hz
    ceiling = epoch_bytes(rates, TALKER_CEILING, talkers) * hz
    return Budget(rates, baud, hz, now, ceiling, assumed)


