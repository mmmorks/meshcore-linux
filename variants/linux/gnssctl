def OptInt(lo, hi):
    """A $PCAS03 rate field.

    None encodes as empty, which the spec defines as "keep the previous
    configuration" (§2.3.3) -- distinct from 0, "no output". Collapsing the two
    would silently rewrite the seven sentences a caller did not name.
    """
    codec = TextCodec("OptInt", 1, as_int=True)
    codec.lo, codec.hi = lo, hi
    return codec


