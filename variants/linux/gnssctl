def _mode_flags(mode):
    """Decode CFG-PRT <Mode> into a '8N1'-style string (§3.2.2.1 Table 10)."""
    bits = {0: "5", 1: "6", 2: "7", 3: "8"}[(mode >> 6) & 3]
    par = (mode >> 9) & 7
    # Table 10's rows are not mutually exclusive as written: x1x (Reserved)
    # overlaps 10x (None), so Reserved has to be tested first or 110 and 111
    # read as a real parity setting.
    if par & 2:
        parity = "?"
    elif par & 4:
        parity = "N"
    elif par == 1:
        parity = "O"
    else:
        parity = "E"
    stop = {0: "1", 1: "1.5", 2: "2"}.get((mode >> 12) & 3, "?")
    return bits + parity + stop


class Field:
    __slots__ = ("name", "codec", "bits", "enum", "unit", "_describe")

    def __init__(self, name, codec, bits=None, enum=None, unit=None,
                 describe=None):
        self.name = name
        self.codec = codec
        self.bits = bits
        self.enum = enum
        self.unit = unit
        self._describe = describe

    def describe(self, value):
        # Declared per-field rather than matched on the field's name: the
        # whole point of the table is that a message's behaviour is
        # declared once, in the table, and nowhere else.
        if self._describe is not None:
            return self._describe(value)
        if self.bits:
            return [label for bit, label in self.bits if value & (1 << bit)]
        if self.enum:
            return self.enum.get(value, value)
        return value


class Message:
    """One CASIC message, declared once as its spec field table.

    build() and parse() are both driven by that table, so an encoder and a
    decoder cannot drift apart -- which is the whole reason the tables are data
    rather than hand-written pack/unpack pairs.
    """

    def __init__(self, name, cls, mid, *fields):
        self.name = name
        self.cls = cls
        self.mid = mid
        self.fields = fields
        self.size = sum(f.codec.size for f in fields)

    @property
    def key(self):
        return (self.cls, self.mid)

    def build(self, **kw):
        out = bytearray()
        for f in self.fields:
            if f.name not in kw:
                raise ValueError("%s: missing field %s" % (self.name, f.name))
            try:
                out += f.codec.pack(kw[f.name])
            except struct.error as exc:
                raise ValueError("%s.%s: %s" % (self.name, f.name, exc))
        extra = set(kw) - {f.name for f in self.fields}
        if extra:
            raise ValueError("%s: unknown field(s) %s" % (self.name, ", ".join(sorted(extra))))
        if len(out) % 4:
            raise ValueError("%s: payload %d bytes, not a multiple of 4 (§3.1)"
                             % (self.name, len(out)))
        return bytes(out)

    def parse(self, payload):
        # Short is fatal, long is not. This receiver emits payloads longer than
        # the spec documents (an undocumented 44-byte CFG-PPS was observed on
        # the same part), and refusing those would turn a readable reply into
        # "no answer". Trailing bytes past the declared fields are therefore
        # ignored, not an error.
        if len(payload) < self.size:
            raise ValueError("%s: payload %d bytes, need %d"
                             % (self.name, len(payload), self.size))
        out = {}
        off = 0
        for f in self.fields:
            out[f.name] = f.codec.unpack(payload[off:off + f.codec.size])
            off += f.codec.size
        return out

    def describe(self, payload):
        raw = self.parse(payload)
        return {f.name: f.describe(raw[f.name]) for f in self.fields}


