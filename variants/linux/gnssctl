#!/usr/bin/env python3
"""gnssctl - read and configure the GNSS receiver on this node.

  gnssctl                     interactive REPL
  gnssctl show                current configuration and fix
  gnssctl set rate 5hz        change a setting, verified
  gnssctl --selftest          unit tests; touches no hardware

Protocol source: Quectel L76K GNSS Protocol Specification V1.1. Section marks
(§) throughout this file refer to it.
"""
import struct
import sys

_FAILS = []


class Codec:
    """One CASIC data type (§3.1.1, Table 4).

    Little-endian throughout: the spec's worked frames encode Len, BaudRate and
    the checksum little-endian (e.g. CFG-RATE 1000 ms as 'E8 03 00 00', §3.2.2.4).
    """

    __slots__ = ("name", "size", "_fmt")

    def __init__(self, name, size, fmt):
        self.name = name
        self.size = size
        self._fmt = "<" + fmt

    def pack(self, value):
        return struct.pack(self._fmt, value)

    def unpack(self, raw):
        return struct.unpack(self._fmt, raw[:self.size])[0]

    def __repr__(self):
        return "<%s>" % self.name


