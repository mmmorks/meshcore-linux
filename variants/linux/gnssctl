class TextCodec:
    """One NMEA field, sized from the spec's Format/Description columns.

    max_width feeds the bandwidth model as well as parse/build, so a field's
    documented maximum is stated once and used for all three.
    """

    # "fixed", "lo" and "hi" are left out of __init__ on purpose: they are
    # optional, set only by the factories that need them (Const; OptInt
    # below), and their absence is what lets build() and validation tell an
    # ordinary field apart from one of those via hasattr/getattr rather than
    # a name check.
    __slots__ = ("name", "max_width", "_as_int", "fixed", "lo", "hi")

    def __init__(self, name, max_width, as_int=False):
        self.name = name
        self.max_width = max_width
        self._as_int = as_int

    def decode(self, text):
        if self._as_int:
            return int(text) if text else None
        return text

    def encode(self, value):
        if value is None:
            return ""
        return str(value)


def Num(widest):
    """A numeric field bounded by the widest value the spec permits."""
    return TextCodec("Num", len(widest))


def IntC(width):
    return TextCodec("Int", width, as_int=True)


def EnumC(*values):
    return TextCodec("Enum", max(len(v) for v in values))


def Const(text):
    c = TextCodec("Const", len(text))
    c.fixed = text
    return c


