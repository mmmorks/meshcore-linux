def nmea_checksum(body):
    """The 8-bit XOR of everything between '$' and '*', exclusive (§2.1)."""
    ck = 0
    for byte in body.encode("ascii"):
        ck ^= byte
    return "%02X" % ck


def nmea_wrap(body):
    return ("$%s*%s\r\n" % (body, nmea_checksum(body))).encode("ascii")


def nmea_split(line):
    """(body, checksum_ok) for '$BODY*CS'; (None, False) if not a sentence.

    rpartition, not partition: no standard sentence carries a '*' in its data,
    but $GPTXT's <TextMsg> is free text (§2.2.7) and splitting on the first one
    would corrupt any message containing it.
    """
    text = line.strip()
    if not text.startswith("$") or "*" not in text:
        return None, False
    body, _, given = text[1:].rpartition("*")
    if not body:
        return None, False
    return body, given.strip().upper() == nmea_checksum(body)


class Frame:
    __slots__ = ("framing", "cls", "mid", "payload")

    def __init__(self, framing, cls, mid, payload):
        self.framing = framing
        self.cls = cls
        self.mid = mid
        self.payload = payload

    @property
    def key(self):
        return (self.cls, self.mid)

    def __repr__(self):
        return "<%s %02x-%02x len %d>" % (
            self.framing, self.cls, self.mid, len(self.payload))


class Framing:
    """One binary protocol: sync bytes, field order, checksum.

    The two layouts are NOT interchangeable.

    "casic" -- what this receiver answers to (§3.1):

        sync(2) len(U2 LE) class(1) id(1) payload ck(U4 LE)
        ck = (id << 24) + (class << 16) + len, then += each LE u32 of payload

    "ubx" -- u-blox, and Allystar which copies it byte for byte apart from the
    sync pair. What this receiver *emits*:

        sync(2) class(1) id(1) len(U2 LE) payload ck_a ck_b   (8-bit Fletcher)

    Length precedes class/id in CASIC and follows it in u-blox, so reading a
    CASIC frame with the u-blox layout consumes class+id as the length and gets
    nonsense. The layout therefore travels with the framing and is never assumed.
    """

    def __init__(self, name, sync, layout):
        self.name = name
        self.sync = sync
        self.layout = layout
        self.header_len = 6
        self.trailer_len = 2 if layout == "ubx" else 4

    def payload_len(self, buf):
        if self.layout == "ubx":
            return int.from_bytes(buf[4:6], "little")
        return int.from_bytes(buf[2:4], "little")

    def frame_len(self, n):
        return self.header_len + n + self.trailer_len

    def plausible(self, n):
        if n > 4096:
            return False
        if self.layout == "casic" and n % 4:
            return False
        return True

    def _casic_ck(self, cls, mid, payload):
        ck = (mid << 24) + (cls << 16) + len(payload)
        for i in range(0, len(payload), 4):
            ck = (ck + int.from_bytes(payload[i:i + 4], "little")) & 0xFFFFFFFF
        return ck

    def encode(self, cls, mid, payload=b""):
        if self.layout == "ubx":
            body = bytes([cls, mid]) + len(payload).to_bytes(2, "little") + payload
            ck_a = ck_b = 0
            for byte in body:
                ck_a = (ck_a + byte) & 0xFF
                ck_b = (ck_b + ck_a) & 0xFF
            return self.sync + body + bytes([ck_a, ck_b])
        if len(payload) % 4:
            raise ValueError("CASIC payload must be a multiple of 4 bytes (§3.1)")
        return (self.sync + len(payload).to_bytes(2, "little") + bytes([cls, mid])
                + payload + self._casic_ck(cls, mid, payload).to_bytes(4, "little"))

    def decode(self, frame):
        """(cls, mid, payload), or None if the checksum fails."""
        n = self.payload_len(frame)
        if self.layout == "ubx":
            body = frame[2:6 + n]
            ck_a = ck_b = 0
            for byte in body:
                ck_a = (ck_a + byte) & 0xFF
                ck_b = (ck_b + ck_a) & 0xFF
            if (ck_a, ck_b) != (frame[6 + n], frame[7 + n]):
                return None
            return frame[2], frame[3], frame[6:6 + n]
        cls, mid = frame[4], frame[5]
        payload = frame[6:6 + n]
        if self._casic_ck(cls, mid, payload) != int.from_bytes(
                frame[6 + n:10 + n], "little"):
            return None
        return cls, mid, payload


