                           b"$BDGSV,1,1,05,01,43,135,36,0*45\r\n"
                           ).constellations == frozenset(("GPS", "BDS")))
    check("the gpsd defaults parser takes the first device",
          lambda: _parse_gpsd_defaults('DEVICES="/dev/ttyAMA0 /dev/ttyS0"\n')
                  == "/dev/ttyAMA0")
    check("the gpsd defaults parser ignores non-device values",
          lambda: _parse_gpsd_defaults('DEVICES=""\nGPSD_OPTIONS="-n"\n') is None)
    check("every baud candidate has a termios constant",
          lambda: all(b in BAUD_CONST for b in BAUD_CANDIDATES))

    print("")
    print("session structure (the read-only guarantee):")
    # Asserted off the syntax tree rather than off a list of forbidden method
    # names: the property is "only these functions transmit", and a name
    # blacklist is satisfied by anything called something else.
    #
    # _init_sequence is the sixth entry, added by deliberate human ruling,
    # not drift: init needs a primitive blind send at two candidate speeds
    # followed by one deliberate readback, and routing that through
    # Session.apply() (the general path everything else here transmits
    # through) cost four extra frames -- an unwanted CFG-RATE probe and
    # CFG-PRT confirm on every apply(SetBaud(...)) call -- and put a
    # boot-path fix-rate change under apply()'s bandwidth guard evaluating
    # an unobservable sky at 99.2% of capacity, 0.8% of margin from
    # silently declining to raise the rate with no diagnosable symptom.
    # _init_sequence's own CFG-PRT readback already establishes the
    # condition that makes that rate safe, so the guard was redundant here,
    # not merely inconvenient. Keep this set exact -- six named functions,
    # not a prefix rule or a blanket exemption for "boot path" code.
    check("only the declared transmit paths can reach the wire",
          lambda: _write_sites() == {"write", "poll", "apply", "_exchange",
                                     "_probe_binary", "_init_sequence"})
    check("Session.poll takes only an index",
          lambda: Session.poll.__code__.co_varnames[:2] == ("self", "n"))
    check("no binary poll carries a payload",
          lambda: all(p.payload == b"" for p in POLLS if p.kind == "bin"))
    check("the only NMEA poll is a query, never a setter",
          lambda: all(p.payload.startswith("PCAS06")
                      for p in POLLS if p.kind == "nmea"))
    check("every poll entry is well formed",
          lambda: all(p.kind in ("bin", "nmea") and p.label and p.why for p in POLLS))
    check("apply raises on a read-only session",
          lambda: _raises(lambda: Session(None, allow_apply=False)
                          .apply(SetRate(200)), PermissionError))
    check("apply refuses anything that is not a declared Change",
          lambda: _raises(lambda: Session(None, allow_apply=True)
                          .apply(("CFG-RATE", b"\xf4\x01\x00\x00")), TypeError))
    check("every Change subclass is reachable from the closed set",
          lambda: set(CHANGES) == _all_subclasses(Change)
                  == {SetBaud, SetRate, SetSentences, SetConstellation, Restart})
    check("a session scans every framing, not only the one it asks in",
          lambda: set(Session(None).scanners) == {f.name for f in ALL_FRAMINGS})

    print("")
    print("change construction:")
    check("SetBaud emits the documented $PCAS01 sentence",
          lambda: SetBaud(115200).sentences() == [b"$PCAS01,5*19\r\n"])
    check("SetRate emits the documented $PCAS02 sentence",
          lambda: SetRate(200).sentences() == [b"$PCAS02,200*1D\r\n"])
    check("SetConstellation maps GPS+BeiDou+GLONASS to mode 7",
          lambda: SetConstellation(frozenset(("GPS", "BDS", "GLO"))).sentences()
                  == [nmea_wrap("PCAS04,7")])
    check("SetSentences changes only what it was given",
          lambda: SetSentences({"GSV": 1}).sentences()
                  == [nmea_wrap("PCAS03,,,,1,,,,,0,0,,,0,0")])
    check("a cold restart requires --yes, a hot one does not",
          lambda: Restart("cold").needs_yes and not Restart("hot").needs_yes)
    check("a factory restart requires --yes",
          lambda: Restart("factory").needs_yes)
    check("SetBaud rejects an undocumented speed",
          lambda: _raises(lambda: SetBaud(230400), ValueError))
    check("SetRate rejects an interval the spec does not list (§3.2.2.4)",
          lambda: _raises(lambda: SetRate(100), ValueError))
    check("SetSentences rejects a rate outside 0-9 (§2.3.3)",
          lambda: _raises(lambda: SetSentences({"GSV": 11}), ValueError))
    # TXT is a standard sentence but $PCAS03 has no field for it -- the antenna
    # status arrives as a $GPTXT (§2.2.7) and is configured under <nANT>. A
    # validator listing sentence names rather than reading the command's own
    # field table would accept it here and fail in build() instead.
    check("SetSentences rejects a sentence $PCAS03 cannot address",
          lambda: _raises(lambda: SetSentences({"TXT": 1}), ValueError)
                  and _raises(lambda: SetSentences({"NOPE": 1}), ValueError))
    check("SetConstellation rejects a combination the spec does not list (§2.3.4)",
          lambda: _raises(lambda: SetConstellation(("GPS", "GAL")), ValueError))
    check("Restart rejects an undocumented kind (§2.3.5)",
          lambda: _raises(lambda: Restart("lukewarm"), ValueError))

    print("")
    print("guard inputs (inference, not measurement):")
    # Two epochs of a three-constellation sky with everything at rate 1. The
    # raw counts are not epochs: GSV takes 8 sentences per fix here and GSA 3,
    # and dividing by the declared multiplicity is what recovers the rate. Read
    # straight off the counts, so the arithmetic is what is under test rather
    # than the wire.
    _2EP = {"GPGSV": 6, "BDGSV": 6, "GLGSV": 4, "GNGSA": 6,
            "GNRMC": 2, "GNGGA": 2, "GNVTG": 2, "GNZDA": 2}
    _3C = {"GP": 12, "BD": 10, "GL": 8}
    check("rates are inferred per fix, not per sentence",
          lambda: Session(None).current_rates(_sky(_2EP, _3C))
                  == {"GSV": 1, "GSA": 1, "RMC": 1, "GGA": 1, "VTG": 1, "ZDA": 1})
    check("a sentence's talkers are summed, not overwritten",
          lambda: Session(None).current_rates(
              _sky({"GPGSV": 3, "BDGSV": 3, "GLGSV": 2, "GNRMC": 1}, _3C))["GSV"] == 1)
    check("an unobservable sky is unknown, not empty",
          lambda: Session(None).current_constellations(_sky({"GNRMC": 1}, {}))
                  == ALL_CONSTELLATIONS
                  and Session(None).current_constellations(_sky({}, {"GP": 6}))
                  == frozenset(("GPS",)))
    check("a talker with nothing to count is priced at the ceiling, not zero",
          lambda: (lambda sats, assumed: sats == TALKER_CEILING
                   and assumed == frozenset(TALKER_CEILING))(
              *projected_sky({}, ALL_CONSTELLATIONS))
          and (lambda sats, assumed: sats["GP"] == 6 and "GP" not in assumed)(
              *projected_sky({"GP": 6}, ALL_CONSTELLATIONS)))
    # The measured case: enabling GSV on a node that shows only $GNRMC. Priced
    # against the observed sky, GSV costs zero and both operating points go
    # blind together, so the change is approved on the way to muting the node.
    check("enabling GSV is priced even where GSV is what would reveal the sky",
          lambda: (lambda blind, seen: blind.ok and 40.0 < blind.now_pct < 41.0
                   and not seen.ok)(
              budget({"RMC": 1, "GSV": 1}, 9600, 5.0, {}, frozenset()),
              budget({"RMC": 1, "GSV": 1}, 9600, 5.0, {}, ALL_CONSTELLATIONS)))
    # ...but the price of that is a number nobody measured, and a report that
    # calls it "sky now" claims a measurement that never happened.
    check("a budget says whether its sky was measured or assumed",
          lambda: (lambda seen, blind:
                   seen.measured and not seen.assumed
                   and "(sky now)" in seen.render()
                   and not blind.measured
                   and blind.assumed == frozenset(("GP", "GL", "BD"))
                   and "sky assumed for BD+GL+GP" in blind.render()
                   and "(sky now)" not in blind.render())(
              budget(_ALL8, 9600, 1, _SKY, _T3),
              budget({"RMC": 1, "GSV": 1}, 9600, 1.0, {}, ALL_CONSTELLATIONS)))
    check("a refusal on an assumed sky says so and names the escape",
          lambda: (lambda p, v: v.status == "refused"
                   and "assumed, not measured" in v.detail
                   and "--force" in v.detail)(
              *_apply_on_quiet_port(SetSentences({"GSV": 1}), sky=_NO_GSV)))

    print("")
    print("poll (against a recording port, no hardware):")
    # The one poll this hardware is known to answer, and its reply is a $GPTXT
    # (§2.2.7 -- SW= is the software field, not a part number). Filtering
    # replies against STANDARD_SENTENCES would discard it and report the
    # working poll as silence.
    _VER = "GPTXT,01,01,02,SW=URANUS5,V5.3.0.0"
    _NMEA_POLL = [i for i, p in enumerate(POLLS) if p.kind == "nmea"]
    check("there is exactly one NMEA poll", lambda: len(_NMEA_POLL) == 1)
    check("the $PCAS06 poll collects the $GPTXT it exists to collect",
          lambda: (lambda p, r: p.writes == [nmea_wrap("PCAS06,0")]
                   and r.outcome == "reply"
                   and r.detail["sentences"] == [nmea_wrap(_VER).decode().strip()])(
              *_poll_on_quiet_port(
                  _NMEA_POLL[0],
                  nmea_wrap("GNRMC,071556.000,A,3149.29103,N,11706.92916,E,"
                            "0.00,0.00,250420,,,A,V") + nmea_wrap(_VER))))
    # The whole reason this tool's ancestor existed: a chip may answer a
    # request in a dialect other than the one it was asked in, and scoring that
    # as silence turns "it answered, just not how we expected" into "it does
    # not support this".
    _RATE_POLL = [i for i, p in enumerate(POLLS)
                  if (p.cls, p.mid) == CFG_RATE.key]
    check("a reply in a foreign framing is an answer, not silence",
          lambda: (lambda p, r: r.outcome == "reply" and r.answered_in == "ubx"
                   and r.detail["interval"] == 500)(
              *_poll_on_quiet_port(_RATE_POLL[0],
                                   UBX.encode(*CFG_RATE.key,
                                              CFG_RATE.build(interval=500, res=0)))))
    # ...but a readback is not a detection. Decoding that same frame with the
    # CASIC layout would report a confident wrong number to the guard.
    check("a readback declines a reply framed in another dialect",
          lambda: Session(_FakePort(9600, UBX.encode(
              *CFG_RATE.key, CFG_RATE.build(interval=500, res=0))),
              timeout=_TEST_WINDOW).get(CFG_RATE) is None)

    print("")
    print("apply (against a recording port, no hardware):")
    check("the bandwidth guard refuses before anything is written",
          lambda: (lambda p, v: v.status == "refused" and p.writes == []
                   and v.budget is not None and not v.budget.ok)(
              *_apply_on_quiet_port(SetRate(200))))
    check("a cold restart without --yes writes nothing",
          lambda: (lambda p, v: v.status == "refused" and p.writes == [])(
              *_apply_on_quiet_port(Restart("cold"))))
    check("a change the budget does not object to reaches the port",
          lambda: (lambda p, v: p.writes == [b"$PCAS10,0*1C\r\n"]
                   and v.status == "unconfirmed")(
              *_apply_on_quiet_port(Restart("hot"))))
    # SetBaud.confirm re-clocks the port before reading back, and tcsetattr can
    # fail. The change is already on the wire by then, so an exception escaping
    # apply() would leave the caller believing nothing was written.
    check("a readback that fails does not erase the write",
          lambda: (lambda p, v: v.status == "unconfirmed" and p.writes
                   and "readback failed" in v.detail)(
              *_apply_on_quiet_port(_breaking_readback(
                  Restart("hot"), OSError(5, "Input/output error")))))

    print("")
    print("probe reporting:")
    check("a read-only session is what probe builds",
          lambda: _raises(lambda: _probe_session().apply(SetRate(200))))
    check("the report names every framing it scanned",
          lambda: all(f.name in render_probe(Observation(9600), [], "/dev/null")
                      for f in ALL_FRAMINGS))
    check("a silent phase 2 is stated, not omitted",
          lambda: "no transmittable framing" in render_probe(
              Observation(9600), [], "/dev/null"))
    check("the JSON carries the raw window so silence is falsifiable",
          lambda: "raw_head_hex" in probe_json(Observation(9600), [], "/dev/null"))
    # PROBE_ORDER is pure and has no I/O dependency, but it is the whole
    # expression in code of the finding this tool exists for -- CASIC is what
    # this receiver answers, never what it emits, so it goes first
    # unconditionally rather than being inferred from what phase 1 saw on the
    # wire. Pinned here so an accidental reordering (or an ALL_FRAMINGS that
    # stops starting with CASIC) fails the suite instead of only a live probe.
    check("the sweep tries CASIC first, then every other framing",
          lambda: PROBE_ORDER[0] is CASIC
                  and set(PROBE_ORDER) == set(ALL_FRAMINGS)
                  and len(PROBE_ORDER) == len(ALL_FRAMINGS))

    # render_probe's per-poll branch (everything but the "no sweeps"
    # fallback) has no coverage above: both checks so far pass sweeps=[].
    # ProbeResult built directly rather than through a fake port -- what is
    # under test is the rendering, not the wire.
    _BIN_POLLS = [p for p in POLLS if p.kind == "bin"]
    _MIXED_SWEEP = [
        ProbeResult(_BIN_POLLS[0], "reply", {"baudRate": 9600},
                   answered_in=CASIC.name),
        ProbeResult(_BIN_POLLS[1], "nak"),
        ProbeResult(_BIN_POLLS[2], "silence", window=b"\x00\x01",
                   window_total=137,
                   seen={"casic 06-00": 2, "ubx 0a-04": 1}),
        # A reply that arrived in a framing other than the one being swept --
        # the exact case that matters most: scoring it as silence would turn
        # "it answered, just not how we expected" into "not supported".
        ProbeResult(_BIN_POLLS[3], "reply", {"note": "cross-framing"},
                   answered_in=UBX.name),
    ]
    _MIXED_REPORT = render_probe(Observation(9600), [(CASIC, _MIXED_SWEEP)],
                                 "/dev/null")
    check("every poll's label appears, and a reply's decoded fields render",
          lambda: all(p.label in _MIXED_REPORT for p in _BIN_POLLS[:4])
                  and "baudRate=9600" in _MIXED_REPORT)
    check("a NAK renders as unsupported, not folded into silence",
          lambda: "not supported on this chip" in _MIXED_REPORT)
    check("a silence line reports both its byte count and its frame tally",
          lambda: "137 bytes arrived" in _MIXED_REPORT
                  and "casic 06-00 x2" in _MIXED_REPORT)
    check("a reply answered outside the swept framing is annotated",
          lambda: "ANSWERED IN UBX FRAMING" in _MIXED_REPORT)
    # ...and the mirror image: a wall of refusals, which is what a u-blox
    # emulation layer produces and is exactly what must NOT read as success --
    # it is what makes cmd_probe try the next framing instead of stopping.
    check("an all-NAK sweep is not productive -- that is what triggers the fallback",
          lambda: not productive([ProbeResult(p, "nak") for p in _BIN_POLLS]))

    print("")
    print("show and monitor rendering:")
    _OBS = _observe(b"$GPGSV,1,1,07,02,49,123,43,0*5A\r\n"
                    b"$GNGGA,071556.000,3149.29103,N,11706.92916,E,1,21,0.7,"
                    b"75.7,M,-5.0,M,,*69\r\n"
                    b"$GNGSA,A,3,10,13,15,20,,,,,,,,,2.5,2.0,1.5,1*35\r\n")
    # The brief's own "3D" in text or "fix" in text is a near-tautology --
    # render_show prints the labels "fix interval" and "fix type"
    # unconditionally, so it would pass even with the whole GSA/GGA block
    # deleted. Replaced with the actual decoded, translated values: if any
    # of quality/fix-mode translation, DOP or satellite count broke, this
    # fails.
    check("show reports the translated fix mode, quality, DOP triple and "
          "satellite count decoded from GSA/GGA",
          lambda: (lambda text: "3 (3D)" in text
                   and "1 (GPS SPS mode, fix valid)" in text
                   and "2.5 / 2.0 / 1.5" in text
                   and "21" in text)(render_show(None, _OBS)))
    check("show reports satellites used and HDOP",
          lambda: "21" in render_show(None, _OBS) and "0.7" in render_show(None, _OBS))
    # Likewise "observed" in text alone is near-tautological -- the sentence
    # rates line always carries "[observed: ...]" regardless of whether GGA/
    # GSA ever parsed. Pinned against BOTH halves of the provenance split
    # together: the two Gets marked not-read-back (session=None) and the
    # inferred rates marked observed, with their actual values.
    check("without a session, the readbacks are marked not-read-back and "
          "the sentence rates are marked observed, together and concretely",
          lambda: (lambda text: "no CFG-PRT reply" in text
                   and "no CFG-RATE reply" in text
                   and "GGA@1, GSA@1, GSV@2" in text
                   and "[observed: tallied from the wire" in text)(
              render_show(None, _OBS)))
    # A field genuinely absent from the wire (not merely a documented "0")
    # must render as unknown, not as though some code -- least of all 0,
    # itself a real documented value -- were present.
    _OBS_NO_QUALITY = _observe(nmea_wrap(
        "GNGGA,071556.000,3149.29103,N,11706.92916,E,,21,0.7,75.7,M,-5.0,M,,"))
    check("a GGA quality field absent from the wire renders as unknown, "
          "not a fabricated code",
          lambda: any("quality" in l and "unknown" in l for l in
                     render_show(None, _OBS_NO_QUALITY).splitlines()))
    check("the sky table lists a satellite with its elevation and C/N0",
          lambda: all(t in render_sky(_OBS) for t in ("02", "49", "43")))
    check("an empty observation renders without raising",
          lambda: isinstance(render_show(None, Observation(9600)), str))

    # GGA_QUALITY and GSA_FIX_MODE pinned against the spec's own tables
    # (§2.2.2, §2.2.4) -- gaps (3/4/5/7+ for quality) are deliberate, not an
    # oversight, and this fails loudly if one is ever "helpfully" filled in
    # from generic NMEA-0183 knowledge the receiver's own spec does not claim.
    check("GGA_QUALITY and GSA_FIX_MODE match exactly the codes the spec "
          "documents, no more",
          lambda: GGA_QUALITY == {0: "fix not available or invalid",
                                  1: "GPS SPS mode, fix valid",
                                  2: "differential GPS/SBAS, fix valid",
                                  6: "estimated (dead reckoning) mode"}
                  and GSA_FIX_MODE == {1: "fix not available", 2: "2D", 3: "3D"})
    check("a documented code shows the raw number next to its text",
          lambda: _render_code(GGA_QUALITY, 2) == "2 (differential GPS/SBAS, "
                                                    "fix valid)")
    check("an undocumented code is marked undocumented, not silently mapped "
          "to something",
          lambda: _render_code(GGA_QUALITY, 5) == "5 (undocumented code)"
                  and _render_code(GSA_FIX_MODE, 9) == "9 (undocumented code)"
                  and _render_code(GGA_QUALITY, None) == "unknown")
    check("show renders the documented quality/fix-mode text next to the "
          "raw code",
          lambda: "1 (GPS SPS mode, fix valid)" in render_show(None, _OBS)
                  and "3 (3D)" in render_show(None, _OBS))

    check("render_sky renders without raising when nothing has been observed",
          lambda: isinstance(render_sky(Observation(9600)), str))
    # NmeaCollector.records keeps only the LAST parsed sentence per talker,
    # which for a multi-line GSV group (§2.2.3) is at most four satellites --
    # one line's worth. A real sky of more than four needs several lines, so
    # a sky table built from records["GSV"] directly would show at most four
    # satellites no matter how many are in view. obs.sky exists precisely to
    # not do that; this pins the accumulation across _EPOCH's three-line group.
    check("a satellite reported across multiple GSV lines is not lost to the "
          "last line's overwrite",
          lambda: set(_observe(_EPOCH).sky.get("GP", {})) == {"02", "05", "06"})

    # A group's own <SenNum> 1 line can go missing mid-session the same way
    # any other sentence can (NmeaCollector.feed's own try/except exists
    # because truncation is routine) -- and unlike session start-up, there
    # IS a previous, completed group sitting in `sky` here for a naive
    # implementation to merge onto. Group A completes normally; group B's
    # first line is simply never sent, only its second (and last).
    check("a group whose first line is missing does not merge its lone "
          "sentence onto the previous, now-stale group",
          lambda: set(_observe(
              nmea_wrap("GPGSV,1,1,04,02,49,123,43,0")     # group A, complete
              + nmea_wrap("GPGSV,2,2,08,06,10,050,20,0")   # group B, part 1 missing
          ).sky.get("GP", {})) == {"06"})

    _MIXED_SKY = _observe(
        nmea_wrap("GPGSV,1,1,08,10,49,123,43,02,30,050,22,0")
        + nmea_wrap("GNGSA,A,3,10,13,15,20,,,,,,,,,2.5,2.0,1.5,1"))
    check("the sky table's used column reflects GSA, not just whichever "
          "satellite GSV happens to list",
          lambda: (lambda lines:
                   any("GP" in l and "10" in l and "yes" in l for l in lines)
                   and any("GP" in l and "02" in l and "yes" not in l
                          for l in lines))(render_sky(_MIXED_SKY).splitlines()))

    # The session=None checks above cover the observed section; this covers
    # the other half -- that a session which CAN answer is labelled
    # "readback", distinctly from both "observed" and an unanswered Get.
