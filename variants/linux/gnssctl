def check(name, fn):
    """Record one assertion.

    Takes a thunk rather than a value on purpose. A check written before the
    function it exercises exists must report FAIL and let the rest of the suite
    run -- evaluating eagerly would raise NameError and abort the whole file,
    which makes red-green cycles impossible in a single-file script.
    """
    try:
        ok = bool(fn())
    except Exception as exc:
        print("  FAIL %s [%s: %s]" % (name, type(exc).__name__, exc))
        _FAILS.append(name)
        return
    print(("  ok   " if ok else "  FAIL ") + name)
    if not ok:
        _FAILS.append(name)


def _raises(fn):
    try:
        fn()
    except Exception:
        return True
    return False


def _scan(framing, *chunks):
    sc = Scanner(framing)
    for chunk in chunks:
        sc.feed(chunk)
    return sc.take()


def selftest():
    del _FAILS[:]
    print("gnssctl --selftest")
    print("")
    print("data types (§3.1.1 Table 4):")
    check("U1 is one byte", lambda: U1.size == 1)
    check("I1 is one byte", lambda: I1.size == 1)
    check("U2 is two bytes", lambda: U2.size == 2)
    check("I2 is two bytes", lambda: I2.size == 2)
    check("U4 is four bytes", lambda: U4.size == 4)
    check("I4 is four bytes", lambda: I4.size == 4)
    check("R4 is four bytes", lambda: R4.size == 4)
    check("R8 is eight bytes", lambda: R8.size == 8)
    check("U2 packs little-endian",
          lambda: U2.pack(1000) == b"\xe8\x03")
    check("U4 packs little-endian",
          lambda: U4.pack(9600) == b"\x80\x25\x00\x00")
    check("I1 is two's complement (§3.1.1 'Complement')",
          lambda: I1.pack(-1) == b"\xff" and I1.unpack(b"\xff") == -1)
    check("every integer type round-trips",
          lambda: all(c.unpack(c.pack(v)) == v
                      for c, v in ((U1, 255), (I1, -128), (U2, 65535),
                                   (I2, -32768), (U4, 4294967295), (I4, -1))))

    print("")
    print("NMEA framing against the spec's own examples (§2.2, §2.3):")
    check("all 20 vendor checksums verify",
          lambda: [s for s in SPEC_NMEA
                   if nmea_checksum(s.rsplit("*", 1)[0]) != s.rsplit("*", 1)[1]] == [])
    check("wrap produces the sentence gnss-set-baud sent",
          lambda: nmea_wrap("PCAS01,5") == b"$PCAS01,5*19\r\n")
    check("split round-trips a wrapped sentence",
          lambda: nmea_split(nmea_wrap("PCAS02,1000").decode()) == ("PCAS02,1000", True))
    check("split rejects a corrupted checksum",
          lambda: nmea_split("$PCAS01,5*1A") == ("PCAS01,5", False))
    check("split rejects a line that is not a sentence",
          lambda: nmea_split("garbage") == (None, False))
    check("checksum covers neither $ nor * (§2.1)",
          lambda: nmea_checksum("GPTXT,01,01,02,MA=CASIC") == "27")

    print("")
    print("CASIC framing against the spec's own frames (§3.1, §3.2):")
    check("the CFG-PRT Get poll matches the spec byte for byte",
          lambda: CASIC.encode(0x06, 0x00) == bytes.fromhex(SPEC_CASIC["CFG-PRT get"]))
    check("the CFG-MSG Get poll matches the spec byte for byte",
          lambda: CASIC.encode(0x06, 0x01) == bytes.fromhex(SPEC_CASIC["CFG-MSG get"]))
    check("the CFG-RATE Get poll matches the spec byte for byte",
          lambda: CASIC.encode(0x06, 0x04) == bytes.fromhex(SPEC_CASIC["CFG-RATE get"]))
    check("every vendor frame decodes with a valid checksum",
          lambda: [k for k, v in SPEC_CASIC.items()
                   if CASIC.decode(bytes.fromhex(v)) is None] == [])
    check("the CFG-PRT UART0 response decodes to the documented payload",
          lambda: CASIC.decode(bytes.fromhex(SPEC_CASIC["CFG-PRT resp UART0"]))
                  == (0x06, 0x00, bytes.fromhex("00ffc00880250000")))
    check("a corrupted checksum is rejected",
          lambda: CASIC.decode(bytes.fromhex(SPEC_CASIC["CFG-RATE resp"])[:-1] + b"\xff")
                  is None)
    check("length is read from offset 2 in CASIC and offset 4 in u-blox",
          lambda: CASIC.payload_len(bytes.fromhex(SPEC_CASIC["CFG-PRT resp UART0"])) == 8
                  and UBX.payload_len(UBX.encode(0x06, 0x00, b"\x01\x02")) == 2)
    check("a payload that is not a multiple of 4 is refused (§3.1)",
          lambda: _raises(lambda: CASIC.encode(0x06, 0x00, b"\x01")))
    check("u-blox and Allystar differ only in their sync bytes",
          lambda: ALLY.encode(0x06, 0x0C)[2:] == UBX.encode(0x06, 0x0C)[2:])

    print("")
    print("scanner:")
    _f = CASIC.encode(0x06, 0x04, bytes.fromhex("e8030000"))
    check("one clean frame", lambda: len(_scan(CASIC, _f)) == 1)
    check("garbage before a frame", lambda: len(_scan(CASIC, b"\x00\xff\x12junk" + _f)) == 1)
    check("frame split across two reads",
          lambda: _scan(CASIC, _f[:5], _f[5:]) and len(_scan(CASIC, _f[:5], _f[5:])) == 1)
    check("sync pair straddling two reads",
          lambda: len(_scan(CASIC, b"\xba", b"\xce" + _f[2:])) == 1)
    check("sync bytes inside a payload do not truncate the frame",
          lambda: [fr.payload for fr in
                   _scan(CASIC, CASIC.encode(0x06, 0x04, b"\xba\xce\xba\xce"))]
                  == [b"\xba\xce\xba\xce"])
    check("a bad frame is skipped and the next one still found",
          lambda: len(_scan(CASIC, bytes(bytearray(_f[:-1]) + b"\xff") + _f)) == 1)

    print("")
    print("CASIC message tables (§3.2):")
    check("CFG-MSG builds the spec's GGA-enable frame",
          lambda: CASIC.encode(CFG_MSG.cls, CFG_MSG.mid,
                               CFG_MSG.build(clsID=0x4E, msgID=0x00, rate=1))
                  == bytes.fromhex(SPEC_CASIC["CFG-MSG set GGA"]))
    check("CFG-RATE builds the spec's 2 Hz frame",
          lambda: CASIC.encode(CFG_RATE.cls, CFG_RATE.mid,
                               CFG_RATE.build(interval=500, res=0))
                  == bytes.fromhex(SPEC_CASIC["CFG-RATE set 500"]))
    check("CFG-RST builds the spec's clear-configuration frame",
          lambda: CASIC.encode(CFG_RST.cls, CFG_RST.mid,
                               CFG_RST.build(navBbrMask=0x01FF, resetMode=0, startMode=0))
                  == bytes.fromhex(SPEC_CASIC["CFG-RST clear cfg"]))
    check("CFG-PRT parses the spec's UART0 response (§3.2.2.1 Table 8)",
          lambda: CFG_PRT.parse(bytes.fromhex("00ffc00880250000"))
                  == {"portID": 0, "protoMask": 0xFF, "mode": 0x08C0, "baudRate": 9600})
    check("CFG-RATE parses the spec's 1000 ms response",
          lambda: CFG_RATE.parse(bytes.fromhex("e8030000"))["interval"] == 1000)
    check("ACK-ACK names the message it acknowledges",
          lambda: ACK_ACK.parse(bytes.fromhex("06000000"))["clsID"] == 0x06)
    check("every CASIC payload is a multiple of 4 bytes (§3.1)",
          lambda: all(m.size % 4 == 0 for m in CASIC_MESSAGES.values()))
    check("every message round-trips: parse(build(x)) == x",
          lambda: all(m.parse(m.build(**v)) == v for m, v in (
              (CFG_PRT, {"portID": 1, "protoMask": 0x07, "mode": 0x08C0,
                         "baudRate": 115200}),
              (CFG_MSG, {"clsID": 0x4E, "msgID": 0x03, "rate": 0xFFFF}),
              (CFG_RST, {"navBbrMask": 0x0200, "resetMode": 1, "startMode": 2}),
              (CFG_RATE, {"interval": 200, "res": 0}),
              (ACK_NACK, {"clsID": 0x06, "msgID": 0x0C, "res": 0}))))
    check("build refuses an out-of-range value rather than truncating",
          lambda: _raises(lambda: CFG_MSG.build(clsID=0x4E, msgID=0, rate=70000)))
    check("build refuses a missing field",
          lambda: _raises(lambda: CFG_RATE.build(interval=200)))
    check("mode 0x08C0 describes as 8N1 (§3.2.2.1 Table 10)",
          lambda: CFG_PRT.describe(bytes.fromhex("00ffc00880250000"))["mode"] == "8N1")
    check("protoMask 0xff describes all four protocol bits (Table 9)",
          lambda: set(CFG_PRT.describe(bytes.fromhex("00ffc00880250000"))["protoMask"])
                  == {"binary in", "text in", "binary out", "text out"})
    check("NMEA message IDs use CASIC class 0x4E, not u-blox 0xf0 (Table 5)",
          lambda: NMEA_MSG_ID["GGA"] == (0x4E, 0x00)
                  and NMEA_MSG_ID["ZDA"] == (0x4E, 0x08))
    check("every Table 10 parity encoding decodes, Reserved included",
          lambda: [_mode_flags((0b11 << 6) | (p << 9))[1] for p in range(8)]
                  == ["E", "O", "?", "?", "N", "N", "?", "?"])
    check("describe is declared per field, not matched on the field's name",
          lambda: CFG_PRT.describe(bytes.fromhex("00ffc00880250000"))["mode"] == "8N1"
                  and Field("mode", U2).describe(0x08C0) == 0x08C0)
    check("parse tolerates trailing bytes but refuses a short payload",
          lambda: CFG_RATE.parse(CFG_RATE.build(interval=1000, res=0)
                                 + b"\xde\xad\xbe\xef")["interval"] == 1000
                  and _raises(lambda: CFG_RATE.parse(b"\x01\x02")))

    print("")
    if _FAILS:
        print("%d FAILED: %s" % (len(_FAILS), ", ".join(_FAILS)))
        return 1
    print("all checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(selftest() if "--selftest" in sys.argv[1:] else 0)
