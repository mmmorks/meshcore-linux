class Poll:
    __slots__ = ("label", "kind", "cls", "mid", "payload", "decoder", "why")

    def __init__(self, label, kind, cls, mid, payload, decoder, why):
        self.label = label
        self.kind = kind
        self.cls = cls
        self.mid = mid
        self.payload = payload
        self.decoder = decoder
        self.why = why


