# --------------------------------------------------------------------------
# Framing
# --------------------------------------------------------------------------

class Frame:
    __slots__ = ("framing", "cls", "mid", "payload")

    def __init__(self, framing, cls, mid, payload):
        self.framing = framing
        self.cls = cls
        self.mid = mid
        self.payload = payload

    @property
    def key(self):
        return (self.cls, self.mid)

    def __repr__(self):
        return "<%s %02x-%02x len %d>" % (
            self.framing, self.cls, self.mid, len(self.payload))


class Framing:
    """One binary protocol: sync bytes, field order, checksum.

    Two layouts, and they are NOT interchangeable.

    "ubx" -- u-blox, and Allystar which copies it byte for byte apart from the
    sync pair (driver_allystar.c's opening comment):

        sync(2) class(1) id(1) len(U2 LE) payload ck_a ck_b

    with an 8-bit Fletcher over class..payload inclusive.

    "casic" -- the protocol the Quectel L76K spec documents in section 3.1.
    The length comes BEFORE class/id, not after, and the checksum is a 32-bit
    word sum rather than a Fletcher pair:

        sync(2) len(U2 LE) class(1) id(1) payload ck(U4 LE)

        ck = (id << 24) + (class << 16) + len, then += each LE u32 of payload

    Payload length is always a multiple of 4. Reading a CASIC frame with the
    ubx layout picks up class+id as the length field and gets nonsense, so the
    layout has to travel with the framing rather than being assumed.
    """

    def __init__(self, name, sync, layout):
        self.name = name
        self.sync = sync
        self.layout = layout
        self.can_transmit = True
        self.header_len = 6
        self.trailer_len = 2 if layout == "ubx" else 4

    def payload_len(self, buf):
        """Payload length from a buffer positioned at the sync bytes."""
        if self.layout == "ubx":
            return int.from_bytes(buf[4:6], "little")
        return int.from_bytes(buf[2:4], "little")

    def frame_len(self, n):
        return self.header_len + n + self.trailer_len

    def plausible(self, n):
        if n > 4096:
            return False
        if self.layout == "casic" and n % 4:
            return False
        return True

    def encode(self, cls, mid, payload=b""):
        if self.layout == "ubx":
            body = bytes([cls, mid]) + len(payload).to_bytes(2, "little") + payload
            ck_a = ck_b = 0
            for b in body:
                ck_a = (ck_a + b) & 0xFF
                ck_b = (ck_b + ck_a) & 0xFF
            return self.sync + body + bytes([ck_a, ck_b])
        if len(payload) % 4:
            raise ValueError("CASIC payload must be a multiple of 4 bytes")
        ck = (mid << 24) + (cls << 16) + len(payload)
        for i in range(0, len(payload), 4):
            ck = (ck + int.from_bytes(payload[i:i + 4], "little")) & 0xFFFFFFFF
        return (self.sync + len(payload).to_bytes(2, "little")
                + bytes([cls, mid]) + payload + ck.to_bytes(4, "little"))

    def decode(self, frame):
        """(cls, mid, payload) for a complete frame, or None if the checksum fails."""
        n = self.payload_len(frame)
        if self.layout == "ubx":
            body = frame[2:6 + n]
            ck_a = ck_b = 0
            for b in body:
                ck_a = (ck_a + b) & 0xFF
                ck_b = (ck_b + ck_a) & 0xFF
            if (ck_a, ck_b) != (frame[6 + n], frame[7 + n]):
                return None
            return frame[2], frame[3], frame[6:6 + n]
        cls, mid = frame[4], frame[5]
        payload = frame[6:6 + n]
        ck = (mid << 24) + (cls << 16) + n
        for i in range(0, n, 4):
            ck = (ck + int.from_bytes(payload[i:i + 4], "little")) & 0xFFFFFFFF
        if ck != int.from_bytes(frame[6 + n:10 + n], "little"):
            return None
        return cls, mid, payload


UBX = Framing("ubx", b"\xb5\x62", "ubx")
ALLY = Framing("allystar", b"\xf1\xd9", "ubx")
CASIC = Framing("casic", b"\xba\xce", "casic")

TRANSMIT_FRAMINGS = (ALLY, UBX, CASIC)
ALL_FRAMINGS = (ALLY, UBX, CASIC)


class Scanner:
    """Pulls complete, checksum-valid frames of one framing out of a byte stream.

    The subtle case is a payload that happens to contain the sync pair. This
    resyncs only on checksum failure and otherwise steps over a validated frame
    whole, so interior sync bytes are never examined. Getting that wrong would
    truncate frames and show up as "silence", which reads identically to
    "unsupported" -- the exact confusion this tool exists to avoid.
    """

    def __init__(self, framing):
        self.framing = framing
        self.buf = bytearray()
        self.frames = []
        self.sync_hits = 0
        self.bad_checksums = 0

    def feed(self, data):
        self.buf.extend(data)
        self._drain()

    def _drain(self):
        while True:
            i = self.buf.find(self.framing.sync)
            if i < 0:
                # Keep one trailing byte: the sync pair may straddle two reads.
                if len(self.buf) > 1:
                    del self.buf[:-1]
                return
            if i:
                del self.buf[:i]
            if len(self.buf) < self.framing.header_len:
                return
            self.sync_hits += 1
            n = self.framing.payload_len(self.buf)
            if not self.framing.plausible(n):
                # Not a real length; this was a false sync inside noise.
                self.bad_checksums += 1
                del self.buf[:2]
                continue
            total = self.framing.frame_len(n)
            if len(self.buf) < total:
                return
            decoded = self.framing.decode(bytes(self.buf[:total]))
            if decoded is None:
                self.bad_checksums += 1
                del self.buf[:2]
                continue
            cls, mid, payload = decoded
            self.frames.append(Frame(self.framing.name, cls, mid, payload))
            del self.buf[:total]

    def take(self):
        out, self.frames = self.frames, []
        return out


def nmea(body):
    """Wrap an NMEA sentence body with its '$', XOR checksum and CRLF.

    Computed rather than hardcoded so --selftest can check it against
    '$PCAS01,5*19', which gnss-set-baud already relies on being correct.
    """
    ck = 0
    for ch in body.encode("ascii"):
        ck ^= ch
    return ("$%s*%02X\r\n" % (body, ck)).encode("ascii")


class NmeaCollector:
    """Tallies NMEA sentences seen on the wire, by talker+type."""

    def __init__(self, keep=40):
        self.buf = bytearray()
        self.counts = {}
        self.lines = []
        self.keep = keep

    def feed(self, data):
        self.buf.extend(data)
        while True:
            i = self.buf.find(b"\n")
            if i < 0:
                if len(self.buf) > 1024:
                    del self.buf[:-1024]
                return
            line = bytes(self.buf[:i])
            del self.buf[:i + 1]
            # Resync to the last '$' rather than assuming the sentence starts
            # at the head of the buffer. Binary frames and NMEA share this
            # wire, and binary payloads contain no newline, so whatever binary
            # arrived before a sentence is still sitting in front of it. Taking
            # the line as-is silently drops every sentence that follows a
            # frame -- which reads as "the receiver does not send GGA" rather
            # than as a parser bug. rfind, not find: a sentence carries exactly
            # one '$', but preceding binary noise may contain 0x24 bytes.
            start = line.rfind(b"$")
            if start < 0:
                continue
            line = line[start:].strip()
            if b"*" not in line:
                continue
            try:
                text = line.decode("ascii", "replace")
            except Exception:
                continue
            tag = text[1:text.find(",")] if "," in text else text[1:]
            if not tag:
                continue
            self.counts[tag] = self.counts.get(tag, 0) + 1
            if len(self.lines) < self.keep:
                self.lines.append(text)

    def take_lines(self):
        out, self.lines = self.lines, []
        return out


# --------------------------------------------------------------------------
# Port
# --------------------------------------------------------------------------

class Port:
    """Raw 8N1 access to the serial device at a chosen speed."""

    def __init__(self, path, baud):
        self.path = path
        self.baud = baud
        self.fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        try:
            self.saved = termios.tcgetattr(self.fd)
            self._configure(baud)
        except Exception:
            os.close(self.fd)
            raise

    def _configure(self, baud):
        speed = BAUD_CONST[baud]
        iflag, oflag, cflag, lflag, _, _, cc = termios.tcgetattr(self.fd)
        iflag &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK |
                   termios.ISTRIP | termios.INLCR | termios.IGNCR |
                   termios.ICRNL | termios.IXON)
        oflag &= ~termios.OPOST
        lflag &= ~(termios.ECHO | termios.ECHONL | termios.ICANON |
                   termios.ISIG | termios.IEXTEN)
        cflag &= ~(termios.CSIZE | termios.PARENB | termios.CSTOPB)
        cflag |= termios.CS8 | termios.CLOCAL | termios.CREAD
        cc = list(cc)
        cc[termios.VMIN] = 0
        cc[termios.VTIME] = 0
        termios.tcsetattr(self.fd, termios.TCSANOW,
                          [iflag, oflag, cflag, lflag, speed, speed, cc])
        termios.tcflush(self.fd, termios.TCIOFLUSH)

    def flush_input(self):
        termios.tcflush(self.fd, termios.TCIFLUSH)

    def read(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return b""
        try:
            return os.read(self.fd, 4096)
        except OSError as e:
            if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                return b""
            raise

    def write(self, data):
        os.write(self.fd, data)
        termios.tcdrain(self.fd)

    def close(self):
        try:
            termios.tcsetattr(self.fd, termios.TCSANOW, self.saved)
        except Exception:
            pass
        os.close(self.fd)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False


