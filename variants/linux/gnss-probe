def device_from_gpsd_defaults():
    try:
        with open(GPSD_DEFAULTS) as fh:
            for line in fh:
                line = line.strip()
                if not line.startswith("DEVICES="):
                    continue
                val = line.split("=", 1)[1].strip().strip('"').strip("'")
                first = val.split()[0] if val.split() else ""
                if first.startswith("/dev/"):
                    return first
    except OSError:
        pass
    return None


def port_holder(path):
    """Who still has the device open, if anyone. Best effort."""
    try:
        r = subprocess.run(("fuser", path), capture_output=True, text=True,
                           timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    pids = r.stdout.split() + r.stderr.replace(path + ":", "").split()
    names = []
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            with open("/proc/%s/comm" % pid) as fh:
                names.append(fh.read().strip())
        except OSError:
            pass
    return names or None


def main(argv):
    ap = argparse.ArgumentParser(
        description="Identify the GNSS receiver's protocol and capabilities. "
                    "Read-only: sends polls, never configuration.")
    ap.add_argument("device", nargs="?", help="serial device (default: from "
                    "%s, else %s)" % (GPSD_DEFAULTS, DEFAULT_DEVICE))
    ap.add_argument("--json", metavar="PATH", help="also write results as JSON")
    ap.add_argument("--listen-seconds", type=float, default=10.0,
                    help="phase 1 duration (default 10)")
    ap.add_argument("--baud", type=int, choices=sorted(BAUD_CONST),
                    help="force a speed instead of trying %s" %
                         " then ".join(str(b) for b in BAUD_CANDIDATES))
    ap.add_argument("--framing", choices=[f.name for f in TRANSMIT_FRAMINGS],
                    help="sweep only this framing instead of trying each")
    ap.add_argument("--no-service-control", action="store_true",
                    help="do not stop/start gpsd; assume the port is already free")
    ap.add_argument("--selftest", action="store_true",
                    help="run built-in tests and exit; touches no hardware")
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    device = args.device or device_from_gpsd_defaults() or DEFAULT_DEVICE

    if not args.no_service_control and os.geteuid() != 0:
        print("gnss-probe: need root to stop gpsd and open %s" % device,
              file=sys.stderr)
        print("  run with sudo, or use --no-service-control if gpsd is "
              "already stopped", file=sys.stderr)
        return 1

    if not os.path.exists(device):
        print("gnss-probe: %s does not exist" % device, file=sys.stderr)
        return 1

    guard = ServiceGuard(enabled=not args.no_service_control)

    def on_signal(signum, frame):
        guard.restore()
        sys.exit(130)

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    with guard:
        bauds = [args.baud] if args.baud else list(BAUD_CANDIDATES)
        obs = None
        port = None
        try:
            for baud in bauds:
                try:
                    port = Port(device, baud)
                except OSError as e:
                    holders = port_holder(device)
                    print("gnss-probe: cannot open %s: %s" % (device, e),
                          file=sys.stderr)
                    if holders:
                        print("  still held by: %s" % ", ".join(holders),
                              file=sys.stderr)
                        if any("meshcore" in h for h in holders):
                            print("  meshcored holds this UART directly, which "
                                  "means gps_device is a serial\n  path rather "
                                  "than gpsd://. Stop meshcored yourself if you "
                                  "want to probe;\n  this tool will not take "
                                  "the mesh daemon down for you.",
                                  file=sys.stderr)
                    return 1

                print("Listening at %d baud for %.0fs (sending nothing)..."
                      % (baud, args.listen_seconds))
                obs = listen(port, args.listen_seconds)
                if obs.recognised:
                    break
                print("  nothing recognisable at %d baud" % baud)
                port.close()
                port = None

            if port is None or obs is None:
                print("gnss-probe: no recognisable data at %s" %
                      " or ".join(str(b) for b in bauds), file=sys.stderr)
                return 2

            if args.framing:
                order = [f for f in TRANSMIT_FRAMINGS if f.name == args.framing]
            else:
                first = obs.best_framing()
                if first is None:
                    print("No binary frames seen passively; probing each "
                          "framing...")
                    first, _ = detect_framing(port)
                # What the chip EMITS and what it ACCEPTS are different
                # questions. A receiver can emit a u-blox emulation while its
                # native protocol still listens, which is the entire hypothesis
                # here -- so the framing seen in phase 1 is only the first
                # thing to try, never the last.
                order = ([first] if first else []) + [
                    f for f in TRANSMIT_FRAMINGS if f is not first]

            sweeps = []
            for framing in order:
                print("Sweeping %s framing..." % framing.name)
                results = sweep(port, framing)
                sweeps.append((framing, results))
                if productive(results):
                    break
                if framing is not order[-1]:
                    print("  every binary poll refused; trying the next "
                          "framing")

            print("")
            print(render(obs, sweeps, device))

            if args.json:
                with open(args.json, "w") as fh:
                    json.dump(to_json(obs, sweeps, device), fh, indent=2)
                print("JSON written to %s" % args.json)

            return 0 if sweeps else 2
        finally:
            if port is not None:
                port.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
