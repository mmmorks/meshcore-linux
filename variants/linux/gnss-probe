def selftest():
    fails = []

    def check(name, cond):
        if cond:
            print("  ok   %s" % name)
        else:
            print("  FAIL %s" % name)
            fails.append(name)

    print("gnss-probe --selftest")
    print("")
    print("checksums:")
    # $PCAS01,5*19 is what gnss-set-baud sends and is known-good on hardware.
    check("NMEA checksum matches gnss-set-baud's $PCAS01,5*19",
          nmea("PCAS01,5") == b"$PCAS01,5*19\r\n")

    # Hand-computed Fletcher over class,id,len_lo,len_hi for an empty payload.
    # MON-VER poll = 0a 04 00 00 -> ck_a = 0x0e, ck_b = 0x0e+0x12 ... verify by
    # independent accumulation rather than by restating encode()'s own logic.
    body = bytes([0x0A, 0x04, 0x00, 0x00])
    a = b = 0
    for byte in body:
        a = (a + byte) & 0xFF
        b = (b + a) & 0xFF
    check("Allystar MON-VER poll encodes correctly",
          ALLY.encode(0x0A, 0x04) == b"\xf1\xd9" + body + bytes([a, b]))
    check("u-blox and Allystar differ only in sync bytes",
          ALLY.encode(0x06, 0x0C)[2:] == UBX.encode(0x06, 0x0C)[2:])
    # Real frames from the Quectel L76K GNSS Protocol Specification V1.1 p32,
    # section 3.2.2.1. Vendor-published bytes, so these check the encoder
    # against the spec rather than against my reading of it.
    spec_poll = bytes.fromhex("bace0000060000000600")
    spec_resp = bytes.fromhex("bace0800060000ffc008802500008824c708")
    check("CASIC CFG-PRT poll matches the spec's own bytes",
          CASIC.encode(0x06, 0x00) == spec_poll)
    check("CASIC CFG-PRT response decodes with the spec's checksum",
          CASIC.decode(spec_resp) == (0x06, 0x00,
                                      bytes.fromhex("00ffc00880250000")))
    check("CASIC rejects a corrupted checksum",
          CASIC.decode(spec_resp[:-1] + b"\xff") is None)
    check("CASIC refuses a payload that is not a multiple of 4",
          _raises(lambda: CASIC.encode(0x06, 0x00, b"\x01")))
    check("CASIC length field is read from offset 2, not 4",
          CASIC.payload_len(spec_resp) == 8 and UBX.payload_len(
              UBX.encode(0x06, 0x00, b"\x01\x02")) == 2)

    print("")
    print("scanner:")
    frame = ALLY.encode(0x06, 0x0C, bytes([0x10, 0x00, 0x00, 0x00]))

    sc = Scanner(ALLY)
    sc.feed(frame)
    check("one clean frame", len(sc.take()) == 1)

    sc = Scanner(ALLY)
    sc.feed(frame[:5])
    partial = len(sc.take())
    sc.feed(frame[5:])
    check("frame split across two reads", partial == 0 and len(sc.take()) == 1)

    sc = Scanner(ALLY)
    sc.feed(b"\x00\xff\x12garbage" + frame)
    check("garbage before frame", len(sc.take()) == 1)

    # The important one: a payload that contains the sync pair.
    tricky = ALLY.encode(0x06, 0x0C, b"\xf1\xd9\xf1\xd9")
    sc = Scanner(ALLY)
    sc.feed(tricky)
    got = sc.take()
    check("sync bytes inside payload do not truncate the frame",
          len(got) == 1 and got[0].payload == b"\xf1\xd9\xf1\xd9")

    sc = Scanner(ALLY)
    bad = bytearray(frame)
    bad[-1] ^= 0xFF
    sc.feed(bytes(bad) + frame)
    check("bad checksum rejected, next frame still found", len(sc.take()) == 1)

    sc = Scanner(ALLY)
    sc.feed(b"\xf1")
    sc.feed(b"\xd9" + frame[2:])
    check("sync pair straddling two reads", len(sc.take()) == 1)

    print("")
    print("nmea collector:")
    nc = NmeaCollector(keep=2)
    nc.feed(b"$GPGGA,1*0A\r\n$GPRMC,2*15\r\n$GPGSV,3*1B\r\n")
    check("sentence counts are not capped by the line buffer",
          sum(nc.counts.values()) == 3)
    check("line buffer honours its cap", len(nc.lines) == 2)
    nc.take_lines()
    nc.feed(b"$PCAS,x*3C\r\n")
    check("take_lines frees room so a later poll still sees its reply",
          len(nc.lines) == 1)

    # Regression: a sentence arriving behind leftover binary bytes. This is the
    # normal case on a wire carrying both, not an edge case -- every sentence
    # that follows a binary frame hits it.
    nc = NmeaCollector()
    nc.feed(ALLY.encode(0x0A, 0x04, b"\x00\x01\x02\x24\x03"))
    nc.feed(b"$GNGGA,123519,4807.038,N*4F\r\n")
    check("sentence behind leftover binary bytes is still parsed",
          nc.counts.get("GNGGA") == 1)
    nc = NmeaCollector()
    nc.feed(b"\x00\xff$GPTXT,01*29\r\n$GNRMC,1*38\r\n")
    check("two sentences after binary noise both parse",
          nc.counts.get("GPTXT") == 1 and nc.counts.get("GNRMC") == 1)

    print("")
    print("decoders:")
    d = decode_cfg_navsat(bytes([0x10, 0x00, 0x00, 0x00]))
    check("CFG-NAVSAT Galileo bit decodes",
          d["galileo_e1"] is True and "GAL E1" in d["enabled"])
    d = decode_cfg_navsat(bytes([0x07, 0x00, 0x00, 0x00]))
    check("CFG-NAVSAT without Galileo",
          d["galileo_e1"] is False and "GPS L1" in d["enabled"])
    d = decode_mon_ver(b"3.018.a3f23db\x00\x00\x00" + b"TAU1202\x00" * 2)
    check("MON-VER splits software and hardware",
          d["software"] == "3.018.a3f23db" and d["hardware"] == "TAU1202")
    d = decode_cfg_pps(bytes(15))
    check("CFG-PPS 15-byte variant recognised", d["variant"].startswith("later"))
    d = decode_cfg_pps(bytes(5))
    check("CFG-PPS 5-byte variant recognised", d["variant"].startswith("early"))
    d = decode_cfg_prt(bytes([0, 0, 0, 0]) + (115200).to_bytes(4, "little"))
    check("CFG-PRT baud decodes", d["baudrate"] == 115200 and d["port"] == "UART0")

    print("")
    print("read-only invariant:")
    check("Prober exposes no arbitrary-send method",
          not any(n for n in dir(Prober)
                  if n in ("send", "send_raw", "write", "transmit")))
    check("Prober.poll takes only an index",
          Prober.poll.__code__.co_varnames[:2] == ("self", "n"))
    check("prober scans every framing, not only the one it asks in",
          set(Prober(None, ALLY).scanners) == {f.name for f in ALL_FRAMINGS})
    check("every POLLS entry is well-formed",
          all(p.kind in ("bin", "nmea") and p.label for p in POLLS))
    check("no binary poll carries a non-empty payload",
          all(p.payload == b"" for p in POLLS if p.kind == "bin"))
    check("the only NMEA poll is a query, not a $PCAS setter",
          all(p.payload.startswith("PCAS06") for p in POLLS if p.kind == "nmea"))

    print("")
    if fails:
        print("%d FAILED: %s" % (len(fails), ", ".join(fails)))
        return 1
    print("all checks passed")
    return 0


def _raises(fn):
    try:
        fn()
    except Exception:
        return True
    return False


