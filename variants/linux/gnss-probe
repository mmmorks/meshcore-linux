# CFG-NAVSAT enableMask, from driver_allystar.c:158. Single-bit tests only --
# a few entries in the driver's own table have mask/value pairs that can never
# match (e.g. {0x200, 0x800, "GPS L5"}), which look like typos there.
NAVSAT_BITS = [
    (0x00000001, "GPS L1"), (0x00000002, "GLO G1"), (0x00000004, "BDS B1"),
    (0x00000008, "QZSS L1S"), (0x00000010, "GAL E1"), (0x00000020, "QZSS L1"),
    (0x00000040, "SBAS L1"), (0x00000080, "NAVIC L5"), (0x00000100, "GPS L1C"),
    (0x00000200, "GPS L5"), (0x00000400, "GPS L2C"), (0x00002000, "GLO G2"),
    (0x00004000, "BDS B1C"), (0x00008000, "BDS B2A"), (0x00010000, "BDS B3I"),
    (0x00020000, "BDS B5"), (0x00040000, "BDS B2"), (0x00100000, "GAL E5A"),
    (0x00200000, "GAL E5B"), (0x00400000, "GAL E6"), (0x01000000, "QZSS L6"),
    (0x02000000, "QZSS L1C"), (0x04000000, "QZSS L5"), (0x08000000, "QZSS L2C"),
]

ANTIJAM_BITS = [
    (0x02, "GPS"), (0x04, "QZSS"), (0x08, "SBAS"),
    (0x10, "GAL"), (0x20, "BDS"), (0x40, "GLO"),
]

NMEA_VERSIONS = {0: "None", 1: "V3.01", 2: "V4.00", 3: "V4.10"}


def _bits(value, table):
    return [name for bit, name in table if value & bit]


def decode_mon_ver(p):
    if len(p) < 32:
        return {"note": "short payload"}
    return {
        "software": p[0:16].split(b"\x00")[0].decode("ascii", "replace"),
        "hardware": p[16:32].split(b"\x00")[0].decode("ascii", "replace"),
    }


def decode_cfg_navsat(p):
    if len(p) < 4:
        return {"note": "short payload"}
    mask = int.from_bytes(p[0:4], "little")
    names = _bits(mask, NAVSAT_BITS)
    return {
        "enableMask": "0x%08x" % mask,
        "enabled": names,
        "galileo_e1": bool(mask & 0x10),
    }


def decode_cfg_pps(p):
    # Payload 5 on early (Cynosure I) chips, 15 on later ones
    # (driver_allystar.c:630).
    if len(p) == 5:
        return {
            "variant": "early (5-byte)",
            "length_us": int.from_bytes(p[0:4], "little"),
            "polarity": p[4],
        }
    if len(p) == 15:
        return {
            "variant": "later (15-byte)",
            "period_us": int.from_bytes(p[0:4], "little"),
            "offset_ns": int.from_bytes(p[4:8], "little", signed=True),
            "duty_cycle": int.from_bytes(p[8:12], "little"),
            "polarity": p[12],
            "gpio": p[13],
            "sync": p[14],
        }
    return {"note": "undocumented payload length %d" % len(p)}


def decode_cfg_prt(p):
    # Layout per L76K spec table 8: PortID U1 @0, ProtoMask U1 @1, Mode U2 @2,
    # BaudRate U4 @4. Allystar's CFG-PRT happens to agree on PortID and
    # BaudRate (driver_allystar.c:668), so this decode serves both.
    if len(p) < 8:
        return {"note": "short payload"}
    mode = int.from_bytes(p[2:4], "little")
    bits = {0: "5", 1: "6", 2: "7", 3: "8"}[(mode >> 6) & 3]
    parity = "N" if ((mode >> 9) & 4) else ("O" if ((mode >> 9) & 7) == 1
                                            else "E")
    stop = {0: "1", 1: "1.5", 2: "2"}.get((mode >> 12) & 3, "?")
    return {
        "portID": p[0],
        "port": {0: "UART0", 1: "UART1"}.get(p[0], "?"),
        "protoMask": "0x%02x" % p[1],
        "mode": "%s%s%s" % (bits, parity, stop),
        "baudrate": int.from_bytes(p[4:8], "little"),
    }


def decode_cfg_sbas(p):
    if not p:
        return {"note": "no SBAS enabled"}
    return {"prns": [{"prn": p[i], "enabled": bool(p[i + 1])}
                     for i in range(0, len(p) - 1, 2)]}


def decode_cfg_nmeaver(p):
    if not p:
        return {"note": "short payload"}
    return {"version": p[0], "name": NMEA_VERSIONS.get(p[0], "?")}


def decode_cfg_antijam(p):
    if len(p) < 3:
        return {"note": "short payload"}
    mask = int.from_bytes(p[0:2], "little")
    return {
        "satsys_mask": "0x%04x" % mask,
        "constellations": _bits(mask, ANTIJAM_BITS),
        "threshold": p[2],
    }


def decode_cfg_rate(p):
    # CASIC CFG-RATE: Interval U2 (ms), Res U2. L76K spec table 13.
    if len(p) < 2:
        return {"note": "short payload"}
    ms = int.from_bytes(p[0:2], "little")
    return {"interval_ms": ms,
            "hz": round(1000.0 / ms, 2) if ms else "?"}


def decode_single_byte(p):
    # CFG-ELEV / CFG-NUMSV / CFG-DOP have no payload documentation in the
    # driver -- it lists them but decodes none of them. First byte is reported
    # as a guess; the hex is the authoritative part.
    if not p:
        return {"note": "empty payload"}
    return {"first_byte": p[0], "note": "layout undocumented; value is a guess"}


