)

ACK_ACK = (0x05, 0x01)
ACK_NAK = (0x05, 0x00)


# --------------------------------------------------------------------------
# Phases
# --------------------------------------------------------------------------

class Observation:
    def __init__(self, baud):
        self.baud = baud
        self.sync_hits = {}
        self.valid_frames = {}
        self.frame_ids = {}
        self.nmea_counts = {}
        self.nmea_sample = []
        self.raw_bytes = 0
        self.raw_head = b""

    @property
    def recognised(self):
        return bool(self.nmea_counts) or any(self.valid_frames.values())

    def best_framing(self):
        """The transmittable framing that produced real frames, if any."""
        best, count = None, 0
        for f in TRANSMIT_FRAMINGS:
            n = self.valid_frames.get(f.name, 0)
            if n > count:
                best, count = f, n
        return best


def listen(port, seconds):
    """Phase 1. Sends nothing."""
    obs = Observation(port.baud)
    scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS}
    nm = NmeaCollector()
    raw = bytearray()

    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        data = port.read(min(0.5, max(0.05, deadline - time.monotonic())))
        if not data:
            continue
        raw.extend(data)
        obs.raw_bytes += len(data)
        nm.feed(data)
        for sc in scanners.values():
            sc.feed(data)

    for name, sc in scanners.items():
        obs.sync_hits[name] = sc.sync_hits
        frames = sc.take()
        obs.valid_frames[name] = len(frames)
        ids = {}
        for fr in frames:
            k = "%02x-%02x" % (fr.cls, fr.mid)
            ids[k] = ids.get(k, 0) + 1
        obs.frame_ids[name] = ids

    obs.nmea_counts = dict(nm.counts)
    obs.nmea_sample = nm.lines[:10]
    obs.raw_head = bytes(raw[:512])
    return obs


class ProbeResult:
    def __init__(self, poll, outcome, detail=None, raw=None,
                 answered_in=None, window=b"", window_total=0, seen=None):
        self.poll = poll
        self.outcome = outcome        # ack | nak | reply | silence | skipped
        self.detail = detail
        self.raw = raw
        # Which framing the answer actually arrived in. Usually the one we
        # asked in; if it differs, that is a major finding, not a footnote.
        self.answered_in = answered_in
        # Bytes seen during the probe window. Without this a "silence" verdict
        # is unfalsifiable: on a wire that is never quiet, "no matching frame"
        # and "nothing arrived" are completely different claims and only one
        # of them supports concluding the protocol is unsupported.
        self.window = window
        self.window_total = window_total
        # Tally of EVERY frame the scanners decoded in this window, across all
        # framings, matching or not. The raw window is capped at RAW_WINDOW
        # bytes and so is only a sample; this covers the whole window. It is
        # what makes "no answer" checkable -- specifically, whether any ACK or
        # NAK appeared at all, rather than only one naming the polled message.
        self.seen = seen or {}


class Prober:
    """Phase 2. The only transmit path in this file.

    poll() takes an index into POLLS. There is deliberately no method that
    accepts an arbitrary class, id or payload.
    """

    def __init__(self, port, framing):
        self.port = port
        self.framing = framing
        # Scan for EVERY framing, not just the one being swept. A chip with one
        # command parser and one output formatter may well answer a foreign
        # request in its own dialect, and a single-framing scanner would score
        # that as silence -- turning "it answered, just not how we expected"
        # into "it does not support this", which is the opposite conclusion.
        self.scanners = {f.name: Scanner(f) for f in ALL_FRAMINGS}
        self.nmea = NmeaCollector()
        self._window = b""
        self._window_total = 0

    def poll(self, n):
        p = POLLS[n]
        if p.kind == "nmea":
            return self._poll_nmea(p)
        return self._poll_binary(p)

    def _collect(self, timeout, decisive=None):
        """Read until `timeout`, or until `decisive(frame)` is true.

        Returning early on a decisive frame is what keeps the sweep bearable:
        waiting the full timeout on every probe turns 13 polls into ~23 s of
        mostly idling, and the whole time gpsd is stopped and the node is off
        stratum 1. Probes that draw nothing still cost the full timeout, which
        is unavoidable -- silence takes as long as it takes to be sure of.

        Also records the raw bytes of the window so a "silence" result carries
        its own evidence.
        """
        end = time.monotonic() + timeout
        seen = []
        raw = bytearray()
        total = 0
        try:
            while time.monotonic() < end:
                data = self.port.read(
                    min(0.2, max(0.02, end - time.monotonic())))
                if not data:
                    continue
                total += len(data)
                if len(raw) < RAW_WINDOW:
                    raw.extend(data[:RAW_WINDOW - len(raw)])
                self.nmea.feed(data)
                for sc in self.scanners.values():
                    sc.feed(data)
                for name in self.scanners:
                    for fr in self.scanners[name].take():
                        seen.append(fr)
                        if decisive is not None and decisive(fr):
                            return seen
        finally:
            self._window = bytes(raw)
            self._window_total = total
        return seen

    def _poll_binary(self, p):
        self.port.flush_input()
        for sc in self.scanners.values():
            sc.take()

        def classify(fr):
            if fr.key == (p.cls, p.mid):
                return "reply"
            if (fr.key in (ACK_ACK, ACK_NAK) and len(fr.payload) >= 2
                    and (fr.payload[0], fr.payload[1]) == (p.cls, p.mid)):
                return "ack" if fr.key == ACK_ACK else "nak"
            return None

        self.port.write(self.framing.encode(p.cls, p.mid, p.payload))
        frames = self._collect(PROBE_TIMEOUT, lambda fr: classify(fr) is not None)

        tally = {}
        for fr in frames:
            k = "%s %02x-%02x" % (fr.framing, fr.cls, fr.mid)
            tally[k] = tally.get(k, 0) + 1

        for fr in frames:
            kind = classify(fr)
            if kind is None:
                continue
            detail = (p.decoder(fr.payload)
                      if kind == "reply" and p.decoder else None)
            return ProbeResult(p, kind, detail, fr.payload,
                               answered_in=fr.framing,
                               window=self._window,
                               window_total=self._window_total, seen=tally)
        return ProbeResult(p, "silence", None, None,
                           window=self._window,
                           window_total=self._window_total, seen=tally)

    def _poll_nmea(self, p):
        # Drain first rather than slicing from a mark: NmeaCollector caps how
        # many lines it retains, and by this point the binary polls' own read
        # windows have already filled it. Slicing would silently see nothing.
        self.port.flush_input()
        self.nmea.take_lines()
        self.port.write(nmea(p.payload))
        self._collect(PROBE_TIMEOUT)
        new = self.nmea.take_lines()
        # A version reply is any sentence that is not routine positioning data.
        interesting = [ln for ln in new
                       if not ln[3:6] in ("GGA", "GLL", "GSA", "GSV",
                                          "RMC", "VTG", "ZDA", "GRS", "GST")]
        if interesting:
            return ProbeResult(p, "reply", {"sentences": interesting[:4]},
                               answered_in="nmea", window=self._window,
                               window_total=self._window_total)
        return ProbeResult(p, "silence", window=self._window,
                           window_total=self._window_total)


def detect_framing(port):
    """Send a version poll in each transmittable framing; report which answers."""
    for framing in TRANSMIT_FRAMINGS:
        pr = Prober(port, framing)
        res = pr.poll(0)                      # POLLS[0] is MON-VER
        if res.outcome in ("reply", "ack", "nak"):
            return framing, res
    return None, None


def sweep(port, framing):
    prober = Prober(port, framing)
    results = []
    for i in range(len(POLLS)):
        results.append(prober.poll(i))
        time.sleep(PROBE_SPACING)
    return results


def productive(results):
    """Did this framing actually yield data, as opposed to refusals?

    A sweep where every binary poll NAKs is a working conversation in which the
    chip declined every question -- which is exactly what the u-blox emulation
    does. It means "ask somewhere else", not "this is the answer", so it is the
    trigger for trying the other framing rather than a result to stop on.
    """
    return any(r.outcome in ("reply", "ack")
               for r in results if r.poll.kind == "bin")


# --------------------------------------------------------------------------
# Service lifecycle
# --------------------------------------------------------------------------

def systemctl(*args):
    try:
        return subprocess.run(("systemctl",) + args,
                              capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        return None
    except subprocess.TimeoutExpired:
        return None


def unit_active(unit):
    r = systemctl("is-active", "--quiet", unit)
    return bool(r) and r.returncode == 0


class ServiceGuard:
    """Stops gpsd for the probe and restores whatever state it found.

    Restores the PRIOR state, not "running": if gpsd was already stopped, it
    stays stopped. Both gpsd.socket and gpsd.service are stopped -- see the
    module docstring for why the socket matters.
    """

    UNITS = ("gpsd.socket", "gpsd.service")

    def __init__(self, enabled=True):
        self.enabled = enabled
        self.was_active = {}
        self._armed = False

    def __enter__(self):
        if not self.enabled:
            return self
        for unit in self.UNITS:
            self.was_active[unit] = unit_active(unit)
        stopping = [u for u in self.UNITS if self.was_active.get(u)]
        if stopping:
            print("Stopping %s for the probe." % ", ".join(stopping))
            print("The GNSS clock source drops until this finishes; chrony "
                  "falls back to the pool\nand takes a couple of minutes to "
                  "return to stratum 1 afterwards.\n")
            for unit in self.UNITS:
                if self.was_active.get(unit):
                    systemctl("stop", unit)
            time.sleep(1.0)
        self._armed = True
        return self

    def restore(self):
        if not self._armed:
            return
        self._armed = False
        started = []
        for unit in reversed(self.UNITS):
            if self.was_active.get(unit):
                systemctl("start", unit)
                started.append(unit)
        if started:
            print("\nRestarted %s." % ", ".join(started))

    def __exit__(self, *exc):
        self.restore()
        return False


